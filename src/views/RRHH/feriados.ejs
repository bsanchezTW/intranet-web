<link rel="stylesheet" href="/css/vacaciones.css?v=20260916g">

<%
  function fmt(d) {
    if (!d) return '-';
    const s = (typeof d === 'string') ? d.slice(0,10) : new Date(d).toISOString().slice(0,10);
    const [y,m,dd] = s.split('-');
    return `${dd}-${m}-${y}`;
  }
%>

<div class="vac-wrap">
  <div class="page-header">
    <span class="page-header__icono" aria-hidden="true"><%- include('../partials/icon', { name: 'calendar' }) %></span>
    <div class="page-header__text">
      <nav class="page-header__migas" aria-label="Ruta de navegación">
        <a href="/RRHH">RRHH</a> <span aria-hidden="true">/</span>
        <span>Feriados</span>
      </nav>
      <h2 class="page-title">Feriados</h2>
      <p class="page-description">
        <% if (country === 'CL') { %>
          Feriados legales de <%= countryConfig.name %>. Afectan el cálculo de días hábiles.
        <% } else { %>
          Feriados legales de <%= countryConfig.name %>. Se usan para el horario hábil de Soporte<% if (features.vacations) { %> y el cómputo de vacaciones, que es en días calendario<% } %>.
        <% } %>
      </p>
    </div>
  </div>

  <% if (typeof success !== 'undefined' && success) { %>
    <div hidden data-toast="<%= success %>"></div>
  <% } %>
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="flash-msg flash-msg--error" role="alert"><%= error %></div>
  <% } %>

  <!-- Agregar feriado -->
  <div class="vac-panel">
    <div class="vac-panel-head">Agregar feriado</div>
    <form class="vac-form" action="/RRHH/feriados" method="POST">
      <%# El país no se elige: esta instancia solo administra sus propios
          feriados. El servidor rechaza cualquier otro. %>
      <input type="hidden" name="country_code" value="<%= country %>">
      <div class="campo">
        <label for="holiday_date">Fecha *</label>
        <input type="date" id="holiday_date" name="holiday_date" required>
      </div>
      <div class="campo">
        <label for="name">Nombre *</label>
        <input type="text" id="name" name="name" required placeholder="Ej: Día del Trabajo">
      </div>
      <button type="submit" class="vac-btn vac-btn-primary">Agregar feriado</button>
    </form>
  </div>

  <!-- Listado del país de la instancia -->
  <div class="vac-panel">
    <div class="vac-panel-head"><%= countryConfig.name %> (<%= holidays.length %>)</div>
    <% if (!holidays.length) { %>
      <p class="vac-empty">Sin feriados.</p>
    <% } else { %>
      <table class="vac-table">
        <thead><tr><th>Fecha</th><th>Nombre</th><th></th></tr></thead>
        <tbody>
          <% holidays.forEach(h => { %>
            <tr>
              <td><%= fmt(h.holiday_date) %></td>
              <td><%= h.name %></td>
              <td>
                <form class="vac-inline-form" action="/RRHH/feriados/<%= h.id %>/eliminar" method="POST"
                      data-confirm="«<%= h.name %>» dejará de contarse como feriado."
                      data-confirm-title="¿Eliminar el feriado?"
                      data-confirm-accept="Eliminar"
                      data-confirm-tone="peligro">
                  <button type="submit" class="vac-btn vac-btn-cancel vac-btn-sm">Eliminar</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
</div>
