<%
/* Menú del módulo. Cada acceso declara su destino en un solo lugar: así añadir
   un portal es tocar el arreglo, no duplicar 12 líneas de marcado. */
const INTERNOS = [
  { href: '/RRHH/organigrama', icono: 'building', titulo: 'Organigrama', desc: 'Estructura general y departamentos.' },
  { href: '/RRHH/personal', icono: 'users', titulo: 'Personal', desc: 'Directorio de gestión y registro de colaboradores.' },
  { href: '/RRHH/areas', icono: 'layers', titulo: 'Áreas', desc: 'Gestionar áreas de trabajo y colaboradores asignados.' },
  { href: '/RRHH/centros-costo', icono: 'briefcase', titulo: 'Centros de costo', desc: 'Definir centros y a cuáles rinde gastos cada colaborador.' },
  { href: '/RRHH/vacaciones', icono: 'umbrella', titulo: 'Vacaciones', desc: 'Solicita y gestiona vacaciones.' },
];

const EXTERNOS = features.chileHrPortals
  ? [
      { href: 'https://transworld.rexmas.com/', img: '/img/logo_rex.png', titulo: 'Rex+', desc: 'Portal del colaborador y liquidaciones.' },
      { href: 'https://www.achs.cl/', img: '/img/achs.png', titulo: 'ACHS', desc: 'Seguridad y salud ocupacional.' },
      { href: 'https://www.cajalosandes.cl/', img: '/img/cajalosandes.png', titulo: 'Caja Los Andes', desc: 'Beneficios, convenios y ahorros.' },
    ]
  : [];
%>

<link rel="stylesheet" href="/css/rrhh.css?v=20260729a">

<div class="contenedor">
  <div class="page-header">
    <h2 class="page-title">Recursos Humanos</h2>
    <p class="page-description">
      Accede a las herramientas internas<% if (EXTERNOS.length) { %> y portales externos<% } %> de gestión.
    </p>
  </div>

  <h3 class="rrhh-section-title">Plataformas Internas</h3>
  <div class="grid-opciones-exec">
    <% INTERNOS.forEach(item => { %>
      <a href="<%= item.href %>" class="card-opcion-exec">
        <span class="link-type-badge badge-interno">Interno</span>
        <div class="card-icon-wrapper"><%- include('../partials/icon', { name: item.icono }) %></div>
        <div class="card-content">
          <h3 class="card-title"><%= item.titulo %></h3>
          <p class="card-desc"><%= item.desc %></p>
        </div>
      </a>
    <% }) %>
  </div>

  <% if (EXTERNOS.length) { %>
  <h3 class="rrhh-section-title">Portales Externos</h3>
  <div class="grid-opciones-exec">
    <% EXTERNOS.forEach(item => { %>
      <a href="<%= item.href %>" target="_blank" rel="noopener noreferrer" class="card-opcion-exec">
        <span class="link-type-badge badge-externo">Externo <span class="external-icon" aria-hidden="true">↗</span></span>
        <div class="card-icon-wrapper"><img src="<%= item.img %>" alt=""></div>
        <div class="card-content">
          <h3 class="card-title"><%= item.titulo %> <span class="sr-only">(se abre en una pestaña nueva)</span></h3>
          <p class="card-desc"><%= item.desc %></p>
        </div>
      </a>
    <% }) %>
  </div>
  <% } %>
</div>
