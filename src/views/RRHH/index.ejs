<%
const admin = typeof canManageRrhh !== 'undefined' && canManageRrhh;
const hayVacaciones = Boolean(features && features.vacations);
const hayCentros = Boolean(features && features.expenseCenter);
const hayPortales = Boolean(features && features.chileHrPortals);
const pais = (typeof countryConfig !== 'undefined' && countryConfig && countryConfig.name)
  ? countryConfig.name
  : 'la empresa';

const INTERNOS = [
  {
    href: '/RRHH/organigrama',
    icono: 'sitemap',
    titulo: 'Organigrama',
    desc: admin
      ? 'Áreas, jefaturas y de quién depende cada una. Aquí se crean y editan.'
      : 'Áreas, jefaturas y de quién depende cada una.',
  },
  { href: '/RRHH/personal', icono: 'users', titulo: 'Personal', desc: 'Directorio de gestión y registro de colaboradores.' },
];
if (hayVacaciones) {
  INTERNOS.push({ href: '/RRHH/vacaciones', icono: 'umbrella', titulo: 'Vacaciones', desc: 'Consulta tu saldo, solicita días y revisa el calendario.' });
}

// Las áreas no tienen pantalla propia: se crean y editan en el Organigrama.
const ADMINISTRACION = [];
if (hayCentros) {
  ADMINISTRACION.push({
    href: '/RRHH/centros-costo',
    icono: 'briefcase',
    titulo: 'Centros de costo',
    desc: 'Definir centros y a cuáles rinde gastos cada colaborador.',
  });
}
if (hayVacaciones) {
  ADMINISTRACION.push({
    href: '/RRHH/vacaciones/gestion',
    icono: 'check-circle',
    titulo: 'Gestión de vacaciones',
    desc: 'Aprueba o rechaza solicitudes y ajusta los saldos del equipo.',
  });
  ADMINISTRACION.push({
    href: '/RRHH/vacaciones/gestion/resumen',
    icono: 'chart',
    titulo: 'Resumen de vacaciones',
    desc: 'Días vencidos de cada colaborador, historial, liquidación y exportación.',
  });
}
// Soporte usa los feriados para el horario hábil: existen aunque no haya Vacaciones.
ADMINISTRACION.push({
  href: '/RRHH/feriados',
  icono: 'flag',
  titulo: 'Feriados',
  desc: 'Administra los feriados de ' + pais + '.',
});

const EXTERNOS = hayPortales
  ? [
      { href: 'https://transworld.mirexmas.com/', img: '/img/logo_rex.png', titulo: 'Rex+', desc: 'Portal del colaborador y liquidaciones.' },
      { href: 'https://www.achs.cl/', img: '/img/achs.png', titulo: 'ACHS', desc: 'Seguridad y salud ocupacional.' },
      { href: 'https://www.cajalosandes.cl/', img: '/img/cajalosandes.png', titulo: 'Caja Los Andes', desc: 'Beneficios, convenios y ahorros.' },
    ]
  : [];
%>

<link rel="stylesheet" href="/css/procesos.css?v=20260916m">

<div class="contenedor">
  <div class="page-header">
    <span class="page-header__icono" aria-hidden="true"><%- include('../partials/icon', { name: 'users' }) %></span>
    <div class="page-header__text">
      <h2 class="page-title">Recursos humanos</h2>
      <p class="page-description">
        Accede a las herramientas internas<% if (EXTERNOS.length) { %> y portales externos<% } %> de gestión.
      </p>
    </div>
  </div>

  <!-- ═══════════ Plataformas internas ═══════════ -->
  <section class="seccion" aria-labelledby="seccion-internas">
    <div class="seccion__head">
      <div class="seccion__heading">
        <h3 class="seccion__title" id="seccion-internas">
          <span class="seccion__icon" aria-hidden="true"><%- include('../partials/icon', { name: 'users' }) %></span>
          Plataformas internas
        </h3>
        <p class="seccion__desc">Organigrama<% if (hayVacaciones) { %>, directorio de colaboradores y vacaciones<% } else { %> y directorio de colaboradores<% } %>.</p>
      </div>
    </div>

    <div class="procesos-grid">
      <% INTERNOS.forEach((item, i) => { %>
        <a href="<%= item.href %>" class="procesos-card">
          <span class="procesos-card__tile<%= i % 2 ? ' procesos-card__tile--green' : '' %>" aria-hidden="true"><%- include('../partials/icon', { name: item.icono }) %></span>
          <div class="procesos-card__cuerpo">
            <h4 class="procesos-card__titulo"><%= item.titulo %></h4>
            <p class="procesos-card__desc"><%= item.desc %></p>
          </div>
        </a>
      <% }) %>
    </div>
  </section>

  <% if (admin) { %>
  <!-- ═══════════ Administración ═══════════ -->
  <section class="seccion" aria-labelledby="seccion-admin">
    <div class="seccion__head">
      <div class="seccion__heading">
        <h3 class="seccion__title" id="seccion-admin">
          <span class="seccion__icon" aria-hidden="true"><%- include('../partials/icon', { name: 'settings' }) %></span>
          Administración
        </h3>
        <p class="seccion__desc">
          <% if (hayCentros) { %>Centros de costo, feriados<% } else { %>Feriados<% } %><% if (hayVacaciones) { %> y la gestión de vacaciones<% } %>.
        </p>
      </div>
    </div>

    <div class="procesos-grid">
      <% ADMINISTRACION.forEach((item, i) => { %>
        <a href="<%= item.href %>" class="procesos-card">
          <span class="procesos-card__tile<%= i % 2 ? ' procesos-card__tile--green' : '' %>" aria-hidden="true"><%- include('../partials/icon', { name: item.icono }) %></span>
          <div class="procesos-card__cuerpo">
            <h4 class="procesos-card__titulo"><%= item.titulo %></h4>
            <p class="procesos-card__desc"><%= item.desc %></p>
          </div>
        </a>
      <% }) %>
    </div>
  </section>
  <% } %>

  <% if (EXTERNOS.length) { %>
  <!-- ═══════════ Portales externos ═══════════ -->
  <section class="seccion" aria-labelledby="seccion-externos">
    <div class="seccion__head">
      <div class="seccion__heading">
        <h3 class="seccion__title" id="seccion-externos">
          <span class="seccion__icon" aria-hidden="true"><%- include('../partials/icon', { name: 'external-link' }) %></span>
          Portales externos
        </h3>
        <p class="seccion__desc">Sitios de beneficios, liquidaciones y salud ocupacional.</p>
      </div>
    </div>

    <div class="procesos-grid">
      <% EXTERNOS.forEach(item => { %>
        <a href="<%= item.href %>" class="procesos-card" target="_blank" rel="noopener noreferrer">
          <span class="procesos-card__tile procesos-card__tile--logo" aria-hidden="true">
            <img src="<%= item.img %>" alt="">
          </span>
          <div class="procesos-card__cuerpo">
            <h4 class="procesos-card__titulo"><%= item.titulo %> <span class="sr-only">(se abre en una pestaña nueva)</span></h4>
            <p class="procesos-card__desc"><%= item.desc %></p>
          </div>
        </a>
      <% }) %>
    </div>
  </section>
  <% } %>
</div>
