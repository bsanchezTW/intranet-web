<%
/*
  Campos de la ficha de un colaborador. Los usan el alta y la edición, así los
  dos modales muestran exactamente lo mismo y en el mismo orden.

  Recibe:
    modo     — 'crear' | 'editar'
    persona  — la ficha (sólo al editar)

  Los ids del alta llevan el prefijo "crear_" porque los dos formularios
  pueden convivir en la misma página; personal-tabla.js y
  persona-editar-form.js los buscan por esos nombres.
*/
const esCrear = modo === 'crear';
const p = esCrear ? {} : persona;
const pre = esCrear ? 'crear_' : '';
const tieneCorreo = !esCrear && Boolean(p.email && String(p.email).trim());

const phonePrefix = '+' + countryConfig.phone.callingCode;
const parteLocal = (full) => String(full || '').startsWith(phonePrefix)
  ? String(full).slice(phonePrefix.length).trim()
  : '';
const fechaIso = (valor) => valor ? new Date(valor).toISOString().split('T')[0] : '';
const telMaxLength = countryConfig.phone.nationalDigits + countryConfig.phone.groups.length - 1;
const rolActual = p.role || 'Usuario';
%>

<section class="modal-section">
  <h3 class="modal-section__title"><%- include('../../partials/icon', { name: 'user' }) %> Datos personales</h3>

  <div class="campos-grid">
    <div class="campo-form">
      <label for="<%= pre %>first_name">Nombre <span class="required-mark">*</span></label>
      <input type="text" id="<%= pre %>first_name" name="first_name" required
             value="<%= p.first_name || '' %>" <%- esCrear ? 'placeholder="Ej: Juan"' : '' %>>
      <span class="campo-form__error" role="alert"></span>
    </div>
    <div class="campo-form">
      <label for="<%= pre %>last_name">Apellido <span class="required-mark">*</span></label>
      <input type="text" id="<%= pre %>last_name" name="last_name" required
             value="<%= p.last_name || '' %>" <%- esCrear ? 'placeholder="Ej: Pérez"' : '' %>>
      <span class="campo-form__error" role="alert"></span>
    </div>
    <div class="campo-form">
      <label for="<%= pre %>national_id"><%= documentoConfig.label %></label>
      <input type="text" id="<%= pre %>national_id" name="national_id"
             value="<%= p.documento || '' %>"
             data-national-id
             placeholder="<%= documentoConfig.example %>" autocomplete="off">
      <span class="campo-form__error" role="alert"></span>
    </div>
    <div class="campo-form">
      <% if (esCrear) { %>
        <label for="crear_fecha_nacimiento" id="crear_fecha_nacimiento_label">
          Fecha de nacimiento <span class="required-mark" id="crear_fecha_nacimiento_mark">*</span>
        </label>
        <input type="date" id="crear_fecha_nacimiento" name="birth_date" required>
      <% } else { %>
        <label for="fecha_nacimiento" id="fecha_nacimiento_label">
          Fecha de nacimiento<% if (!tieneCorreo) { %> <span class="required-mark">*</span><% } %>
        </label>
        <input type="date" id="fecha_nacimiento" name="birth_date"
               <%= tieneCorreo ? '' : 'required' %>
               value="<%= fechaIso(p.birth_date) %>">
      <% } %>
      <span class="campo-form__error" role="alert"></span>
    </div>
  </div>
</section>

<section class="modal-section">
  <h3 class="modal-section__title"><%- include('../../partials/icon', { name: 'mail' }) %> Contacto</h3>
  <p class="modal-section__hint">El contacto de empresa lo ve todo el mundo; el personal, sólo RRHH e Informática.</p>

  <div class="campos-grid">
    <div class="campo-form">
      <label for="<%= pre %>email">Correo de empresa</label>
      <input type="email" id="<%= pre %>email" name="email"
             value="<%= p.correo_empresa || '' %>"
             placeholder="nombre@empresa.com" autocomplete="email"
             <%- tieneCorreo ? 'data-email-locked="1"' : '' %>>
      <span class="campo-form__error" role="alert"></span>
    </div>
    <div class="campo-form">
      <label for="<%= pre %>work_phone_local">Teléfono de empresa</label>
      <div class="phone-field" data-phone-field data-phone-kind="work" id="<%= esCrear ? 'crear' : 'editar' %>_work_phone_field">
        <span class="phone-field__prefix" aria-hidden="true"><%= countryConfig.phone.callingCode ? phonePrefix : "" %></span>
        <input type="tel" id="<%= pre %>work_phone_local" class="phone-field__local" placeholder="<%= countryConfig.phone.example %>" maxlength="<%= telMaxLength %>" inputmode="numeric" autocomplete="off" aria-label="Teléfono de empresa sin código de país, celular o fijo" value="<%= parteLocal(p.work_phone) %>">
        <input type="hidden" name="work_phone" class="phone-field__full" id="<%= pre %>work_phone" value="<%= p.work_phone || '' %>">
      </div>
      <span class="campo-form__error" role="alert"></span>
    </div>
    <div class="campo-form">
      <label for="<%= pre %>personal_email">Correo personal</label>
      <input type="email" id="<%= pre %>personal_email" name="personal_email"
             value="<%= p.personal_email || '' %>"
             placeholder="nombre@gmail.com" autocomplete="off">
      <span class="campo-form__error" role="alert"></span>
    </div>
    <div class="campo-form">
      <label for="<%= pre %>telefono_local">Teléfono personal</label>
      <div class="phone-field" data-phone-field id="<%= esCrear ? 'crear' : 'editar' %>_phone_field">
        <span class="phone-field__prefix" aria-hidden="true"><%= countryConfig.phone.callingCode ? phonePrefix : "" %></span>
        <input type="tel" id="<%= pre %>telefono_local" class="phone-field__local" placeholder="<%= countryConfig.phone.example %>" maxlength="<%= telMaxLength %>" inputmode="numeric" autocomplete="off" aria-label="Celular personal sin código de país" value="<%= parteLocal(p.phone) %>">
        <input type="hidden" name="phone" id="<%= pre %>telefono" value="<%= p.phone || '' %>">
      </div>
      <span class="campo-form__error" role="alert"></span>
    </div>
  </div>
</section>

<section class="modal-section">
  <h3 class="modal-section__title"><%- include('../../partials/icon', { name: 'briefcase' }) %> Puesto</h3>

  <div class="campos-grid">
    <div class="campo-form">
      <label for="<%= esCrear ? 'crear_area_trabajo_id' : 'area_trabajo_id' %>">Área de trabajo <span class="required-mark">*</span></label>
      <select id="<%= esCrear ? 'crear_area_trabajo_id' : 'area_trabajo_id' %>" name="work_area_id" required>
        <option value="">Selecciona un área…</option>
        <% (areas || []).forEach(area => { %>
          <option value="<%= area.id %>" <%= Number(p.work_area_id) === Number(area.id) ? 'selected' : '' %>><%= area.area_name %></option>
        <% }) %>
      </select>
      <span class="campo-form__error" role="alert"></span>
    </div>

    <div class="campo-form">
      <% if (!esCrear && p.email_confirmed) { %>
        <label for="role">Rol de intranet <span class="required-mark">*</span></label>
        <select id="role" name="role" required>
          <option value="Usuario"       <%= (rolActual === 'Usuario' || rolActual === 'usuario') ? 'selected' : '' %>>Usuario</option>
          <option value="Administrador" <%= (rolActual === 'Administrador' || rolActual === 'admin') ? 'selected' : '' %>>Administrador</option>
          <option value="Deshabilitado" <%= (rolActual === 'Deshabilitado') ? 'selected' : '' %>>Deshabilitado</option>
        </select>
      <% } else { %>
        <label for="<%= pre %>role">Rol de intranet</label>
        <select id="<%= pre %>role" disabled aria-describedby="<%= pre %>role_ayuda">
          <option selected>Deshabilitado</option>
        </select>
        <span class="campo-form__ayuda" id="<%= pre %>role_ayuda">Se habilita al verificar el correo.</span>
      <% } %>
    </div>

    <div class="campo-form">
      <label for="<%= pre %>hire_date">Fecha de ingreso</label>
      <input type="date" id="<%= pre %>hire_date" name="hire_date" value="<%= fechaIso(p.hire_date) %>">
    </div>

    <%# Reglas de vacaciones chilenas: sólo si la intranet calcula vacaciones en
        Chile. Hoy no (se solicitan en Rex+), así que no se muestran. %>
    <% if (country === 'CL' && features.vacations) { %>
      <div class="campo-form">
        <label for="<%= pre %>prior_years_credited">Años previos acreditados</label>
        <input type="number" id="<%= pre %>prior_years_credited" name="prior_years_credited"
               min="0" max="10" step="0.5"
               value="<%= p.prior_years_credited != null ? p.prior_years_credited : 0 %>">
      </div>
      <div class="campo-form">
        <label for="<%= pre %>progressive_days_override">Progresivo negociado</label>
        <input type="number" id="<%= pre %>progressive_days_override" name="progressive_days_override"
               min="0" step="1" placeholder="Opcional"
               value="<%= p.progressive_days_override != null ? p.progressive_days_override : '' %>">
      </div>
    <% } %>

    <% if (country === 'PE') { %>
      <% const jornada = p.work_days_per_week || 5; %>
      <div class="campo-form">
        <label for="<%= pre %>work_days_per_week">Jornada (días/semana)</label>
        <select id="<%= pre %>work_days_per_week" name="work_days_per_week">
          <option value="5" <%= jornada === 5 ? 'selected' : '' %>>5 días</option>
          <option value="6" <%= jornada === 6 ? 'selected' : '' %>>6 días</option>
          <option value="4" <%= jornada === 4 ? 'selected' : '' %>>4 días</option>
          <option value="3" <%= jornada === 3 ? 'selected' : '' %>>3 días</option>
        </select>
      </div>
    <% } %>

    <%- include('campo_centros_costo', {
      centros: typeof centrosCosto !== 'undefined' ? centrosCosto : [],
      seleccionados: !esCrear && typeof centrosSeleccionados !== 'undefined' ? centrosSeleccionados : [],
      max: typeof maxCentrosCosto !== 'undefined' ? maxCentrosCosto : 2,
      idPrefijo: esCrear ? 'crear' : 'editar',
    }) %>
  </div>
</section>
