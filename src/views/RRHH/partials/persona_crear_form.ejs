<form action="/RRHH/crear" method="POST" id="formCrearColaborador">

  <section class="form-seccion">
    <h3 class="form-seccion__title">
      <span class="form-seccion__icon" aria-hidden="true"><%- include('../../partials/icon', { name: 'user' }) %></span>
      Datos personales
    </h3>

    <div class="campos-grid">
      <div class="campo-form">
        <label for="crear_first_name">Nombre <span class="required-mark">*</span></label>
        <input type="text" id="crear_first_name" name="first_name" required placeholder="Ej: Juan">
        <span class="campo-form__error" role="alert"></span>
      </div>
      <div class="campo-form">
        <label for="crear_last_name">Apellido <span class="required-mark">*</span></label>
        <input type="text" id="crear_last_name" name="last_name" required placeholder="Ej: Pérez">
        <span class="campo-form__error" role="alert"></span>
      </div>
      <div class="campo-form">
        <label for="crear_national_id"><%= documentoConfig.label %></label>
        <input type="text" id="crear_national_id" name="national_id"
               data-national-id
               placeholder="<%= documentoConfig.example %>" autocomplete="off">
        <span class="campo-form__error" role="alert"></span>
      </div>
      <div class="campo-form">
        <label for="crear_fecha_nacimiento" id="crear_fecha_nacimiento_label">
          Fecha de nacimiento <span class="required-mark" id="crear_fecha_nacimiento_mark">*</span>
        </label>
        <input type="date" id="crear_fecha_nacimiento" name="birth_date" required>
        <span class="campo-form__error" role="alert"></span>
      </div>
    </div>
  </section>

  <section class="form-seccion">
    <h3 class="form-seccion__title">
      <span class="form-seccion__icon" aria-hidden="true"><%- include('../../partials/icon', { name: 'mail' }) %></span>
      Contacto
    </h3>

    <div class="campos-grid">
      <div class="campo-form">
        <label for="crear_email">Correo electrónico</label>
        <input type="email" id="crear_email" name="email" placeholder="nombre@empresa.com" autocomplete="email">
        <span class="campo-form__error" role="alert"></span>
      </div>
      <div class="campo-form">
        <label for="crear_telefono_local">Teléfono</label>
        <div class="phone-field" data-phone-field id="crear_phone_field">
          <span class="phone-field__prefix" aria-hidden="true"><%= countryConfig.phone.callingCode ? "+" + countryConfig.phone.callingCode : "" %></span>
          <input type="tel" id="crear_telefono_local" class="phone-field__local" placeholder="<%= countryConfig.phone.example %>" maxlength="<%= countryConfig.phone.nationalDigits + countryConfig.phone.groups.length - 1 %>" inputmode="numeric" autocomplete="tel-national" aria-label="Número celular sin código de país">
          <input type="hidden" name="phone" id="crear_telefono">
        </div>
        <span class="campo-form__error" role="alert"></span>
      </div>
    </div>
  </section>

  <section class="form-seccion">
    <h3 class="form-seccion__title">
      <span class="form-seccion__icon" aria-hidden="true"><%- include('../../partials/icon', { name: 'briefcase' }) %></span>
      Puesto
    </h3>

    <div class="campos-grid">
      <div class="campo-form campo-form--ancho">
        <label for="crear_area_trabajo_id">Área de trabajo <span class="required-mark">*</span></label>
        <select id="crear_area_trabajo_id" name="work_area_id" required>
          <option value="">Selecciona un área…</option>
          <% (areas || []).forEach(area => { %>
            <option value="<%= area.id %>"><%= area.area_name %></option>
          <% }) %>
        </select>
        <span class="campo-form__error" role="alert"></span>
      </div>

      <%- include('campo_centros_costo', {
        centros: typeof centrosCosto !== 'undefined' ? centrosCosto : [],
        seleccionados: [],
        max: typeof maxCentrosCosto !== 'undefined' ? maxCentrosCosto : 2,
        idPrefijo: 'crear',
      }) %>

      <div class="campo-form">
        <label for="crear_hire_date">Fecha de ingreso</label>
        <input type="date" id="crear_hire_date" name="hire_date">
      </div>

      <div class="campo-form">
        <label for="crear_role">Rol de intranet</label>
        <input type="text" id="crear_role" value="Deshabilitado" readonly aria-readonly="true">
        <span class="campo-form__ayuda">Se habilita al verificar el correo.</span>
      </div>

      <% if (country === 'CL') { %>
        <div class="campo-form">
          <label for="crear_prior_years_credited">Años previos acreditados</label>
          <input type="number" id="crear_prior_years_credited" name="prior_years_credited" min="0" max="10" step="0.5" value="0">
        </div>
        <div class="campo-form">
          <label for="crear_progressive_days_override">Progresivo negociado</label>
          <input type="number" id="crear_progressive_days_override" name="progressive_days_override" min="0" step="1" placeholder="Opcional">
        </div>
      <% } %>

      <% if (country === 'PE') { %>
        <div class="campo-form">
          <label for="crear_work_days_per_week">Jornada (días/semana)</label>
          <select id="crear_work_days_per_week" name="work_days_per_week">
            <option value="5" selected>5 días</option>
            <option value="6">6 días</option>
            <option value="4">4 días</option>
            <option value="3">3 días</option>
          </select>
        </div>
      <% } %>
    </div>
  </section>

  <div class="modal-form-actions">
    <button type="button" class="btn-secundario" data-modal-close>Cancelar</button>
    <button type="submit" class="btn-primario">Guardar colaborador</button>
  </div>
</form>
