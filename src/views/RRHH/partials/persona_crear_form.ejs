<%# Alta de colaborador. Misma anatomía que la edición (persona_editar_modal):
    lateral con la identidad, campos en el centro y acciones en el pie. %>
<form action="/RRHH/crear" method="POST" id="formCrearColaborador">
  <%# personal-tabla.js pregunta al guardar si se envía la clave temporal. %>
  <input type="hidden" name="enviar_clave" id="crear_enviar_clave" value="1">
  <header class="modal-head">
    <h2 id="crearColaboradorTitle" class="modal-title">Agregar colaborador</h2>
    <p class="modal-subtitle">Los campos con <span class="required-mark">*</span> son obligatorios. La foto se agrega después, al editar la ficha.</p>
  </header>

  <div class="modal-body modal-body--split colaborador-modal__body">
    <aside class="modal-aside colaborador-aside">
      <div class="colaborador-aside__avatar monogram" aria-hidden="true" data-crear-iniciales>
        <%- include('../../partials/icon', { name: 'user-plus' }) %>
      </div>
      <div class="colaborador-aside__identidad">
        <p class="colaborador-aside__nombre" data-crear-nombre>Nuevo colaborador</p>
        <p class="colaborador-aside__dato">Completa sus datos para crear la ficha.</p>
      </div>
    </aside>

    <div class="modal-main">
      <div id="crearColaboradorError" class="modal-alert" role="alert"></div>
      <%- include('persona_campos', { modo: 'crear' }) %>
    </div>
  </div>

  <footer class="modal-foot">
    <button type="button" class="btn-secundario" data-modal-close>Cancelar</button>
    <button type="submit" class="btn-primario">Guardar colaborador</button>
  </footer>
</form>
