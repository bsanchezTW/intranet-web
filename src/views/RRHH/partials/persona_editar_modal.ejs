<%
  const nombreColaborador = [(persona.first_name || ''), (persona.last_name || '')].filter(Boolean).join(' ') || 'este colaborador';
  const tieneFoto = Boolean(persona.photo);
  // `email` es el correo de la cuenta (empresa o, si no hay, el personal).
  const tieneCorreoRegistrado = Boolean(persona.email && String(persona.email).trim());
  // Los deshabilitados pueden recibir una clave temporal para (re)activar su acceso.
  const estaDeshabilitado = String(persona.role || 'Deshabilitado').toLowerCase() === 'deshabilitado';
  const areaActual = (areas || []).find((a) => Number(a.id) === Number(persona.work_area_id));
  const pillArea = areaActual
    ? getWorkAreaPill(areaActual.area_name, areaActual.color)
    : null;
  const monogram = getMonogram({
    first_name: persona.first_name,
    last_name: persona.last_name,
    area: areaActual ? areaActual.area_name : null,
    area_color: areaActual ? areaActual.color : null,
  });
%>
<%# Fragmento que personal-tabla.js inyecta en #modalEditarColaboradorBody.
    Misma anatomía que el alta (persona_crear_form). %>

<header class="modal-head">
  <h2 class="modal-title" id="editarColaboradorTitle">Editar colaborador</h2>
  <p class="modal-subtitle"><%= nombreColaborador %><% if (tieneCorreoRegistrado) { %> · <%= persona.email %><% } %></p>
</header>

<div class="modal-body modal-body--split colaborador-modal__body">
  <aside class="modal-aside colaborador-aside">
    <div class="profile-photo-upload colaborador-aside__foto">
      <div class="profile-photo-preview-wrap">
        <div class="profile-photo-preview profile-photo-preview--light" id="photo-preview">
          <img id="photo-preview-img" alt="" <% if (tieneFoto) { %>src="<%= persona.photo %>"<% } else { %>hidden<% } %>>
          <div class="profile-photo-placeholder monogram" id="photo-placeholder" style="<%= monogram.style %>" <%= tieneFoto ? 'hidden' : '' %>>
            <span aria-hidden="true"><%= monogram.initials %></span>
          </div>
        </div>
        <div class="profile-photo-actions">
          <button type="button" class="btn-secundario" id="btn-select-photo">
            <%= tieneFoto ? 'Cambiar foto' : 'Seleccionar foto' %>
          </button>
          <button type="button" class="btn-photo-remove" id="btn-remove-photo" <%= tieneFoto ? '' : 'hidden' %>>Quitar foto</button>
        </div>
      </div>
      <input type="file" id="foto" name="foto" accept="image/*" hidden form="formEditarPersona">
      <input type="hidden" name="eliminar_foto" id="eliminar_foto" value="0" form="formEditarPersona">
    </div>

    <div class="colaborador-aside__identidad">
      <p class="colaborador-aside__nombre"><%= nombreColaborador %></p>
      <% if (pillArea) { %>
        <span class="<%= pillArea.pillClass %>"<% if (pillArea.pillStyle) { %> style="<%= pillArea.pillStyle %>"<% } %>><%= areaActual.area_name %></span>
      <% } %>
    </div>
  </aside>

  <div class="modal-main">
    <div data-colaborador-alertas></div>
    <form action="/RRHH/editar/<%= persona.id %>" method="POST" enctype="multipart/form-data" id="formEditarPersona" class="modal-section-stack">
      <%- include('persona_campos', { modo: 'editar', persona }) %>
    </form>
  </div>
</div>

<footer class="modal-foot">
  <div class="modal-foot__start">
    <button type="submit" form="formEliminarPersona" class="btn-peligro-suave">
      <%- include('../../partials/icon', { name: 'trash' }) %> Eliminar colaborador
    </button>
    <% if (estaDeshabilitado) { %>
      <button type="button" class="btn-secundario" data-enviar-clave="<%= persona.id %>"
              data-enviar-clave-correo="<%= tieneCorreoRegistrado ? persona.email : '' %>"
              <% if (!tieneCorreoRegistrado) { %>disabled title="Agrega un correo y guarda la ficha para poder enviarla"<% } %>>
        <%- include('../../partials/icon', { name: 'mail' }) %> Enviar contraseña temporal
      </button>
    <% } %>
  </div>
  <button type="button" class="btn-secundario" data-modal-close>Cancelar</button>
  <button type="submit" form="formEditarPersona" class="btn-primario">Guardar cambios</button>
</footer>

<form id="formEliminarPersona" action="/RRHH/eliminar/<%= persona.id %>" method="POST" hidden
      data-confirm="Se borrará la ficha de <%= nombreColaborador %> de forma permanente. Esta acción no se puede deshacer."
      data-confirm-title="¿Eliminar colaborador?"
      data-confirm-accept="Eliminar"
      data-confirm-tone="peligro"></form>

<div class="foto-crop-overlay" id="fotoCropOverlay" role="dialog" aria-modal="true" aria-labelledby="fotoCropTitle" hidden>
  <div class="foto-crop-modal">
    <div class="foto-crop-header">
      <h3 id="fotoCropTitle">Recortar foto de perfil</h3>
      <button type="button" class="foto-crop-close" id="fotoCropClose" aria-label="Cerrar">&times;</button>
    </div>
    <div class="foto-crop-body">
      <div class="foto-crop-stage">
        <img id="fotoCropImage" src="" alt="Vista previa para recortar">
      </div>
    </div>
    <p id="fotoCropError" class="foto-crop-error" role="alert"></p>
    <div class="foto-crop-footer">
      <button type="button" class="btn-crop-cancel" id="fotoCropCancel">Cancelar</button>
      <button type="button" class="btn-crop-save" id="fotoCropSave">Aplicar recorte</button>
    </div>
  </div>
</div>
