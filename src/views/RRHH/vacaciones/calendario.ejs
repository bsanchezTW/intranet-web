<link rel="stylesheet" href="/css/vacaciones.css?v=20260923a">

<div class="vac-wrap">
  <div class="page-header">
    <span class="page-header__icono" aria-hidden="true"><%- include('../../partials/icon', { name: 'calendar' }) %></span>
    <div class="page-header__text">
      <nav class="page-header__migas" aria-label="Ruta de navegación">
        <a href="/RRHH">RRHH</a> <span aria-hidden="true">/</span>
        <a href="/RRHH/vacaciones">Vacaciones</a> <span aria-hidden="true">/</span>
        <span>Calendario</span>
      </nav>
      <h2 class="page-title">Calendario de vacaciones</h2>
      <p class="page-description">Vacaciones aprobadas de todo el equipo.</p>
    </div>
  </div>

  <div class="vac-panel">
    <div class="vac-panel-head">
      <a class="vac-btn vac-btn-cancel vac-btn-sm" href="/RRHH/vacaciones/calendario?mes=<%= prevMes %>" aria-label="Mes anterior">←</a>
      <h3 class="vac-cal__title"><%= monthLabel %></h3>
      <a class="vac-btn vac-btn-cancel vac-btn-sm" href="/RRHH/vacaciones/calendario?mes=<%= nextMes %>" aria-label="Mes siguiente">→</a>
    </div>

    <div class="vac-cal-scroll">
      <table class="vac-cal">
        <thead>
          <tr>
            <% weekdays.forEach(function (day) { %>
              <th scope="col"><%= day %></th>
            <% }) %>
          </tr>
        </thead>
        <tbody>
          <% weeks.forEach(function (week) { %>
            <tr>
              <% week.forEach(function (day) { %>
                <td class="vac-cal__day<%= day.inMonth ? '' : ' is-out' %><%= day.isToday ? ' is-today' : '' %>">
                  <span class="vac-cal__num"><%= day.number %></span>
                  <% if (day.people.length) { %>
                    <ul class="vac-cal__people">
                      <% day.people.forEach(function (person) { %>
                        <li class="vac-cal__person" title="<%= person.title %>"><%= person.label %></li>
                      <% }) %>
                      <% if (day.extra) { %>
                        <li class="vac-cal__more" title="<%= day.extraTitle %>">+<%= day.extra %></li>
                      <% } %>
                    </ul>
                  <% } %>
                </td>
              <% }) %>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
