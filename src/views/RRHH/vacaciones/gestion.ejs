<link rel="stylesheet" href="/css/vacaciones.css?v=20261008a">

<%
  // Una sola consulta (listForAdmin) y dos bloques: lo que falta resolver
  // arriba y el historial abajo. El filtro de área aplica a ambos; el de
  // estado elige qué bloque se ve.
  const lista = Array.isArray(requests) ? requests : [];
  const porAprobar = lista.filter((r) => r.status === 'pending');
  const historial = lista.filter((r) => r.status !== 'pending');
  const verPorAprobar = !filtros.status || filtros.status === 'pending';
  const verHistorial = filtros.status !== 'pending';
  const yo = user ? Number(user.id) : null;
%>

<div class="vac-wrap">
  <div class="page-header">
    <span class="page-header__icono" aria-hidden="true"><%- include('../../partials/icon', { name: 'check-circle' }) %></span>
    <div class="page-header__text">
      <nav class="page-header__migas" aria-label="Ruta de navegación">
        <a href="/RRHH">RRHH</a> <span aria-hidden="true">/</span>
        <a href="/RRHH/vacaciones">Vacaciones</a> <span aria-hidden="true">/</span>
        <span>Gestión</span>
      </nav>
      <h2 class="page-title">Gestión de vacaciones</h2>
      <p class="page-description">Aprueba o rechaza solicitudes y revisa los saldos del equipo.</p>
    </div>
    <div class="page-header-actions">
      <a class="page-header-btn page-header-btn--secundario" href="/RRHH/vacaciones/gestion/resumen">Resumen y días vencidos</a>
      <%# La exportación respeta los filtros aplicados abajo. %>
      <a class="page-header-btn page-header-btn--secundario"
         href="/RRHH/vacaciones/gestion/exportar?area=<%= encodeURIComponent(filtros.area || '') %>&status=<%= encodeURIComponent(filtros.status || '') %>">Exportar a Excel</a>
    </div>
  </div>

  <% if (typeof success !== 'undefined' && success) { %>
    <div hidden data-toast="<%= success %>"></div>
  <% } %>
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="flash-msg flash-msg--error" role="alert"><%= error %></div>
  <% } %>

  <div class="vac-panel">
    <form class="vac-filters vac-filters--solo" method="GET" action="/RRHH/vacaciones/gestion">
      <select name="area" aria-label="Área">
        <option value="">Todas las áreas</option>
        <% (areas || []).forEach(a => { %>
          <option value="<%= a.id %>" <%= String(filtros.area) === String(a.id) ? 'selected' : '' %>><%= a.area_name %></option>
        <% }) %>
      </select>
      <select name="status" aria-label="Estado">
        <option value="">Todos los estados</option>
        <option value="pending" <%= filtros.status === 'pending' ? 'selected' : '' %>>Pendiente</option>
        <option value="approved" <%= filtros.status === 'approved' ? 'selected' : '' %>>Aprobada</option>
        <option value="rejected" <%= filtros.status === 'rejected' ? 'selected' : '' %>>Rechazada</option>
        <option value="in_progress" <%= filtros.status === 'in_progress' ? 'selected' : '' %>>En curso</option>
        <option value="completed" <%= filtros.status === 'completed' ? 'selected' : '' %>>Completada</option>
        <option value="cancelled" <%= filtros.status === 'cancelled' ? 'selected' : '' %>>Cancelada</option>
      </select>
      <button type="submit" class="vac-btn vac-btn-primary vac-btn-sm">Filtrar</button>
    </form>
  </div>

  <% if (verPorAprobar) { %>
  <div class="vac-panel">
    <div class="vac-panel-head">
      <span>Por aprobar <% if (porAprobar.length) { %><span class="vac-panel-count"><%= porAprobar.length %></span><% } %></span>
    </div>
    <% if (!porAprobar.length) { %>
      <p class="vac-empty">No hay solicitudes pendientes<%= filtros.area ? ' en esta área' : '' %>.</p>
    <% } else { %>
      <table class="vac-table vac-table--stack">
        <thead>
          <tr>
            <th>Colaborador</th><th>Área</th><th>Período</th><th>Días</th>
            <th>Aprueba</th><th>Comentario</th><th>Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% porAprobar.forEach(r => { const mia = yo !== null && Number(r.user_id) === yo; %>
            <tr>
              <td data-label="Colaborador">
                <% if (r.requester_deleted) { %>
                  <span class="vac-link-colaborador"><%= r.collaboratorName || 'Colaborador' %> <small>(usuario eliminado)</small></span>
                <% } else { %>
                  <a class="vac-link-colaborador" href="/RRHH/vacaciones/gestion/<%= r.user_id %>"><%= r.collaboratorName || ('#' + r.user_id) %></a>
                <% } %>
              </td>
              <td data-label="Área"><%= r.area || '-' %></td>
              <td data-label="Período"><%= r.startDateFmt %> → <%= r.endDateFmt %></td>
              <td data-label="Días"><%= r.days %> <%= r.dayUnit %></td>
              <td data-label="Aprueba">
                <% if (r.approver_user_id != null && Number(r.approver_user_id) === yo) { %>
                  <span class="vac-badge vac-badge-pending">Tú</span>
                <% } else { %>
                  <%= r.approver_name || 'RRHH' %>
                <% } %>
              </td>
              <td data-label="Comentario"><%= r.requester_notes || '-' %></td>
              <td data-label="">
                <% if (mia) { %>
                  <%# Nadie se aprueba a sí mismo (canReviewRequest): la resuelve otro administrador. %>
                  <small class="vac-nota-propia">Es tu solicitud: la resuelve otra persona.</small>
                <% } else { %>
                  <form class="vac-inline-form" action="/RRHH/vacaciones/gestion/solicitud/<%= r.id %>/aprobar" method="POST"
                        data-confirm="Se aprobarán <%= r.days %> <%= r.dayUnit %> (<%= r.startDateFmt %> → <%= r.endDateFmt %>)."
                        data-confirm-title="¿Aprobar la solicitud?"
                        data-confirm-accept="Aprobar">
                    <button type="submit" class="vac-btn vac-btn-approve vac-btn-sm">Aprobar</button>
                  </form>
                  <form class="vac-inline-form js-reject-form" action="/RRHH/vacaciones/gestion/solicitud/<%= r.id %>/rechazar" method="POST">
                    <input type="hidden" name="reason">
                    <button type="submit" class="vac-btn vac-btn-reject vac-btn-sm">Rechazar</button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
  <% } %>

  <% if (verHistorial) { %>
  <div class="vac-panel">
    <div class="vac-panel-head">Historial</div>
    <% if (!historial.length) { %>
      <p class="vac-empty">No hay solicitudes resueltas con los filtros aplicados.</p>
    <% } else { %>
      <table class="vac-table vac-table--stack">
        <thead>
          <tr>
            <th>Colaborador</th><th>Período</th><th>Días</th>
            <th>Estado</th><th>Resuelta</th><th>Comentario</th>
          </tr>
        </thead>
        <tbody>
          <% historial.forEach(r => { %>
            <tr>
              <td data-label="Colaborador">
                <% if (r.requester_deleted) { %>
                  <%# Colaborador eliminado: se conserva el nombre, pero ya no hay ficha a la que enlazar. %>
                  <span class="vac-link-colaborador"><%= r.collaboratorName || 'Colaborador' %> <small>(usuario eliminado)</small></span>
                <% } else { %>
                  <a class="vac-link-colaborador" href="/RRHH/vacaciones/gestion/<%= r.user_id %>"><%= r.collaboratorName || ('#' + r.user_id) %></a>
                <% } %>
              </td>
              <td data-label="Período"><%= r.startDateFmt %> → <%= r.endDateFmt %></td>
              <td data-label="Días"><%= r.days %> <%= r.dayUnit %></td>
              <td data-label="Estado"><span class="<%= r.statusBadge %>"><%= r.statusLabel %></span></td>
              <td data-label="Resuelta"><%= r.reviewedAtFmt || '-' %></td>
              <td data-label="Comentario"><%= r.reviewer_notes || r.requester_notes || '-' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
  <% } %>
</div>

<script>
  document.querySelectorAll('.js-reject-form').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      // Segunda pasada, ya con el motivo escrito: se envía.
      if (form.dataset.motivoListo === '1') {
        delete form.dataset.motivoListo;
        return;
      }
      e.preventDefault();
      const reason = await IntranetDialog.prompt({
        title: '¿Rechazar la solicitud?',
        message: 'El colaborador verá este motivo.',
        label: 'Motivo del rechazo',
        multiline: true,
        acceptLabel: 'Rechazar',
        tone: 'peligro',
      });
      if (!reason) return;
      form.querySelector('input[name="reason"]').value = reason;
      form.dataset.motivoListo = '1';
      form.requestSubmit();
    });
  });
</script>
