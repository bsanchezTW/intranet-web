<link rel="stylesheet" href="/css/vacaciones.css?v=20260922a">

<%
  const hayPreview = Boolean(preview);
  const paso = hayPreview ? 3 : 1;
%>

<div class="vac-wrap">
  <div class="page-header">
    <span class="page-header__icono" aria-hidden="true"><%- include('../../partials/icon', { name: 'file-spreadsheet' }) %></span>
    <div class="page-header__text">
      <nav class="page-header__migas" aria-label="Ruta de navegación">
        <a href="/RRHH">RRHH</a> <span aria-hidden="true">/</span>
        <a href="/RRHH/vacaciones">Vacaciones</a> <span aria-hidden="true">/</span>
        <a href="/RRHH/vacaciones/gestion">Gestión</a> <span aria-hidden="true">/</span>
        <span>Importar historial</span>
      </nav>
      <h2 class="page-title">Importar vacaciones históricas</h2>
      <p class="page-description">
        Carga desde Excel los días que los colaboradores ya se tomaron antes de
        usar la intranet. Nada se guarda hasta que revises y confirmes.
      </p>
    </div>
  </div>

  <% if (typeof success !== 'undefined' && success) { %>
    <div hidden data-toast="<%= success %>"></div>
  <% } %>
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="flash-msg flash-msg--error" role="alert"><%= error %></div>
  <% } %>

  <div class="vac-panel">
    <ol class="vac-steps">
      <li class="vac-step <%= paso > 1 ? 'is-lista' : 'is-actual' %>">
        <span class="vac-step__num">1</span> Descargar la plantilla
      </li>
      <li class="vac-step <%= paso > 1 ? 'is-lista' : '' %>">
        <span class="vac-step__num">2</span> Seleccionar el archivo
      </li>
      <li class="vac-step <%= paso === 3 ? 'is-actual' : '' %>">
        <span class="vac-step__num">3</span> Revisar los resultados
      </li>
      <li class="vac-step">
        <span class="vac-step__num">4</span> Confirmar
      </li>
    </ol>

    <div class="vac-form">
      <div class="campo">
        <label for="cutoff_date_display">Fecha de corte del historial</label>
        <% if (cutoffDateFmt) { %>
          <p class="vac-preview" style="margin-bottom:10px;">
            Historial migrado hasta el <strong><%= cutoffDateFmt %></strong>.
            Desde el día siguiente, las vacaciones se registran como solicitud
            en la intranet.
          </p>
        <% } else { %>
          <p class="vac-hint" style="margin-bottom:10px;">
            Todavía no está definida. Fíjala antes de importar para que quede
            claro hasta qué día manda el Excel y desde cuándo manda la intranet.
          </p>
        <% } %>
        <form class="vac-file" method="POST" action="/RRHH/vacaciones/gestion/corte">
          <input
            type="date"
            id="cutoff_date_display"
            name="cutoff_date"
            value="<%= cutoffDate || '' %>"
            style="flex:0 1 200px;"
            required
          >
          <button type="submit" class="vac-btn vac-btn-cancel vac-btn-sm">
            <%= cutoffDate ? 'Actualizar corte' : 'Fijar corte' %>
          </button>
        </form>
      </div>
    </div>
  </div>

  <% if (!hayPreview) { %>
  <div class="vac-panel">
    <div class="vac-panel-head">
      Cargar archivo
      <div class="vac-panel-actions">
        <a class="vac-btn vac-btn-cancel vac-btn-sm" href="/RRHH/vacaciones/gestion/historial/plantilla">
          Descargar plantilla
        </a>
      </div>
    </div>
    <form
      class="vac-form"
      method="POST"
      action="/RRHH/vacaciones/gestion/historial/importar/validar"
      enctype="multipart/form-data"
    >
      <div class="campo">
        <label for="archivo">Archivo Excel (.xlsx) *</label>
        <div class="vac-file">
          <input type="file" id="archivo" name="archivo" accept=".xlsx" required>
          <button type="submit" class="vac-btn vac-btn-primary">Validar archivo</button>
        </div>
        <span class="vac-hint">
          Una fila por salida de vacaciones. Si una persona salió tres veces,
          van tres filas: el detalle es lo que después permite corregir.
        </span>
      </div>
    </form>
    <p class="vac-panel-note">
      La plantilla trae una hoja de instrucciones con qué poner en cada columna.
      El trabajador se identifica por su documento, no por el nombre.
    </p>
  </div>
  <% } %>

  <% if (hayPreview) { %>
  <div class="vac-panel">
    <div class="vac-panel-head">
      Vista previa — <%= preview.fileName || 'archivo cargado' %>
      <span class="vac-stat-unit"><%= preview.totalRows %> fila(s) encontradas</span>
    </div>

    <div class="vac-preview-stats">
      <div class="vac-preview-stat vac-preview-stat--ok">
        <div class="vac-preview-stat__label">Registros válidos</div>
        <div class="vac-preview-stat__value"><%= preview.validRows %></div>
      </div>
      <div class="vac-preview-stat <%= preview.errorRows ? 'vac-preview-stat--error' : '' %>">
        <div class="vac-preview-stat__label">Con errores</div>
        <div class="vac-preview-stat__value"><%= preview.errorRows %></div>
      </div>
      <div class="vac-preview-stat <%= preview.duplicateRows ? 'vac-preview-stat--warn' : '' %>">
        <div class="vac-preview-stat__label">Posibles duplicados</div>
        <div class="vac-preview-stat__value"><%= preview.duplicateRows %></div>
      </div>
      <div class="vac-preview-stat">
        <div class="vac-preview-stat__label">Trabajadores</div>
        <div class="vac-preview-stat__value"><%= preview.employeeCount %></div>
      </div>
      <div class="vac-preview-stat">
        <div class="vac-preview-stat__label">Días a cargar</div>
        <div class="vac-preview-stat__value"><%= preview.totalDays %></div>
      </div>
    </div>

    <% if (preview.errors && preview.errors.length) { %>
      <ul class="vac-rows">
        <details open>
          <summary>Ver las <%= preview.errors.length %> fila(s) con error</summary>
          <% preview.errors.forEach(e => { %>
            <li class="vac-row-issue vac-row-issue--error">
              <strong>Fila <%= e.row %></strong><% if (e.document) { %> · <%= e.document %><% } %><% if (e.name) { %> · <%= e.name %><% } %>
              <span><%= e.error %></span>
            </li>
          <% }) %>
        </details>
      </ul>
    <% } %>

    <% if (preview.warnings && preview.warnings.length) { %>
      <ul class="vac-rows">
        <details>
          <summary>Ver <%= preview.warnings.length %> aviso(s)</summary>
          <% preview.warnings.forEach(w => { %>
            <li class="vac-row-issue vac-row-issue--warn">
              <strong>Fila <%= w.row %></strong><% if (w.name) { %> · <%= w.name %><% } %>
              <span><%= w.warning %></span>
            </li>
          <% }) %>
        </details>
      </ul>
    <% } %>

    <% if (preview.valid && preview.valid.length) { %>
      <table class="vac-table vac-table--stack">
        <thead>
          <tr><th>Fila</th><th>Trabajador</th><th>Documento</th><th>Período</th><th>Días</th><th>Revisar</th></tr>
        </thead>
        <tbody>
          <% preview.valid.slice(0, 200).forEach(v => { %>
            <tr class="<%= v.duplicate ? 'is-alerta' : '' %>">
              <td data-label="Fila"><%= v.row %></td>
              <td data-label="Trabajador"><%= v.employeeName %></td>
              <td data-label="Documento"><%= v.document %></td>
              <td data-label="Período">
                <%= v.value.periodMonth ? months[v.value.periodMonth - 1] + ' ' : '' %><%= v.value.periodYear %>
                <% if (v.value.startDate) { %>
                  <br><span class="vac-stat-unit"><%= v.value.startDate %> → <%= v.value.endDate %></span>
                <% } %>
              </td>
              <td data-label="Días"><strong><%= v.value.daysUsed %></strong></td>
              <td data-label="Revisar"><%= v.duplicate ? 'Posible duplicado' : '—' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <% if (preview.valid.length > 200) { %>
        <p class="vac-panel-note">Se muestran las primeras 200 filas; se importarán todas las válidas.</p>
      <% } %>
    <% } %>

    <div class="vac-form">
      <% if (preview.duplicateRows > 0) { %>
        <div class="campo vac-check-campo">
          <label>
            <input type="checkbox" name="incluir_duplicados" value="1" form="formConfirmarImport">
            Importar también los <%= preview.duplicateRows %> posible(s) duplicado(s)
          </label>
          <span class="vac-hint">
            Por defecto se omiten. Márcalo solo si de verdad son salidas
            distintas con los mismos días en el mismo mes.
          </span>
        </div>
      <% } %>

      <div class="vac-panel-actions">
        <form
          id="formConfirmarImport"
          method="POST"
          action="/RRHH/vacaciones/gestion/historial/importar/confirmar"
          data-confirm="Se cargarán los registros válidos y se recalcularán los saldos de <%= preview.employeeCount %> trabajador(es)."
          data-confirm-title="¿Confirmar la importación?"
          data-confirm-accept="Confirmar importación"
        >
          <button type="submit" class="vac-btn vac-btn-primary" <%= preview.validRows === 0 ? 'disabled' : '' %>>
            Confirmar importación
          </button>
        </form>
        <form method="POST" action="/RRHH/vacaciones/gestion/historial/importar/cancelar">
          <button type="submit" class="vac-btn vac-btn-cancel">Cancelar y cargar otro archivo</button>
        </form>
      </div>

      <% if (preview.validRows === 0) { %>
        <p class="vac-hint" style="margin-top:10px;">
          No hay ningún registro válido que importar. Corrige el archivo con los
          errores de arriba y vuelve a cargarlo.
        </p>
      <% } %>
    </div>
  </div>
  <% } %>

  <div class="vac-panel">
    <div class="vac-panel-head">
      Importaciones anteriores
      <div class="vac-panel-actions">
        <a class="vac-btn vac-btn-cancel vac-btn-sm" href="/RRHH/vacaciones/gestion/historial/exportar">
          Exportar historial completo
        </a>
      </div>
    </div>
    <% if (!batches || batches.length === 0) { %>
      <p class="vac-empty">Todavía no se ha importado ningún archivo.</p>
    <% } else { %>
      <table class="vac-table vac-table--stack">
        <thead>
          <tr><th>Archivo</th><th>Fecha</th><th>Cargó</th><th>Importados</th><th>Con error</th><th>Estado</th><th></th></tr>
        </thead>
        <tbody>
          <% batches.forEach(b => {
               const quien = [b.first_name, b.last_name].filter(Boolean).join(' ') || '—';
               const cuando = b.created_at ? new Date(b.created_at).toLocaleString('es-PE') : '—';
          %>
            <tr>
              <td data-label="Archivo"><%= b.file_name || '—' %></td>
              <td data-label="Fecha"><%= cuando %></td>
              <td data-label="Cargó"><%= quien %></td>
              <td data-label="Importados"><strong><%= b.imported_rows %></strong></td>
              <td data-label="Con error"><%= b.error_rows %></td>
              <td data-label="Estado">
                <span class="vac-badge <%= b.status === 'reverted' ? 'vac-badge-cancelled' : 'vac-badge-approved' %>">
                  <%= b.status === 'reverted' ? 'Revertida' : 'Aplicada' %>
                </span>
              </td>
              <td data-label="">
                <% if (b.status !== 'reverted') { %>
                  <form
                    class="vac-inline-form"
                    method="POST"
                    action="/RRHH/vacaciones/gestion/historial/importar/<%= b.id %>/revertir"
                    data-confirm="Se quitarán del saldo los <%= b.imported_rows %> registro(s) que cargó este archivo."
                    data-confirm-title="¿Revertir esta importación?"
                    data-confirm-accept="Revertir"
                    data-confirm-tone="peligro"
                  >
                    <button type="submit" class="vac-btn vac-btn-cancel vac-btn-sm">Revertir</button>
                  </form>
                <% } else { %>
                  <span class="vac-nodata">—</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <p class="vac-panel-note">
        Revertir no borra nada físicamente: los registros dejan de contar para
        el saldo y quedan en la bitácora de cada colaborador.
      </p>
    <% } %>
  </div>
</div>
