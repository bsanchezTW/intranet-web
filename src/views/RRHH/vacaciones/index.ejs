<link rel="stylesheet" href="/css/vacaciones.css?v=20260922a">
<link rel="stylesheet" href="/css/procesos.css?v=20260916m">
<link rel="stylesheet" href="/css/rrhh.css?v=20260916g">

<div class="contenedor">
  <div class="page-header">
    <span class="page-header__icono" aria-hidden="true"><%- include('../../partials/icon', { name: 'umbrella' }) %></span>
    <div class="page-header__text">
      <nav class="page-header__migas" aria-label="Ruta de navegación">
        <a href="/RRHH">RRHH</a> <span aria-hidden="true">/</span>
        <span>Vacaciones</span>
      </nav>
      <h2 class="page-title">Vacaciones</h2>
      <p class="page-description">Gestiona tus solicitudes y saldos de vacaciones.</p>
    </div>
  </div>

  <% if (typeof success !== 'undefined' && success) { %>
    <div hidden data-toast="<%= success %>"></div>
  <% } %>
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="flash-msg flash-msg--error" role="alert"><%= error %></div>
  <% } %>

  <div class="procesos-grid">
    <a href="/RRHH/vacaciones/mis-vacaciones" class="procesos-card">
      <span class="procesos-card__tile" aria-hidden="true"><%- include('../../partials/icon', { name: 'umbrella' }) %></span>
      <div class="procesos-card__cuerpo">
        <h4 class="procesos-card__titulo">Mis vacaciones</h4>
        <p class="procesos-card__desc">Consulta tu saldo, solicita días y revisa tu historial.</p>
      </div>
    </a>

    <a href="/RRHH/vacaciones/calendario" class="procesos-card">
      <span class="procesos-card__tile procesos-card__tile--green" aria-hidden="true"><%- include('../../partials/icon', { name: 'calendar' }) %></span>
      <div class="procesos-card__cuerpo">
        <h4 class="procesos-card__titulo">Calendario</h4>
        <p class="procesos-card__desc">Vacaciones aprobadas de todo el equipo, día por día.</p>
      </div>
    </a>

    <% if (locals.canManageRrhh) { %>
      <a href="/RRHH/vacaciones/gestion" class="procesos-card">
        <span class="procesos-card__tile" aria-hidden="true"><%- include('../../partials/icon', { name: 'check-circle' }) %></span>
        <div class="procesos-card__cuerpo">
          <h4 class="procesos-card__titulo">Gestión de solicitudes</h4>
          <p class="procesos-card__desc">Aprueba o rechaza las solicitudes del equipo.</p>
        </div>
      </a>

      <a href="/RRHH/vacaciones/gestion/resumen" class="procesos-card">
        <span class="procesos-card__tile" aria-hidden="true"><%- include('../../partials/icon', { name: 'chart' }) %></span>
        <div class="procesos-card__cuerpo">
          <h4 class="procesos-card__titulo">Resumen y reportes</h4>
          <p class="procesos-card__desc">Saldo de cada colaborador, liquidación y exportación a Excel.</p>
        </div>
      </a>

      <a href="/RRHH/vacaciones/gestion/historial/importar" class="procesos-card">
        <span class="procesos-card__tile" aria-hidden="true"><%- include('../../partials/icon', { name: 'file-spreadsheet' }) %></span>
        <div class="procesos-card__cuerpo">
          <h4 class="procesos-card__titulo">Importar historial</h4>
          <p class="procesos-card__desc">Carga las vacaciones tomadas antes de usar la intranet.</p>
        </div>
      </a>
    <% } %>
  </div>
</div>
