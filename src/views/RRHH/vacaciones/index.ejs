<link rel="stylesheet" href="/css/vacaciones.css?v=20260910n">
<link rel="stylesheet" href="/css/procesos.css?v=20260915a">
<link rel="stylesheet" href="/css/rrhh.css?v=20260729a">

<div class="contenedor">
  <div class="page-header page-header--toolbar">
    <div class="page-header__text">
      <h2 class="page-title">Vacaciones</h2>
      <p class="page-description">
        Gestiona tus solicitudes y saldos de vacaciones.
      </p>
    </div>
    <div class="page-header-actions">
      <a href="/RRHH" class="boton-volver">← Volver a RRHH</a>
    </div>
  </div>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="vac-alert vac-alert-success"><%= success %></div>
  <% } %>
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="vac-alert vac-alert-error"><%= error %></div>
  <% } %>

  <div class="procesos-grid">
    <a href="/RRHH/vacaciones/mis-vacaciones" class="procesos-card">
      <span class="procesos-card__tile" aria-hidden="true"><%- include('../../partials/icon', { name: 'umbrella' }) %></span>
      <div class="procesos-card__cuerpo">
        <h4 class="procesos-card__titulo">Mis vacaciones</h4>
        <p class="procesos-card__desc">Consulta tu saldo, solicita días y revisa tu historial.</p>
      </div>
    </a>

    <a href="/RRHH/vacaciones/calendario" class="procesos-card">
      <span class="procesos-card__tile procesos-card__tile--green" aria-hidden="true"><%- include('../../partials/icon', { name: 'calendar' }) %></span>
      <div class="procesos-card__cuerpo">
        <h4 class="procesos-card__titulo">Calendario</h4>
        <p class="procesos-card__desc">
          <% if (locals.canManageRrhh) { %>Vacaciones del equipo.<% } else { %>Tus vacaciones programadas.<% } %>
        </p>
      </div>
    </a>
  </div>
</div>
