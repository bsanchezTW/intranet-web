<link rel="stylesheet" href="/css/vacaciones.css?v=20260923a">
<%
  const isPeru = country === 'PE';
  // El período del que se van a descontar los próximos días: el más antiguo
  // con saldo. El año en curso no cuenta, todavía se está devengando.
  const peBlockPeriod = isPeru && Array.isArray(periods)
    ? periods
        .filter((p) => !p.inProgress && p.recordMet !== false && Number(p.available) > 0)
        .slice()
        .sort((a, b) => String(a.period_start).localeCompare(String(b.period_start)))[0]
    : null;
%>

<div class="vac-wrap">
  <div class="page-header">
    <span class="page-header__icono" aria-hidden="true"><%- include('../../partials/icon', { name: 'umbrella' }) %></span>
    <div class="page-header__text">
      <nav class="page-header__migas" aria-label="Ruta de navegación">
        <a href="/RRHH">RRHH</a> <span aria-hidden="true">/</span>
        <a href="/RRHH/vacaciones">Vacaciones</a> <span aria-hidden="true">/</span>
        <span>Mis vacaciones</span>
      </nav>
      <h2 class="page-title">Mis vacaciones</h2>
      <p class="page-description">Saldo expresado en <%= dayUnitLabel %>.</p>
    </div>
  </div>

  <% if (typeof success !== 'undefined' && success) { %>
    <div hidden data-toast="<%= success %>"></div>
  <% } %>
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="flash-msg flash-msg--error" role="alert"><%= error %></div>
  <% } %>

  <% if (summary && summary.accumulationAlert) { %>
    <div class="flash-msg flash-msg--info" role="status"><%= summary.accumulationMessage %></div>
  <% } %>

  <% if (!hasHireDate) { %>
    <div class="flash-msg flash-msg--info" role="status">
      No tienes una fecha de ingreso registrada. Contacta a RRHH para poder calcular tu saldo de vacaciones.
    </div>
  <% } %>

  <%# El colaborador ve totales, no el detalle del historial de RR.HH.: los
      días que se tomó antes de la intranet ya están dentro de "Usado". %>
  <div class="vac-balance-grid">
    <div class="vac-stat">
      <div class="vac-stat-label">Saldo disponible</div>
      <div class="vac-stat-value"><%= summary.availableDays %> <span class="vac-stat-unit"><%= dayUnit === 'business' ? 'háb.' : 'cal.' %></span></div>
      <% if (locals.nextAccrualFmt) { %>
        <p class="vac-stat-note">Próximo derecho: <%= nextAccrualFmt %></p>
      <% } %>
    </div>
    <div class="vac-stat vac-stat--quiet">
      <div class="vac-stat-label">Días generados</div>
      <div class="vac-stat-value"><%= summary.generatedDays %></div>
      <p class="vac-stat-note">Por tus años de servicio cumplidos.</p>
    </div>
    <div class="vac-stat vac-stat--quiet">
      <div class="vac-stat-label">Días usados</div>
      <div class="vac-stat-value"><%= summary.totalUsedDays %></div>
      <% if (summary.historicalUsedDays > 0) { %>
        <p class="vac-stat-note">Incluye <%= summary.historicalUsedDays %> día(s) tomados antes de la intranet.</p>
      <% } %>
    </div>
    <% if (peBlockPeriod) { %>
      <div class="vac-stat vac-stat--quiet">
        <div class="vac-stat-label">Días seguidos (de 15)</div>
        <div class="vac-stat-value"><%= peBlockPeriod.protectedBlockRemaining %></div>
      </div>
      <div class="vac-stat vac-stat--quiet">
        <div class="vac-stat-label">Días sueltos (de 15)</div>
        <div class="vac-stat-value"><%= peBlockPeriod.flexibleBlockRemaining %></div>
      </div>
    <% } %>
  </div>

  <% if (isPeru && summary.truncoDays > 0) { %>
    <div class="flash-msg flash-msg--info" role="status">
      Llevas <%= summary.truncoDays %> día(s) acumulados del año en curso.
      Se suman a tu saldo cuando cumplas el año<% if (locals.nextAccrualFmt) { %>, el <%= nextAccrualFmt %><% } %>.
    </div>
  <% } %>

  <%# Sin un año de servicio cumplido no hay días que pedir (art. 10 D.L. 713):
      mejor explicarlo que dejar un formulario que siempre va a rechazar. %>
  <% if (hasHireDate && isPeru && summary.generatedDays === 0) { %>
    <div class="vac-panel">
      <div class="vac-panel-head">Solicitar vacaciones</div>
      <p class="vac-empty">
        Todavía no cumples un año de servicio, así que aún no tienes días para
        pedir.<% if (locals.nextAccrualFmt) { %> Tu primer derecho de 30 días llega el <%= nextAccrualFmt %>.<% } %>
      </p>
    </div>
  <% } %>

  <% if (hasHireDate && !(isPeru && summary.generatedDays === 0)) { %>
  <div class="vac-panel">
    <div class="vac-panel-head">Solicitar vacaciones</div>
    <form class="vac-form" action="/RRHH/vacaciones/mis-vacaciones/solicitar" method="POST" id="vacForm">
      <div class="vac-form-grid-2<%= isPeru ? ' vac-form-grid-3' : '' %>">
        <div class="campo">
          <label for="start_date">Desde *</label>
          <input type="date" id="start_date" name="start_date" required>
        </div>
        <div class="campo">
          <label for="end_date">Hasta *</label>
          <input type="date" id="end_date" name="end_date" required>
        </div>
        <% if (isPeru) { %>
        <div class="campo">
          <label for="days_count">Días</label>
          <input type="number" id="days_count" min="1" step="1" inputmode="numeric">
        </div>
        <% } %>
      </div>
      <div class="vac-preview" id="vacPreview" hidden></div>
      <div class="vac-preview vac-alert-info" id="vacWarnings" hidden></div>
      <div class="campo vac-check-campo" id="fractionAckWrap" hidden>
        <label>
          <input type="checkbox" id="fraction_ack" name="fraction_ack" value="1">
          Confirmo que pido mis vacaciones en partes, no los 30 días seguidos.
        </label>
      </div>
      <div class="campo vac-check-campo" id="policyAckWrap" hidden>
        <label>
          <input type="checkbox" id="policy_warning_ack" name="policy_warning_ack" value="1">
          Entiendo la recomendación y quiero continuar con este tramo corto.
        </label>
      </div>
      <div class="campo">
        <label for="notes">Comentario (opcional)</label>
        <textarea id="notes" name="notes" rows="2" placeholder="Motivo o detalle de la solicitud"></textarea>
      </div>
      <button type="submit" class="vac-btn vac-btn-primary">Enviar solicitud</button>
    </form>
  </div>
  <% } %>

  <div class="vac-panel">
    <div class="vac-panel-head">Períodos de devengo</div>
    <% if (!periods || periods.length === 0) { %>
      <p class="vac-empty">Aún no tienes períodos calculados.</p>
    <% } else { %>
      <table class="vac-table vac-table--stack">
        <thead>
          <tr>
            <th>Período</th><th>Devengado</th><th>Ajuste</th><th>Usado</th><th>Disponible</th>
            <% if (isPeru) { %><th>Seguidos rest.</th><th>Sueltos rest.</th><% } %>
          </tr>
        </thead>
        <tbody>
          <% periods.forEach(p => { %>
            <tr>
              <td data-label="Período">
                <%= p.periodStartFmt %> → <%= p.periodEndFmt %>
                <% if (p.inProgress) { %><br><span class="vac-stat-unit">En curso</span><% } %>
              </td>
              <td data-label="Devengado"><%= p.recordMet === false ? '0 (récord)' : p.entitled %></td>
              <td data-label="Ajuste"><%= p.adjusted %></td>
              <td data-label="Usado"><%= p.totalUsed %></td>
              <td data-label="Disponible">
                <% if (p.inProgress) { %>
                  <span class="vac-nodata">—</span>
                <% } else { %>
                  <strong><%= p.available %></strong>
                <% } %>
              </td>
              <% if (isPeru) { %>
                <td data-label="Seguidos rest."><%= p.protectedBlockRemaining %></td>
                <td data-label="Sueltos rest."><%= p.flexibleBlockRemaining %></td>
              <% } %>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <p class="vac-panel-note">
        Tus días no caducan: si no los usas, se acumulan.
        El período en curso todavía se está ganando, por eso no suma al saldo
        disponible hasta que cumplas el año.
      </p>
    <% } %>
  </div>

  <div class="vac-panel">
    <div class="vac-panel-head">Historial de solicitudes</div>
    <% if (!requests || requests.length === 0) { %>
      <p class="vac-empty">No tienes solicitudes registradas.</p>
    <% } else { %>
      <table class="vac-table vac-table--stack">
        <thead>
          <tr><th>Período</th><th>Días</th><th>Estado</th><th>Revisor</th><th>Notas</th><th></th></tr>
        </thead>
        <tbody>
          <% requests.forEach(r => { %>
            <tr>
              <td data-label="Período"><%= r.startDateFmt %> → <%= r.endDateFmt %></td>
              <td data-label="Días"><%= r.days %> <%= r.dayUnit %></td>
              <td data-label="Estado"><span class="<%= r.statusBadge %>"><%= r.statusLabel %></span></td>
              <td data-label="Revisor"><%= r.reviewerName || '-' %></td>
              <td data-label="Notas"><%= r.reviewer_notes || r.requester_notes || '-' %></td>
              <td data-label="">
                <% if (r.status === 'pending' || r.status === 'approved') { %>
                  <form class="vac-inline-form" action="/RRHH/vacaciones/mis-vacaciones/cancelar/<%= r.id %>" method="POST"
                        data-confirm="La solicitud quedará cancelada."
                        data-confirm-title="¿Cancelar la solicitud?"
                        data-confirm-accept="Cancelar solicitud"
                        data-confirm-cancel="Volver"
                        data-confirm-tone="peligro">
                    <button type="submit" class="vac-btn vac-btn-cancel vac-btn-sm">Cancelar</button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
</div>

<script>
  (function () {
    const startInput = document.getElementById('start_date');
    const endInput = document.getElementById('end_date');
    const daysInput = document.getElementById('days_count');
    const preview = document.getElementById('vacPreview');
    const warningsEl = document.getElementById('vacWarnings');
    const fractionWrap = document.getElementById('fractionAckWrap');
    const fractionAck = document.getElementById('fraction_ack');
    const policyWrap = document.getElementById('policyAckWrap');
    const policyAck = document.getElementById('policy_warning_ack');
    if (!startInput || !endInput || !preview) return;

    let timer = null;
    let syncing = false;

    function addCalendarDays(iso, n) {
      const parts = String(iso).split('-').map(Number);
      if (parts.length !== 3 || parts.some((x) => !Number.isFinite(x))) return null;
      const dt = new Date(Date.UTC(parts[0], parts[1] - 1, parts[2], 12, 0, 0));
      dt.setUTCDate(dt.getUTCDate() + n);
      const y = dt.getUTCFullYear();
      const m = String(dt.getUTCMonth() + 1).padStart(2, '0');
      const d = String(dt.getUTCDate()).padStart(2, '0');
      return y + '-' + m + '-' + d;
    }

    function countCalendarDays(start, end) {
      const a = new Date(start + 'T12:00:00Z');
      const b = new Date(end + 'T12:00:00Z');
      if (Number.isNaN(a.getTime()) || Number.isNaN(b.getTime())) return 0;
      return Math.round((b - a) / 86400000) + 1;
    }

    function formatDisplayDate(iso) {
      const parts = String(iso).split('-');
      if (parts.length !== 3) return iso;
      return parts[2] + '/' + parts[1] + '/' + parts[0];
    }

    function parsedDays() {
      if (!daysInput) return 0;
      const n = parseInt(daysInput.value, 10);
      return Number.isFinite(n) && n >= 1 ? n : 0;
    }

    function setEndFromDays() {
      if (syncing || !daysInput) return;
      const start = startInput.value;
      const n = parsedDays();
      if (!start || n < 1) return;
      const nextEnd = addCalendarDays(start, n - 1);
      if (!nextEnd) return;
      syncing = true;
      endInput.value = nextEnd;
      syncing = false;
    }

    function setDaysFromRange() {
      if (syncing || !daysInput) return;
      const start = startInput.value;
      const end = endInput.value;
      if (!start || !end) return;
      const n = countCalendarDays(start, end);
      if (n < 1) return;
      syncing = true;
      daysInput.value = String(n);
      syncing = false;
    }

    function renderPreviewList(items) {
      preview.textContent = '';
      const ul = document.createElement('ul');
      ul.className = 'vac-preview-list';
      items.forEach((text) => {
        const li = document.createElement('li');
        li.textContent = text;
        ul.appendChild(li);
      });
      preview.appendChild(ul);
    }

    async function updatePreview() {
      const start = startInput.value;
      const end = endInput.value;
      if (!start || !end) {
        preview.hidden = true;
        preview.classList.remove('vac-preview-error');
        if (warningsEl) warningsEl.hidden = true;
        if (fractionWrap) fractionWrap.hidden = true;
        if (policyWrap) policyWrap.hidden = true;
        return;
      }
      try {
        const fractionParam = fractionAck && fractionAck.checked ? '&fraction_ack=1' : '';
        const res = await fetch(
          `/RRHH/vacaciones/api/preview-dias?start_date=${encodeURIComponent(start)}&end_date=${encodeURIComponent(end)}${fractionParam}`,
          { credentials: 'same-origin' },
        );
        if (!res.ok) { preview.hidden = true; return; }
        const data = await res.json();
        if (data.ok) {
          preview.classList.remove('vac-preview-error');
          preview.textContent = `Vas a pedir ${data.days} días, del ${formatDisplayDate(start)} al ${formatDisplayDate(end)}.`;
        } else {
          preview.classList.add('vac-preview-error');
          const errors = (data.errors || []).filter(Boolean);
          if (errors.length) renderPreviewList(errors);
          else preview.textContent = 'No se pudo revisar la solicitud.';
        }
        preview.hidden = false;

        if (warningsEl) {
          if (data.warnings && data.warnings.length) {
            warningsEl.textContent = data.warnings.join(' ');
            warningsEl.hidden = false;
            if (policyWrap) policyWrap.hidden = false;
          } else {
            warningsEl.hidden = true;
            if (policyWrap) policyWrap.hidden = true;
            if (policyAck) policyAck.checked = false;
          }
        }

        if (fractionWrap) {
          fractionWrap.hidden = !data.requiresFractionAck;
          if (!data.requiresFractionAck && fractionAck) fractionAck.checked = false;
        }
      } catch (e) {
        preview.hidden = true;
      }
    }

    function debounced() {
      clearTimeout(timer);
      timer = setTimeout(updatePreview, 250);
    }

    startInput.addEventListener('change', function () {
      if (parsedDays() >= 1) setEndFromDays();
      else setDaysFromRange();
      debounced();
    });
    endInput.addEventListener('change', function () {
      setDaysFromRange();
      debounced();
    });
    if (daysInput) {
      daysInput.addEventListener('input', function () {
        setEndFromDays();
        debounced();
      });
      daysInput.addEventListener('change', function () {
        setEndFromDays();
        debounced();
      });
    }
    if (fractionAck) fractionAck.addEventListener('change', debounced);
  })();
</script>
