<%
/* Marco común de todos los correos (transaccionales y noticias). Tablas +
   estilos en línea: Outlook, Gmail y Apple Mail no respetan CSS externo.
   Ancho 600 px, contenido 536 px. Portada, fecha y subtítulo son opcionales. */
%>
<!--[if mso]><style>body,table,td{font-family:Arial,Helvetica,sans-serif !important;}</style><![endif]-->
<div style="background-color:#eef2f7; margin:0; padding:24px 12px; font-family:'Segoe UI',-apple-system,BlinkMacSystemFont,Helvetica,Arial,sans-serif; -webkit-font-smoothing:antialiased;">
  <div style="display:none; max-height:0; overflow:hidden; opacity:0; color:transparent; height:0; width:0;">
    <%= preheader %>
  </div>

  <table role="presentation" align="center" cellpadding="0" cellspacing="0" border="0" width="600"
         style="max-width:600px; width:100%; margin:0 auto; background-color:#ffffff; border-radius:16px; overflow:hidden; box-shadow:0 2px 8px rgba(13,31,51,0.06), 0 12px 32px rgba(13,31,51,0.08);">
    <tr>
      <td style="background-color:#0f4c81; padding:24px 32px 22px 32px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
          <tr>
            <td align="left" style="vertical-align:middle;">
              <img src="<%= logoUrl %>" alt="Transworld" width="160" height="46"
                   style="width:160px; max-width:160px; height:auto; display:block; border:0; color:#ffffff; font-size:22px; font-weight:700; line-height:46px;">
            </td>
            <td align="right" style="vertical-align:middle;">
              <span style="color:#9cc3ee; font-size:11px; font-weight:700; letter-spacing:1.4px; text-transform:uppercase;"><%= area %></span>
            </td>
          </tr>
        </table>
      </td>
    </tr>
    <tr><td style="background-color:#a6d84a; height:4px; line-height:4px; font-size:0;">&nbsp;</td></tr>

    <% if (cover) { %>
      <tr>
        <td style="padding:0; line-height:0; font-size:0;">
          <% if (cover.href) { %><a href="<%= cover.href %>" target="_blank" style="display:block; text-decoration:none; line-height:0;"><% } %>
            <img src="<%= cover.src %>" alt="<%= cover.alt %>" width="600"
                 style="width:100%; max-width:600px; height:auto; display:block; border:0;">
          <% if (cover.href) { %></a><% } %>
        </td>
      </tr>
    <% } %>

    <% if (heading) { %>
      <tr>
        <td style="padding:<%= cover ? '30px' : '34px' %> 32px 0 32px;">
          <% if (eyebrow) { %>
            <p style="margin:0 0 12px 0; color:#8494a7; font-size:12px; font-weight:700; letter-spacing:1.2px; text-transform:uppercase;">
              <%= eyebrow %>
            </p>
          <% } %>
          <p role="heading" aria-level="1" style="margin:0; color:#0b3a63; font-family:'Segoe UI',-apple-system,BlinkMacSystemFont,Helvetica,Arial,sans-serif; font-size:22px; font-weight:700; line-height:1.3; letter-spacing:0;">
            <%= heading %>
          </p>
          <% if (subheading) { %>
            <p style="margin:12px 0 0 0; color:#51637a; font-size:17px; font-weight:400; line-height:1.55;">
              <%= subheading %>
            </p>
          <% } %>
        </td>
      </tr>
      <tr>
        <td style="padding:22px 32px 0 32px;">
          <div style="border-top:1px solid #e3e9f0; height:1px; line-height:1px; font-size:0;">&nbsp;</div>
        </td>
      </tr>
    <% } %>

    <tr>
      <td style="padding:<%= heading ? '22px' : '34px' %> 32px 6px 32px; color:#334155; font-size:16px; line-height:1.7;">
        <%- bodyHtml %>
      </td>
    </tr>

    <% if (cta && cta.href && cta.label) { %>
      <tr>
        <td align="center" style="padding:18px 32px 36px 32px;">
          <table role="presentation" cellpadding="0" cellspacing="0" border="0">
            <tr>
              <td style="border-radius:10px; background-color:#0f4c81;">
                <a href="<%= cta.href %>" target="_blank"
                   style="display:inline-block; padding:15px 38px; color:#ffffff; font-size:16px; font-weight:700; text-decoration:none; border-radius:10px;">
                  <%= cta.label %>
                </a>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    <% } else { %>
      <tr><td style="padding:0 0 28px 0; font-size:0; line-height:0;">&nbsp;</td></tr>
    <% } %>

    <tr>
      <td style="background-color:#f5f7fa; padding:22px 32px; border-top:1px solid #e3e9f0;" align="center">
        <p style="margin:0 0 6px 0; color:#51637a; font-size:13px; font-weight:700;">
          Transworld Power &amp; Telcom
        </p>
        <p style="margin:0; color:#8494a7; font-size:12px; line-height:1.6;">
          Mensaje automático de la Intranet. No respondas a este correo;
          <br>ingresa a la intranet para continuar.
        </p>
      </td>
    </tr>
  </table>
</div>
