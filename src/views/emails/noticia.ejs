<%
/* Cuerpo del correo de una noticia: texto del artículo y archivos
   renderizados. La cabecera, portada, titular, botón y pie los pone el marco
   común (views/emails/layout.ejs) desde noticiaEmailService.
   Tablas + estilos en línea: contenido de 536 px. */
%>
<% if (contenidoHtml) { %>
  <%- contenidoHtml %>
<% } %>

<% if (adjuntos.length) { %>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;">
    <tr>
      <td style="padding:<%= contenidoHtml ? '10px' : '0' %> 0 0 0;">
        <% adjuntos.forEach(function (adjunto) { %>
          <%- include('partials/_adjunto', { adjunto: adjunto, noticiaUrl: noticiaUrl }) %>
        <% }); %>
      </td>
    </tr>
  </table>
<% } %>
