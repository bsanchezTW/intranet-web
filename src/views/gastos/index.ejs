<%
  const lista = (typeof solicitudes !== 'undefined' && Array.isArray(solicitudes)) ? solicitudes : [];
  const req = (typeof requisitos !== 'undefined' && requisitos) ? requisitos : { ok: false, motivo: null, area: null, manager: null, centros: [] };
  const revisor = (typeof esRevisor !== 'undefined' && esRevisor);
  // El modal sólo existe si el colaborador cumple los requisitos.
  const puedeSolicitar = req.ok && typeof formulario !== 'undefined' && !!formulario;
  // Fondos del colaborador: abiertos, por rendir y rendiciones por liquidar.
  const misFondos = (typeof fondos !== 'undefined' && fondos) ? fondos : null;
  const verFondos = !!misFondos && (misFondos.abiertos.length > 0 || misFondos.porLiquidar.length > 0);

  const borradores = lista.filter((s) => s.status === 'draft').length;
  const enviadas = lista.length - borradores;
  const abiertas = lista.filter((s) => s.status === 'pending' || s.status === 'approved_manager').length;
  const fechaOpts = { year: 'numeric', month: '2-digit', day: '2-digit' };
%>

<div class="contenedor">

  <div class="page-header">
    <span class="page-header__icono" aria-hidden="true"><%- include('../partials/icon', { name: 'wallet' }) %></span>
    <div class="page-header__text">
      <nav class="page-header__migas" aria-label="Ruta de navegación">
        <a href="/procesos">Procesos y documentos</a> <span aria-hidden="true">/</span>
        <span>Finanzas</span>
      </nav>
      <h2 class="page-title">Mis solicitudes</h2>
      <p class="page-description">
        <%= enviadas %> <%= enviadas === 1 ? 'solicitud' : 'solicitudes' %> ·
        <%= abiertas %> en curso
        <% if (borradores) { %> · <%= borradores %> <%= borradores === 1 ? 'borrador' : 'borradores' %><% } %>
        <% if (req.area) { %> · Área <%= req.area.area_name %><% } %>
        <% if (req.centros && req.centros.length) { %>
          · <%= req.centros.map(c => c.code).join(' / ') %>
        <% } %>
      </p>
    </div>

    <div class="page-header-actions">
      <% if (revisor) { %>
        <a href="/gastos/gestion" class="page-header-btn page-header-btn--secundario"><%- include('../partials/icon', { name: 'check-circle' }) %> Gestión de solicitudes</a>
      <% } %>
    </div>
  </div>

  <% if (typeof success !== 'undefined' && success) { %>
    <div hidden data-toast="<%= success %>"></div>
  <% } %>
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="flash-msg flash-msg--error" role="alert">
      <span class="flash-msg__icono" aria-hidden="true"><%- include('../partials/icon', { name: 'alert-triangle' }) %></span>
      <span><%= error %></span>
    </div>
  <% } %>

  <% if (verFondos) { %>
  <section class="seccion" aria-labelledby="gastos-fondos">
    <div class="seccion__head">
      <div class="seccion__heading">
        <h3 class="seccion__title" id="gastos-fondos">
          <span class="seccion__icon" aria-hidden="true"><%- include('../partials/icon', { name: 'banknote' }) %></span>
          Mis fondos
        </h3>
      </div>
    </div>

    <div class="fondos-card">
      <div class="fondos-resumen">
        <div class="fondos-resumen__dato">
          <span class="fondos-resumen__label">Asignado por rendir</span>
          <strong><%= formatMoney(misFondos.asignadoPorRendir) %></strong>
        </div>
        <div class="fondos-resumen__dato">
          <span class="fondos-resumen__label">Fondos abiertos</span>
          <strong><%= misFondos.usados %>/<%= misFondos.max %></strong>
        </div>
      </div>

      <ul class="fondos-lista">
        <% misFondos.abiertos.forEach((f) => { %>
          <li class="fondos-fila<%= f.overdue ? ' fondos-fila--vencida' : '' %>">
            <a class="fondos-fila__info" href="/gastos/<%= f.id %>">
              <span class="gasto-item__id">#<%= f.id %></span>
              <span class="fondos-fila__titulo"><%= f.title %></span>
            </a>
            <span class="fondos-fila__monto"><%= formatMoney(f.total_amount) %></span>
            <span class="fondo-estado fondo-estado--<%= f.overdue ? 'vencido' : f.state %>">
              <%= f.overdue ? 'Plazo vencido' : f.stateLabel %>
            </span>
            <% if (f.state === 'por_rendir' && puedeSolicitar) { %>
              <button type="button" class="fondos-fila__rendir" data-abrir-gasto="rendicion" data-fondo="<%= f.id %>">Rendir</button>
            <% } %>
            <% if (f.reportDueOn && f.state === 'por_rendir') { %>
              <p class="fondos-fila__plazo">
                <% if (f.overdue) { %>
                  Debiste rendir hasta el <%= formatExpenseDate(f.reportDueOn) %>.
                <% } else { %>
                  Rinde hasta el <%= formatExpenseDate(f.reportDueOn) %>.
                <% } %>
              </p>
            <% } %>
          </li>
        <% }) %>
        <% misFondos.porLiquidar.forEach((r) => { %>
          <li class="fondos-fila fondos-fila--liquidar">
            <a class="fondos-fila__info" href="/gastos/<%= r.id %>">
              <span class="gasto-item__id">#<%= r.id %></span>
              <span class="fondos-fila__titulo"><%= r.title %></span>
            </a>
            <span class="fondos-fila__saldo fondos-fila__saldo--<%= r.balance.sentido %>">
              <%= r.balance.sentido === 'devolver' ? 'Debes devolver' : 'Te pagaremos' %>
              <strong><%= formatMoney(r.balance.monto) %></strong>
            </span>
          </li>
        <% }) %>
      </ul>
    </div>
  </section>
  <% } %>

  <section class="seccion" aria-labelledby="gastos-nueva">
    <div class="seccion__head">
      <div class="seccion__heading">
        <h3 class="seccion__title" id="gastos-nueva">
          <span class="seccion__icon" aria-hidden="true"><%- include('../partials/icon', { name: 'wallet' }) %></span>
          Nueva solicitud
        </h3>
        <p class="seccion__desc">
          <% if (puedeSolicitar) { %>
            Aprueba primero <strong><%= req.manager.name %></strong>, y después Finanzas.
          <% } else { %>
            Todavía falta un requisito para poder rendir.
          <% } %>
        </p>
      </div>
    </div>

    <% if (puedeSolicitar) { %>
      <%# Los href quedan como respaldo sin JS; gastos-form.js abre el modal. %>
      <div class="procesos-grid">
        <a href="/gastos/nueva/rendicion" class="procesos-card" data-abrir-gasto="rendicion">
          <span class="procesos-card__tile" aria-hidden="true"><%- include('../partials/icon', { name: 'receipt' }) %></span>
          <div class="procesos-card__cuerpo">
            <h4 class="procesos-card__titulo">Rendir gastos</h4>
            <p class="procesos-card__desc">Gastos o compras que ya pagaste, con sus comprobantes.</p>
            <% if (misFondos && misFondos.vencidos) { %>
              <span class="procesos-card__meta">
                <span class="procesos-card__badge procesos-card__badge--alerta">
                  <%= misFondos.vencidos %> <%= misFondos.vencidos === 1 ? 'fondo sin rendir' : 'fondos sin rendir' %>
                </span>
              </span>
            <% } %>
          </div>
        </a>
        <% if (misFondos && misFondos.lleno) { %>
          <%# Cupo lleno: la acción existe pero no se puede ejercer hasta rendir un fondo. %>
          <div class="procesos-card procesos-card--bloqueada" aria-disabled="true">
            <span class="procesos-card__tile procesos-card__tile--green" aria-hidden="true"><%- include('../partials/icon', { name: 'banknote' }) %></span>
            <div class="procesos-card__cuerpo">
              <h4 class="procesos-card__titulo">Solicitar fondos</h4>
              <p class="procesos-card__desc">Tienes <%= misFondos.max %> solicitudes de fondos sin cerrar. Rinde una para liberar cupo.</p>
              <span class="procesos-card__meta"><span class="procesos-card__badge procesos-card__badge--alerta"><%= misFondos.usados %>/<%= misFondos.max %></span></span>
            </div>
          </div>
        <% } else { %>
        <a href="/gastos/nueva/fondos" class="procesos-card" data-abrir-gasto="fondos">
          <span class="procesos-card__tile procesos-card__tile--green" aria-hidden="true"><%- include('../partials/icon', { name: 'banknote' }) %></span>
          <div class="procesos-card__cuerpo">
            <h4 class="procesos-card__titulo">Solicitar fondos</h4>
            <p class="procesos-card__desc">Dinero por adelantado para una compra o gestión.</p>
          </div>
        </a>
        <% } %>
      </div>
    <% } else { %>
      <div class="procesos-aviso">
        <span class="procesos-aviso__icono" aria-hidden="true"><%- include('../partials/icon', { name: 'info' }) %></span>
        <span>
          <%= req.motivo %>
          <% if (req.arreglarEn) { %>
            <a href="<%= req.arreglarEn %>">Ir a mi perfil →</a>
          <% } %>
        </span>
      </div>
    <% } %>
  </section>

  <section class="seccion" aria-labelledby="gastos-historial">
    <div class="seccion__head">
      <div class="seccion__heading">
        <h3 class="seccion__title" id="gastos-historial">
          <span class="seccion__icon" aria-hidden="true"><%- include('../partials/icon', { name: 'clipboard' }) %></span>
          Historial
        </h3>
        <p class="seccion__desc">Tus solicitudes y borradores.</p>
      </div>
    </div>

    <div class="gastos-panel">
      <% if (lista.length) { %>
      <div class="gastos-toolbar">
        <div class="gastos-buscar">
          <span class="gastos-buscar__icono" aria-hidden="true"><%- include('../partials/icon', { name: 'search' }) %></span>
          <label class="sr-only" for="gastosBuscar">Buscar solicitudes</label>
          <input type="search" id="gastosBuscar" class="gastos-buscar__input" data-gastos-buscar
                 placeholder="Buscar por asunto o número…" autocomplete="off">
        </div>
        <div class="gastos-chips" role="group" aria-label="Filtrar por estado">
          <button type="button" class="gastos-chip is-active" data-filtro-estado="activos">En curso</button>
          <% if (borradores) { %>
            <button type="button" class="gastos-chip" data-filtro-estado="draft">Borradores</button>
          <% } %>
          <button type="button" class="gastos-chip" data-filtro-estado="approved_finance">Aprobadas</button>
          <button type="button" class="gastos-chip" data-filtro-estado="rejected">Rechazadas</button>
          <button type="button" class="gastos-chip" data-filtro-estado="cancelled">Anuladas</button>
          <button type="button" class="gastos-chip" data-filtro-estado="todos">Todas</button>
        </div>
      </div>
      <% } %>

      <ul class="gastos-lista" data-gastos-lista>
        <% lista.forEach((s) => {
             const esBorrador = s.status === 'draft';
             const fechaRef = esBorrador ? (s.updated_at || s.created_at) : s.created_at;
             const fecha = fechaRef ? new Date(fechaRef).toLocaleDateString(countryConfig.locale, fechaOpts) : '—';
             const buscable = [s.title, String(s.id), expenseKindLabel(s.kind), esBorrador ? 'borrador' : '', s.status === 'cancelled' ? 'anulada' : '']
               .filter(Boolean).join(' ').toLowerCase();
        %>
          <li class="gasto-item" data-estado="<%= s.status %>" data-buscar="<%= buscable %>">
            <%# Un borrador no tiene detalle: se retoma en el modal. %>
            <a class="gasto-item__link"
               href="<%= esBorrador ? '/gastos?borrador=' + s.id : '/gastos/' + s.id %>"
               <% if (esBorrador) { %>data-abrir-borrador="<%= s.id %>"<% } %>>
              <span class="gasto-item__main">
                <span class="gasto-item__top">
                  <span class="gasto-item__id">#<%= s.id %></span>
                  <span class="gasto-item__titulo"><%= s.title || 'Sin asunto' %></span>
                </span>
                <span class="gasto-item__meta">
                  <span><%= expenseKindLabel(s.kind) %></span>
                  <span><%= esBorrador ? 'Guardado el' : 'Enviada el' %> <%= fecha %></span>
                  <% if (esBorrador && fechaRef && typeof diasBorrador !== 'undefined') {
                       const restantes = Math.max(0, diasBorrador - Math.floor((Date.now() - new Date(fechaRef).getTime()) / 86400000));
                  %>
                    <span><%= restantes === 0 ? 'Se elimina hoy' : 'Se elimina en ' + restantes + (restantes === 1 ? ' día' : ' días') %></span>
                  <% } %>
                  <span><%= s.item_count %> <%= s.item_count === 1 ? 'ítem' : 'ítems' %></span>
                  <% if (s.attachment_count > 0) { %>
                    <span><%= s.attachment_count %> <%= s.attachment_count === 1 ? 'adjunto' : 'adjuntos' %></span>
                  <% } %>
                </span>
              </span>

              <span class="gasto-item__lado">
                <span class="gasto-item__monto"><%= formatMoney(s.total_amount) %></span>
                <span class="<%= expenseStatusBadge(s.status) %>"><%= expenseStatusLabel(s.status) %></span>
              </span>

              <span class="gasto-item__chevron" aria-hidden="true"><%- include('../partials/icon', { name: 'chevron-right' }) %></span>
            </a>
          </li>
        <% }) %>
      </ul>

      <p class="gastos-vacio" data-gastos-vacio hidden>No hay solicitudes que coincidan con el filtro.</p>

      <% if (!lista.length) { %>
        <p class="gastos-vacio">Todavía no has enviado ninguna solicitud.</p>
      <% } %>
    </div>
  </section>

</div>

<% if (puedeSolicitar) { %>
  <%- include('partials/formulario_modal') %>
<% } %>
