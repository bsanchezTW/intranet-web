<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('partials/theme-head') %>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= formatPageTitle(titulo) %></title>
    <link rel="stylesheet" href="/css/intranet.css?v=20260917i">
    <link rel="stylesheet" href="/css/shell.css?v=20260917b">
    <link rel="stylesheet" href="/css/modal.css?v=20260917r">
    <% if (features.supportTickets) { %>
    <link rel="stylesheet" href="/css/ticket-modal.css?v=20260916m">
    <% } %>
    <% if (typeof extraCss !== 'undefined' && Array.isArray(extraCss)) { %>
      <% extraCss.forEach((href) => { %>
        <link rel="stylesheet" href="<%= href %>">
      <% }) %>
    <% } %>
    <link rel="stylesheet" href="/css/home.css?v=20260916m">
    <% if (typeof usuario !== 'undefined' && usuario && features.claudeAssistant) { %>
    <link rel="stylesheet" href="/css/claude-assistant.css?v=20260917v">
    <% } %>
    <script>
      // Sin defer y en el head: la clase se pone en cuanto el documento está
      // listo, sin esperar a las imágenes. Los dos respaldos —load y el
      // temporizador— existen para que un recurso atascado no deje la página
      // tapada para siempre.
      (function () {
        var raiz = document.documentElement;
        function listo() { raiz.classList.add('pagina-lista'); }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', listo);
        } else {
          listo();
        }
        window.addEventListener('load', listo);
        window.setTimeout(listo, 8000);
        // Al volver con el botón atrás la página llega desde la caché ya
        // pintada: el velo no debe reaparecer.
        window.addEventListener('pageshow', listo);
      })();
    </script>
    <noscript><style>.cargando-pagina { display: none; }</style></noscript>
    <script src="/js/modal.js?v=20260917r" defer></script>
    <script src="/js/toast.js?v=20260917b" defer></script>
    <% if (features.supportTickets) { %>
    <script src="/js/ticket-create-form.js?v=20260917r" defer></script>
    <script src="/js/ticket-detail.js?v=20260917r" defer></script>
    <% } %>
</head>

<body>

  <div class="cargando-pagina" role="status">
    <span class="cargando-pagina__spinner" aria-hidden="true"></span>
    <span class="sr-only">Cargando…</span>
  </div>

  <% 
    const currentUser = (typeof usuario !== 'undefined' && usuario) ?
    usuario : ((typeof user !== 'undefined' && user) ? user : null);
    let displayName = 'Usuario';
    if (currentUser) {
      if (currentUser.nombre) displayName = currentUser.nombre;
      else if (currentUser.first_name) displayName = currentUser.first_name + (currentUser.last_name ? ' ' + currentUser.last_name : '');
      else if (currentUser.name) displayName = currentUser.name;
      else if (currentUser.username) displayName = currentUser.username;
    }
    const monogram = currentUser ? getMonogram(currentUser) : null;
  %>

<%- include('partials/navbar', { currentUser, displayName, monogram }) %>

<main>
    <div class="contenedor-principal">
        <%- body %>
    </div>
</main>

<% if (currentUser && features.supportTickets) { %>
  <%- include('partials/modal', {
    id: 'modalNuevoTicketNavbar',
    titleId: 'ticket-modal-title',
    title: 'Abrir Nuevo Ticket de Soporte',
    overlayClass: 'modal-ticket-navbar',
    panelClass: 'modal-ticket-navbar-content modal-ticket-create-content',
    titleClass: 'ticket-modal-title ticket-modal-title--sr',
    closeLabel: 'Cerrar modal de ticket',
    body: include('partials/ticket-create-modal-content', { currentUser, displayName })
  }) %>
<% } %>

<%- include('partials/footer', { currentUser }) %>

<% if (currentUser && features.claudeAssistant) { %>
  <%- include('partials/claude-assistant', { displayName }) %>
  <script src="https://cdn.jsdelivr.net/npm/marked@12.0.2/marked.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/dompurify@3.0.11/dist/purify.min.js"></script>
  <script src="/js/claude-assistant.js?v=20260922c"></script>
<% } %>

<% if (typeof extraJs !== 'undefined' && Array.isArray(extraJs)) { %>
  <% extraJs.forEach((src) => { %>
    <script src="<%= src %>" defer></script>
  <% }) %>
<% } %>

<script>
  document.addEventListener('DOMContentLoaded', async function() {

    // --- ESTADO ACTIVO DE LA NAVEGACIÓN ---
    (function markActiveNav() {
      const path = window.location.pathname.toLowerCase();
      function mejorCoincidencia(links, leerHref) {
        let best = null;
        let bestLen = 0;
        links.forEach((el) => {
          let href;
          try { href = new URL(leerHref(el), window.location.origin).pathname.toLowerCase(); }
          catch (e) { return; }
          const coincide = href === '/' ? path === '/' : (path === href || path.startsWith(href + '/'));
          if (coincide && href.length > bestLen) {
            best = el;
            bestLen = href.length;
          }
        });
        return best;
      }
      const escritorio = mejorCoincidencia(
        document.querySelectorAll('.main-nav .nav-link'), (a) => a.getAttribute('href'));
      if (escritorio) {
        escritorio.classList.add('is-active');
        escritorio.setAttribute('aria-current', 'page');
      }
      const movil = mejorCoincidencia(
        document.querySelectorAll('.mobile-sidebar [data-nav-href]'), (el) => el.getAttribute('data-nav-href'));
      if (movil) movil.classList.add('is-active');
    })();

    // --- MENÚ LATERAL MÓVIL ---
    const menuToggle = document.getElementById('menu-toggle');
    const closeMenu = document.getElementById('close-menu');
    const mobileSidebar = document.getElementById('mobile-sidebar');
    const mobileOverlay = document.getElementById('mobile-overlay');

    function setMenu(abrir) {
      if (!mobileSidebar) return;
      const estaAbierto = mobileSidebar.classList.contains('open');
      if (abrir === estaAbierto) return;
      mobileSidebar.classList.toggle('open', abrir);
      mobileSidebar.setAttribute('aria-hidden', abrir ? 'false' : 'true');
      mobileOverlay.hidden = false;
      requestAnimationFrame(() => mobileOverlay.classList.toggle('open', abrir));
      if (!abrir) setTimeout(() => { if (!mobileSidebar.classList.contains('open')) mobileOverlay.hidden = true; }, 350);
      menuToggle.setAttribute('aria-expanded', abrir ? 'true' : 'false');
      document.body.classList.toggle('menu-movil-abierto', abrir);
      if (window.IntranetModal) {
        if (abrir) window.IntranetModal.lockScroll(); else window.IntranetModal.unlockScroll();
      }
      if (abrir) closeMenu.focus({ preventScroll: true });
      else menuToggle.focus({ preventScroll: true });
    }

    if (menuToggle && mobileSidebar) {
      menuToggle.addEventListener('click', () => setMenu(true));
      closeMenu.addEventListener('click', () => setMenu(false));
      mobileOverlay.addEventListener('click', () => setMenu(false));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && mobileSidebar.classList.contains('open')) setMenu(false);
      });
      // Si la ventana crece hasta mostrar la barra completa, el menú lateral sobra.
      window.matchMedia('(min-width: 1300px)').addEventListener('change', (e) => {
        if (e.matches) setMenu(false);
      });
    }

    // --- SUBMENÚS DESPLEGABLES (MÓVIL) ---
    document.querySelectorAll('.mobile-sidebar .submenu-toggle').forEach((toggle) => {
      toggle.addEventListener('click', function () {
        const abrir = this.getAttribute('aria-expanded') !== 'true';
        this.setAttribute('aria-expanded', abrir ? 'true' : 'false');
        this.classList.toggle('active', abrir);
        const submenu = this.nextElementSibling;
        if (submenu && submenu.classList.contains('sub-menu')) submenu.classList.toggle('open', abrir);
      });
    });

    // --- MENÚ DE USUARIO EN NAVBAR ---
    const userMenus = document.querySelectorAll('.nav-user-menu');

    function closeUserMenus(exceptMenu) {
      userMenus.forEach((menu) => {
        if (menu === exceptMenu) return;
        menu.classList.remove('is-open');
        const trigger = menu.querySelector('.nav-user-trigger');
        if (trigger) trigger.setAttribute('aria-expanded', 'false');
      });
    }

    userMenus.forEach((menu) => {
      const trigger = menu.querySelector('.nav-user-trigger');
      if (!trigger) return;

      trigger.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        const willOpen = !menu.classList.contains('is-open');
        closeUserMenus(menu);
        menu.classList.toggle('is-open', willOpen);
        trigger.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
      });
    });

    document.addEventListener('click', () => closeUserMenus());
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeUserMenus();
    });


    // --- AVISO DE ÉXITO (?ok=...) ---
    const urlParams = new URLSearchParams(window.location.search);
    const okMsg = urlParams.get('ok');
    const flashMsg = urlParams.get('msg');
    // ok=1&msg=... lo maneja la vista (p. ej. listado de personal); evita toast duplicado.
    // Claves tipo correo_enviado las traduce la propia página (nt-aviso), no el toast.
    const okEsClave = okMsg && /_/.test(okMsg);
    if (okMsg && !okEsClave && !(okMsg === '1' && flashMsg) && window.IntranetToast) {
      // URLSearchParams ya decodifica %20 y "+" como espacios.
      window.IntranetToast.show(okMsg);
      urlParams.delete('ok');
      const resto = urlParams.toString();
      window.history.replaceState({}, document.title, window.location.pathname + (resto ? '?' + resto : '') + window.location.hash);
    }

    <% if (features.supportTickets) { %>
    // --- BURBUJA DE NOTIFICACIONES ---
    function renderTicketBadges(count) {
      const btnsTicket = document.querySelectorAll('.ticket-notif-target');
      btnsTicket.forEach(btn => {
        btn.querySelectorAll('.badge-notif').forEach(badge => badge.remove());

        if (count > 0) {
          const badge = document.createElement('span');
          badge.className = 'badge-notif';
          badge.innerText = count > 99 ? '99+' : count;
          btn.appendChild(badge);
        }
      });
    }

    async function refreshTicketNotifications() {
      if (document.hidden) return;

      try {
        const res = await fetch('/soporte/tickets/notificaciones/count', {
          cache: 'no-store',
          headers: { 'Accept': 'application/json' }
        });
        const data = await res.json();
        renderTicketBadges(Number(data.count) || 0);
      } catch (error) {
        console.error('Error al cargar notificaciones de tickets:', error);
      }
    }

    refreshTicketNotifications();
    setInterval(refreshTicketNotifications, 30000);
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) refreshTicketNotifications();
    });
    <% } %>

  });
</script>

</body>
</html>
