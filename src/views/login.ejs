  <script>
    function toggleVisibility(inputId, btn) {
      const input = document.getElementById(inputId);
      const isHidden = input.type === 'password';
      input.type = isHidden ? 'text' : 'password';
      btn.innerHTML = isHidden
        ? '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>'
        : '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>';
    }

    (function initAuthShell() {
      const stage = document.getElementById('loginAuthStage');
      if (!stage) return;

      const FADE_MS = 280;
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const split = document.querySelector('.login-split');
      const formPanel = document.querySelector('.login-split__form-panel');
      const brand = document.getElementById('loginAuthBrand');
      const heading = document.getElementById('loginAuthHeading');
      const subheading = document.getElementById('loginAuthSubheading');
      const help = document.getElementById('loginAuthHelp');
      const errorEl = document.getElementById('loginAuthError');
      const infoEl = document.getElementById('loginAuthInfo');

      const PATH_TO_VIEW = {
        '/login': 'login',
        '/register': 'register',
        '/forgot-password': 'forgot',
        '/verify-email': 'verify',
        '/reset-password': 'reset'
      };

      const VIEW_META = {
        login: {
          path: '/login',
          title: 'Iniciar sesión',
          heading: 'Acceso a la Intranet',
          subheading: 'Bienvenido a tu Portal de Transworld <%= countryConfig.name %>'
        },
        register: {
          path: '/register',
          title: 'Registro',
          heading: 'Crear cuenta',
          subheading: 'Completa tus datos para unirte a la intranet'
        },
        forgot: {
          path: '/forgot-password',
          title: 'Recuperar contraseña',
          heading: 'Recuperar contraseña',
          subheading: 'Ingresa tu correo corporativo y te enviaremos una contraseña temporal'
        },
        verify: {
          path: '/verify-email',
          title: 'Verificar correo',
          heading: 'Verificar correo',
          subheading: 'Enviamos un código de 6 dígitos a tu correo. Ingrésalo para activar tu cuenta.'
        },
        reset: {
          path: '/reset-password',
          title: 'Crear nueva contraseña',
          heading: 'Crear nueva contraseña',
          subheading: 'Por seguridad, debes cambiar tu contraseña temporal antes de continuar'
        }
      };

      const SPA_VIEWS = new Set(['login', 'register', 'forgot']);
      const AUTH_ROUTES = new Set(Object.keys(PATH_TO_VIEW));

      const INFO_BY_QUERY = {
        confirmed: 'Correo verificado correctamente. Ya puedes iniciar sesión.',
        pending: 'Debes verificar tu correo con el código de 6 dígitos antes de ingresar.',
        exists: 'Ese correo ya está registrado. Inicia sesión.',
        reset: 'Se ha enviado una nueva contraseña a tu correo.',
        changed: 'Contraseña actualizada correctamente. Ingresa con tu correo y nueva contraseña.'
      };

      let currentView = document.querySelector('.login-view:not([hidden])')?.dataset.view
        || PATH_TO_VIEW[normalizePath(window.location.pathname)]
        || 'login';
      let transitioning = false;

      function normalizePath(pathname) {
        const path = String(pathname || '').replace(/\/$/, '');
        return path || '/login';
      }

      function markShellReady() {
        try { sessionStorage.setItem('loginShellReady', '1'); } catch (_) {}
        document.documentElement.classList.add('login-shell-settled');
      }

      function fadeIn() {
        stage.classList.remove('login-auth-stage--exit');
        if (reducedMotion || document.documentElement.classList.contains('login-shell-settled')) {
          stage.classList.add('login-auth-stage--ready');
          markShellReady();
          return;
        }
        requestAnimationFrame(function () {
          requestAnimationFrame(function () {
            stage.classList.add('login-auth-stage--ready');
            window.setTimeout(markShellReady, 450);
          });
        });
      }

      function setAlert(el, message) {
        if (!el) return;
        const text = String(message || '').trim();
        if (!text) {
          el.hidden = true;
          el.textContent = '';
          return;
        }
        el.textContent = text;
        el.hidden = false;
      }

      function clearAlerts() {
        setAlert(errorEl, '');
        setAlert(infoEl, '');
      }

      function infoFromSearch(search) {
        const params = new URLSearchParams(search || '');
        for (const key of Object.keys(INFO_BY_QUERY)) {
          if (params.get(key) === '1') return INFO_BY_QUERY[key];
        }
        return null;
      }

      function applyViewChrome(view, options) {
        const meta = VIEW_META[view] || VIEW_META.login;
        if (heading) heading.textContent = meta.heading;
        if (subheading) subheading.textContent = meta.subheading;
        document.title = meta.title + ' | <%= countryConfig.pageTitleSuffix %>';

        const isRegister = view === 'register';
        if (split) split.classList.toggle('login-split--register', isRegister);
        if (formPanel) formPanel.classList.toggle('login-split__form-panel--register', isRegister);
        if (brand) brand.hidden = isRegister;
        if (help) help.hidden = !(view === 'login' || view === 'forgot');

        if (options && Object.prototype.hasOwnProperty.call(options, 'error')) {
          setAlert(errorEl, options.error);
        }
        if (options && Object.prototype.hasOwnProperty.call(options, 'info')) {
          setAlert(infoEl, options.info);
        }
      }

      function focusFirstField(view) {
        const panel = document.querySelector('.login-view[data-view="' + view + '"]');
        if (!panel) return;
        const field = panel.querySelector('input:not([type="hidden"]):not([disabled]), select, textarea');
        if (field) {
          try { field.focus({ preventScroll: true }); } catch (_) { field.focus(); }
        }
      }

      function showView(view, options) {
        options = options || {};
        const panel = document.querySelector('.login-view[data-view="' + view + '"]');
        if (!panel) return false;

        document.querySelectorAll('.login-view').forEach(function (el) {
          el.hidden = el !== panel;
        });

        currentView = view;
        applyViewChrome(view, options);

        if (options.push !== false) {
          const url = new URL((VIEW_META[view] || VIEW_META.login).path, window.location.origin);
          if (options.search) url.search = options.search;
          const next = url.pathname + url.search;
          const curr = window.location.pathname + window.location.search;
          if (next !== curr) {
            history.pushState({ authView: view }, '', next);
          } else {
            history.replaceState({ authView: view }, '', next);
          }
        }

        focusFirstField(view);
        return true;
      }

      function navigateWithFade(url) {
        if (reducedMotion) {
          window.location.href = url;
          return;
        }
        stage.classList.remove('login-auth-stage--ready');
        stage.classList.add('login-auth-stage--exit');
        window.setTimeout(function () {
          window.location.href = url;
        }, FADE_MS);
      }

      function switchView(view, options) {
        options = options || {};
        if (!SPA_VIEWS.has(view)) {
          navigateWithFade((VIEW_META[view] || VIEW_META.login).path + (options.search || ''));
          return;
        }
        if (transitioning) return;
        if (view === currentView && !options.force && !options.error && !options.info) {
          if (options.search != null) {
            showView(view, options);
          }
          return;
        }

        if (reducedMotion) {
          showView(view, options);
          return;
        }

        transitioning = true;
        stage.classList.remove('login-auth-stage--ready');
        stage.classList.add('login-auth-stage--exit');

        window.setTimeout(function () {
          showView(view, options);
          stage.classList.remove('login-auth-stage--exit');
          requestAnimationFrame(function () {
            requestAnimationFrame(function () {
              stage.classList.add('login-auth-stage--ready');
              transitioning = false;
            });
          });
        }, FADE_MS);
      }

      window.__loginSwitchView = switchView;
      window.__loginSetAlerts = function (payload) {
        if (!payload) {
          clearAlerts();
          return;
        }
        if (Object.prototype.hasOwnProperty.call(payload, 'error')) setAlert(errorEl, payload.error);
        if (Object.prototype.hasOwnProperty.call(payload, 'info')) setAlert(infoEl, payload.info);
      };

      fadeIn();

      document.addEventListener('click', function (e) {
        const link = e.target.closest('a[href]');
        if (!link) return;
        if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        if (link.target && link.target !== '_self') return;

        let url;
        try {
          url = new URL(link.href, window.location.href);
        } catch (_) {
          return;
        }

        if (url.origin !== window.location.origin) return;
        const path = normalizePath(url.pathname);
        if (!AUTH_ROUTES.has(path)) return;

        const view = PATH_TO_VIEW[path];
        if (!view) return;

        e.preventDefault();

        if (!SPA_VIEWS.has(view)) {
          navigateWithFade(url.pathname + url.search);
          return;
        }

        const info = infoFromSearch(url.search);
        switchView(view, {
          search: url.search,
          info: info,
          error: '',
          force: true
        });
      });

      window.addEventListener('popstate', function () {
        const path = normalizePath(window.location.pathname);
        const view = PATH_TO_VIEW[path];
        if (!view || !SPA_VIEWS.has(view)) {
          window.location.reload();
          return;
        }
        switchView(view, {
          push: false,
          search: window.location.search,
          info: infoFromSearch(window.location.search),
          error: '',
          force: true
        });
      });

      // Login / recuperar: POST nativo (urlencoded). El fetch+FormData
      // enviaba multipart y Express dejaba req.body vacío.
    })();

    (function initLoginCarousel() {
      const slides = document.querySelectorAll('.login-carousel__slide');
      const dots = document.querySelectorAll('.login-carousel__dot');
      if (!slides.length) return;
      let current = 0;
      let timer = null;
      const INTERVAL = 6000;

      function showSlide(index) {
        current = (index + slides.length) % slides.length;
        slides.forEach((s, i) => s.classList.toggle('is-active', i === current));
        dots.forEach((d, i) => {
          d.classList.toggle('is-active', i === current);
          d.setAttribute('aria-selected', i === current ? 'true' : 'false');
        });
      }

      function nextSlide() {
        showSlide(current + 1);
      }

      function startAutoplay() {
        if (timer) clearInterval(timer);
        timer = setInterval(nextSlide, INTERVAL);
      }

      dots.forEach((dot, i) => {
        dot.addEventListener('click', () => {
          showSlide(i);
          startAutoplay();
        });
      });

      startAutoplay();
    })();

    (function initVerifyCode() {
      const codeInput = document.getElementById('verify-code');
      if (!codeInput) return;
      codeInput.addEventListener('input', function () {
        this.value = this.value.replace(/\D/g, '').slice(0, 6);
      });
    })();

    (function initResetPasswordMatch() {
      const p1 = document.getElementById('reset-password');
      const p2 = document.getElementById('reset-password2');
      const msg = document.getElementById('reset-match-msg');
      const strengthBox = document.getElementById('reset-password-strength');
      const submitBtn = document.getElementById('reset-submit-btn');
      if (!p1 || !p2 || !msg) return;

      // Misma política que el registro: /js/password-strength.js se carga más
      // abajo, así que sólo se consulta dentro de los handlers.
      function update() {
        PasswordStrength.renderMeter(strengthBox, p1.value);
        const strongEnough = PasswordStrength.isPasswordStrongEnough(p1.value);
        const match = p2.value.length > 0 && p1.value === p2.value;

        if (submitBtn) {
          submitBtn.disabled = !(strongEnough && match);
          submitBtn.setAttribute('aria-disabled', strongEnough && match ? 'false' : 'true');
        }

        if (!p2.value.length) {
          msg.hidden = true;
          msg.textContent = '';
          return;
        }
        msg.hidden = false;
        if (match) {
          msg.textContent = 'Las contraseñas coinciden';
          msg.className = 'login-password-match ok';
        } else {
          msg.textContent = 'Las contraseñas no coinciden';
          msg.className = 'login-password-match bad';
        }
      }

      p1.addEventListener('input', update);
      p2.addEventListener('input', update);
      document.addEventListener('DOMContentLoaded', update);
    })();

    (function initLoginTabOrder() {
      const usernameInput = document.getElementById('login-username');
      const passwordInput = document.getElementById('login-password');
      if (!usernameInput || !passwordInput) return;

      usernameInput.addEventListener('keydown', function (e) {
        if (e.key === 'Tab' && !e.shiftKey) {
          e.preventDefault();
          passwordInput.focus();
        }
      });
    })();

    (function initLoginPasswordCapsHint() {
      const passwordInput = document.getElementById('login-password');
      const hint = document.getElementById('login-password-caps-hint');
      if (!passwordInput || !hint) return;

      let capsLockOn = false;

      function syncCapsState(event) {
        if (event && typeof event.getModifierState === 'function') {
          capsLockOn = event.getModifierState('CapsLock');
        }
        if (document.activeElement === passwordInput) {
          updateHint();
        }
      }

      function updateHint() {
        const isFocused = document.activeElement === passwordInput;
        hint.hidden = !(isFocused && capsLockOn);
      }

      function onInteraction(event) {
        syncCapsState(event);
        updateHint();
      }

      document.addEventListener('keydown', syncCapsState, true);
      document.addEventListener('keyup', syncCapsState, true);

      passwordInput.addEventListener('mousedown', onInteraction);
      passwordInput.addEventListener('keydown', onInteraction);
      passwordInput.addEventListener('keyup', onInteraction);
      passwordInput.addEventListener('focus', updateHint);
      passwordInput.addEventListener('blur', function () {
        hint.hidden = true;
      });
    })();

    (function initUsernameFields() {
      // Misma lista que valida el servidor (config/country.js), inyectada para
      // no mantener dos copias que se desincronicen.
      const ALLOWED_DOMAINS = new Set(<%- JSON.stringify(countryConfig.allowedLoginDomains) %>);
      const FORBIDDEN_TLD = <%- JSON.stringify(countryConfig.forbiddenEmailTld) %>;
      const DEFAULT_DOMAIN = <%- JSON.stringify(countryConfig.corporateEmailDomain) %>;
      const COUNTRY_NAME = <%- JSON.stringify(countryConfig.name) %>;
      const FOREIGN_DOMAIN_MSG = 'El dominio .' + FORBIDDEN_TLD + ' no está disponible en ' + COUNTRY_NAME + '.';

      function isForbiddenDomain(domain) {
        const d = String(domain || '').trim().toLowerCase();
        if (!d || !FORBIDDEN_TLD) return false;
        return d === FORBIDDEN_TLD || d.endsWith('.' + FORBIDDEN_TLD);
      }

      function normalizeDomainValue(value) {
        return String(value || '')
          .trim()
          .toLowerCase()
          .replace(/^@+/, '')
          .replace(/[^a-z0-9.-]/g, '');
      }

      function parseUsernameInput(value) {
        const raw = String(value || '').trim().toLowerCase();
        const at = raw.indexOf('@');
        if (at === -1) return { username: raw, domain: null };
        const username = raw.slice(0, at);
        const domain = raw.slice(at + 1);
        if (!domain || isForbiddenDomain(domain) || !ALLOWED_DOMAINS.has(domain)) {
          return { username: username, domain: null };
        }
        return { username: username, domain: domain };
      }

      function resizeDomainInput(input) {
        const len = Math.max(String(input.value || '').length, 8);
        input.style.width = len + 'ch';
      }

      function bindDomainEditor(row) {
        const wrap = row.querySelector('[data-login-domain]');
        const input = wrap ? wrap.querySelector('.login-domain__input') : null;
        const button = wrap ? wrap.querySelector('.login-domain__edit') : null;
        if (!wrap || !input || !button) return null;

        let previousValue = input.value || DEFAULT_DOMAIN;
        resizeDomainInput(input);

        function setEditing(editing) {
          input.readOnly = !editing;
          input.tabIndex = editing ? 0 : -1;
          wrap.classList.toggle('login-domain--editing', editing);
          button.setAttribute('aria-pressed', editing ? 'true' : 'false');
          button.title = editing ? 'Confirmar dominio' : 'Editar dominio';
          button.setAttribute('aria-label', button.title);
        }

        function commitDomain() {
          let value = normalizeDomainValue(input.value);
          if (!value) value = previousValue || DEFAULT_DOMAIN;
          if (isForbiddenDomain(value)) {
            wrap.classList.add('login-domain--invalid');
            return { ok: false, message: FOREIGN_DOMAIN_MSG };
          }
          input.value = value;
          previousValue = value;
          wrap.classList.remove('login-domain--invalid');
          setEditing(false);
          resizeDomainInput(input);
          return { ok: true, value: value };
        }

        function unlock() {
          const current = normalizeDomainValue(input.value);
          if (current && !isForbiddenDomain(current)) {
            previousValue = current;
          }
          setEditing(true);
          input.focus();
          input.select();
        }

        button.addEventListener('mousedown', function (e) {
          e.preventDefault();
          if (input.readOnly) unlock();
          else commitDomain();
        });

        input.addEventListener('input', function () {
          input.value = normalizeDomainValue(input.value);
          wrap.classList.toggle('login-domain--invalid', isForbiddenDomain(input.value));
          resizeDomainInput(input);
        });

        input.addEventListener('blur', function () {
          if (input.readOnly || wrap.dataset.blockBlur === '1') {
            delete wrap.dataset.blockBlur;
            return;
          }
          if (isForbiddenDomain(normalizeDomainValue(input.value))) {
            input.value = previousValue || DEFAULT_DOMAIN;
            wrap.classList.remove('login-domain--invalid');
          }
          commitDomain();
        });

        input.addEventListener('keydown', function (e) {
          if (e.key === 'Enter') {
            e.preventDefault();
            const result = commitDomain();
            if (result.ok) {
              const form = input.closest('form');
              const password = form ? form.querySelector('input[type="password"]') : null;
              if (password) password.focus();
            }
          }
          if (e.key === 'Escape') {
            e.preventDefault();
            input.value = previousValue || DEFAULT_DOMAIN;
            wrap.classList.remove('login-domain--invalid');
            setEditing(false);
            resizeDomainInput(input);
          }
        });

        const form = input.closest('form');
        if (form && !form.dataset.domainGuard) {
          form.dataset.domainGuard = '1';
          const submitBtn = form.querySelector('[type="submit"]');
          if (submitBtn) {
            submitBtn.addEventListener('mousedown', function () {
              if (!input.readOnly && isForbiddenDomain(normalizeDomainValue(input.value))) {
                wrap.dataset.blockBlur = '1';
              }
            });
          }
          form.addEventListener('submit', function (e) {
            const value = normalizeDomainValue(input.value);
            if (isForbiddenDomain(value)) {
              e.preventDefault();
              const errorEl = document.getElementById('loginAuthError');
              if (errorEl) {
                errorEl.textContent = FOREIGN_DOMAIN_MSG;
                errorEl.hidden = false;
              }
              wrap.classList.add('login-domain--invalid');
              unlock();
              return;
            }
            commitDomain();
          });
        }

        return {
          setDomain: function (domain) {
            if (!domain || isForbiddenDomain(domain)) return;
            input.value = domain;
            previousValue = domain;
            resizeDomainInput(input);
          }
        };
      }

      function sanitizeUsernameField(input) {
        const row = input.closest('.login-username-row');
        const domainEditor = row ? bindDomainEditor(row) : null;

        function apply() {
          const parsed = parseUsernameInput(input.value);
          if (input.value !== parsed.username) {
            input.value = parsed.username;
          }
          if (parsed.domain && domainEditor) {
            domainEditor.setDomain(parsed.domain);
          }
        }

        input.addEventListener('input', apply);
        input.addEventListener('change', apply);

        input.addEventListener('paste', function (e) {
          e.preventDefault();
          const text = (e.clipboardData || window.clipboardData).getData('text');
          const parsed = parseUsernameInput(text);
          input.value = parsed.username;
          if (parsed.domain && domainEditor) {
            domainEditor.setDomain(parsed.domain);
          }
        });

        input.addEventListener('keydown', function (e) {
          if (e.key === '@') e.preventDefault();
        });

        if (input.value) apply();
        window.setTimeout(apply, 100);
        window.setTimeout(apply, 500);
      }

      ['login-username', 'reg-username'].forEach(function (id) {
        const el = document.getElementById(id);
        if (el) sanitizeUsernameField(el);
      });
    })();

  </script>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
  <script src="/js/profile-photo-cropper.js?v=20260916m"></script>
  <script src="/js/password-strength.js?v=20260916q"></script>
  <script>window.__PHONE_CONFIG__ = <%- JSON.stringify(phoneClientConfig()) %>;</script>
  <script src="/js/phone.js?v=20260910n"></script>
  <script>
    (function initRegisterForm() {
      const passwordInput = document.getElementById('reg-password');
      const password2Input = document.getElementById('reg-password2');
      const telefonoField = document.querySelector('[data-phone-field]');
      const submitBtn = document.getElementById('register-submit-btn');
      const strengthBox = document.getElementById('password-strength');
      const strengthLabel = document.getElementById('password-strength-label');
      const strengthSegments = document.querySelectorAll('.login-password-strength-segment');
      const ruleItems = document.querySelectorAll('#password-rules li');
      const matchMsg = document.getElementById('password-match-msg');
      const firstNameInput = document.getElementById('first_name');
      const lastNameInput = document.getElementById('last_name');
      const usernameInput = document.getElementById('reg-username');
      const birthDateInput = document.getElementById('fecha_nacimiento');
      const telefonoLocalInput = document.getElementById('telefono_local');

      /**
       * Validación campo por campo.
       *
       * Cada campo dice qué le falta justo debajo, en vez de acumular una lista
       * al final del formulario. El mensaje aparece cuando el campo ya se tocó
       * (salió el foco o se escribió en él), para no recibir al usuario con todo
       * en rojo antes de haber escrito nada.
       *
       * Se declara antes que nada porque PhoneField.initField llama a su
       * `onChange` durante la inicialización, y ese camino ya consulta este Set.
       */
      const tocados = new Set();

      if (!passwordInput || !password2Input || !submitBtn || !strengthBox || !matchMsg) return;

      const photoCropper = ProfilePhotoCropper.init({
        fileInputId: 'foto_file',
        previewImgId: 'photo-preview-img',
        previewPlaceholderId: 'photo-placeholder',
        selectBtnId: 'btn-select-photo',
        overlayId: 'fotoCropOverlay',
        cropImgId: 'fotoCropImage',
        closeBtnId: 'fotoCropClose',
        cancelBtnId: 'fotoCropCancel',
        saveBtnId: 'fotoCropSave',
        errorElId: 'fotoCropError',
        maxSizeMb: 5,
        outputSize: 400,
        outputFilename: 'foto-perfil.jpg',
        saveLabel: 'Aplicar recorte',
        clearOnLeave: true,
        onCropped: function () {
          updateSubmitState();
        }
      });

      const registerForm = document.querySelector('[data-view="register"] form');
      const phoneField = PhoneField.initField(telefonoField, { onChange: updateSubmitState });

      if (registerForm) {
        registerForm.addEventListener('submit', function () {
          phoneField?.sync();
          const blob = photoCropper.getBlob();
          if (blob) {
            const file = new File([blob], 'foto-perfil.jpg', { type: 'image/jpeg' });
            const dt = new DataTransfer();
            dt.items.add(file);
            document.getElementById('foto_file').files = dt.files;
          }
        });
      }

      function updateStrengthUI() {
        const result = PasswordStrength.analyzePasswordStrength(passwordInput.value);
        const hasValue = passwordInput.value.length > 0;

        strengthBox.hidden = !hasValue;
        if (!hasValue) {
          strengthLabel.textContent = '';
          strengthLabel.className = 'login-password-strength-label';
          strengthSegments.forEach((seg) => {
            seg.className = 'login-password-strength-segment';
          });
          ruleItems.forEach((item) => item.classList.remove('valid'));
          return;
        }

        strengthLabel.textContent = result.label;
        strengthLabel.className = 'login-password-strength-label ' + (result.level === 'empty' ? '' : result.level);

        strengthSegments.forEach((seg) => {
          const idx = Number(seg.dataset.segment);
          seg.className = 'login-password-strength-segment' + (idx <= result.score ? ' active-' + result.score : '');
        });

        ruleItems.forEach((item) => {
          const rule = item.dataset.rule;
          item.classList.toggle('valid', Boolean(result.checks[rule]));
        });
      }

      function updateMatchUI() {
        const p1 = passwordInput.value;
        const p2 = password2Input.value;

        if (!p2.length) {
          matchMsg.hidden = true;
          matchMsg.textContent = '';
          return;
        }

        matchMsg.hidden = false;
        if (p1 === p2) {
          matchMsg.textContent = 'Las contraseñas coinciden';
          matchMsg.className = 'login-password-match ok';
        } else {
          matchMsg.textContent = 'Las contraseñas no coinciden';
          matchMsg.className = 'login-password-match bad';
        }
      }

      function marcarCampo(input, mensaje) {
        if (!input) return;
        const contenedor = input.closest('.login-field');
        const slot = document.querySelector('[data-error-for="' + input.id + '"]');
        const mostrar = Boolean(mensaje) && tocados.has(input.id);

        if (contenedor) contenedor.classList.toggle('login-field--invalid', mostrar);
        input.setAttribute('aria-invalid', mostrar ? 'true' : 'false');

        if (!slot) return;
        slot.textContent = mostrar ? mensaje : '';
        slot.hidden = !mostrar;
      }

      function ejemploTelefono() {
        const cfg = window.__PHONE_CONFIG__ || {};
        return cfg.example ? 'Ingresa un celular válido, por ejemplo ' + cfg.example + '.' : 'Ingresa un celular válido.';
      }

      function updateSubmitState() {
        const strongEnough = PasswordStrength.isPasswordStrongEnough(passwordInput.value);
        const passwordsMatch = passwordInput.value === password2Input.value && password2Input.value.length > 0;
        const hasTelefono = PhoneField.isFieldValid(telefonoField);
        const hasFirstName = Boolean(firstNameInput?.value.trim());
        const hasLastName = Boolean(lastNameInput?.value.trim());
        const hasUsername = Boolean(usernameInput?.value.trim());
        const hasBirthDate = Boolean(birthDateInput?.value);

        marcarCampo(firstNameInput, hasFirstName ? '' : 'Ingresa tu nombre.');
        marcarCampo(lastNameInput, hasLastName ? '' : 'Ingresa tu apellido.');
        marcarCampo(usernameInput, hasUsername ? '' : 'Ingresa tu usuario de correo.');
        marcarCampo(
          passwordInput,
          strongEnough ? '' : PasswordStrength.POLICY_HINT,
        );
        marcarCampo(
          password2Input,
          password2Input.value.length === 0
            ? 'Repite la contraseña.'
            : passwordsMatch
              ? ''
              : 'Las contraseñas no coinciden.',
        );
        marcarCampo(telefonoLocalInput, hasTelefono ? '' : ejemploTelefono());
        marcarCampo(birthDateInput, hasBirthDate ? '' : 'Selecciona tu fecha de nacimiento.');

        const canSubmit =
          strongEnough && passwordsMatch && hasTelefono &&
          hasFirstName && hasLastName && hasUsername && hasBirthDate;

        submitBtn.disabled = !canSubmit;
        submitBtn.setAttribute('aria-disabled', canSubmit ? 'false' : 'true');
      }

      function onPasswordChange() {
        updateStrengthUI();
        updateMatchUI();
        updateSubmitState();
      }

      passwordInput.addEventListener('input', onPasswordChange);
      password2Input.addEventListener('input', onPasswordChange);

      // Un campo se considera "tocado" al salir de él o al escribir dentro; a
      // partir de ahí su mensaje puede mostrarse.
      const camposRegistro = [
        firstNameInput, lastNameInput, usernameInput,
        passwordInput, password2Input, telefonoLocalInput, birthDateInput,
      ];

      camposRegistro.forEach(function (el) {
        if (!el) return;
        el.addEventListener('blur', function () {
          tocados.add(el.id);
          updateSubmitState();
        });
        el.addEventListener('input', function () {
          if (el.value) tocados.add(el.id);
          updateSubmitState();
        });
        el.addEventListener('change', updateSubmitState);
      });

      // Al enviar sin completar, se marcan todos para que no quede ninguno mudo.
      registerForm?.addEventListener('submit', function (e) {
        camposRegistro.forEach(function (el) { if (el) tocados.add(el.id); });
        updateSubmitState();
        if (submitBtn.disabled) {
          e.preventDefault();
          document.querySelector('.login-field--invalid')?.scrollIntoView({ block: 'center', behavior: 'smooth' });
        }
      });

      updateSubmitState();
    })();
  </script>

  <script>
    /**
     * Estado "enviando" de los botones de los formularios de acceso.
     *
     * Va al final del documento a propósito: los listeners corren en orden de
     * registro, así que este es el último y ya sabe si alguna validación anterior
     * canceló el envío (evento.defaultPrevented).
     */
    (function initBotonesEnviando() {
      function marcar(boton) {
        if (boton.classList.contains('is-enviando')) return;
        var texto = boton.textContent.trim();
        boton.classList.add('is-enviando');
        boton.setAttribute('aria-busy', 'true');
        boton.setAttribute('aria-label', 'Enviando');
        boton.dataset.textoOriginal = texto;
        boton.style.minWidth = boton.offsetWidth + 'px';
        boton.innerHTML = '<span class="login-split__submit__spinner" aria-hidden="true"></span>';
        // Deshabilitar dentro del propio submit puede abortar el envío en
        // algunos navegadores; en el siguiente tick ya salió la petición.
        window.setTimeout(function () { boton.disabled = true; }, 0);
      }

      function restaurar(boton) {
        if (!boton.classList.contains('is-enviando')) return;
        boton.classList.remove('is-enviando');
        boton.removeAttribute('aria-busy');
        boton.removeAttribute('aria-label');
        boton.disabled = false;
        boton.style.minWidth = '';
        boton.textContent = boton.dataset.textoOriginal || boton.textContent;
      }

      document.querySelectorAll('form').forEach(function (form) {
        form.addEventListener('submit', function (evento) {
          if (evento.defaultPrevented) return;
          var boton = form.querySelector('button.login-split__submit[type="submit"]');
          if (!boton || boton.disabled) return;
          marcar(boton);
        });
      });

      // Al volver con el botón atrás la página se restaura tal como quedó, con
      // el botón girando sobre un formulario que ya no se está enviando.
      window.addEventListener('pageshow', function (evento) {
        if (!evento.persisted) return;
        document.querySelectorAll('.login-split__submit.is-enviando').forEach(restaurar);
      });
    })();
  </script>

</body>
</html>
