            <button type="button" class="login-carousel__dot<%= showSupportSlide ? '' : ' is-active' %>" data-slide-to="1" role="tab" aria-selected="<%= showSupportSlide ? 'false' : 'true' %>" aria-label="Diapositiva <%= showSupportSlide ? '2' : '1' %>"></button>
            <button type="button" class="login-carousel__dot" data-slide-to="2" role="tab" aria-selected="false" aria-label="Diapositiva <%= showSupportSlide ? '3' : '2' %>"></button>
