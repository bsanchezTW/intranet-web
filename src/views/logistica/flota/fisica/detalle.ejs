<%# REVISIÓN FÍSICA DESHABILITADA (2026-11-10). Ver docs/REACTIVAR-REVISION-FISICA.md
<_%
  const r = review;
  const anulada = r.status === 'voided';
  const nuevos = r.damages || [];
  const previos = r.previous || [];
  const capturas = captureViews.filter((cv) => (r.captures || {})[cv.value]);
  const fmtHora = (valor) => new Date(valor).toLocaleString(countryConfig.locale, { dateStyle: 'short', timeStyle: 'short', timeZone: countryConfig.timezone });
%_>

<div class="contenedor">

  <div class="page-header">
    <span class="page-header__icono" aria-hidden="true"><_%- include('../../../partials/icon', { name: 'camera' }) %_></span>
    <div class="page-header__text">
      <nav class="page-header__migas" aria-label="Ruta de navegación">
        <a href="/procesos">Procesos y documentos</a> <span aria-hidden="true">/</span>
        <a href="<_%= FLOTA %_>">Gestión de flota</a> <span aria-hidden="true">/</span>
        <a href="<_%= FLOTA %_>/<_%= r.vehicle_id %_>/revisiones?ver=fisicas">Historial de <_%= r.vehicle_plate %_></a> <span aria-hidden="true">/</span>
        <span><_%= r.number %_></span>
      </nav>
      <h2 class="page-title">Revisión física <_%= r.number %_></h2>
      <p class="page-description">
        <_%= r.vehicle_plate %_><_% if (r.vehicle_label) { %_> · <_%= r.vehicle_label %_><_% } %_>
        · <_%= formatDate(r.review_date) %_> · <_%= reasonLabel(r.reason) %_>
      </p>
    </div>
    <div class="page-header-actions">
      <a href="<_%= FISICA %_>/<_%= r.id %_>/pdf" target="_blank" rel="noopener" class="page-header-btn">
        <_%- include('../../../partials/icon', { name: 'printer' }) %_> Imprimir
      </a>
    </div>
  </div>

  <_% if (success) { %_><div hidden data-toast="<_%= success %_>"></div><_% } %_>
  <_% if (error) { %_><div hidden data-toast="<_%= error %_>" data-toast-tone="error"></div><_% } %_>

  <_% if (anulada) { %_>
    <div class="logistica-anulado" role="note">
      <span class="logistica-anulado__icono" aria-hidden="true"><_%- include('../../../partials/icon', { name: 'x-circle' }) %_></span>
      <span>
        <strong>Revisión anulada</strong> el <_%= fmtHora(r.voided_at) %_><_% if (r.voided_by_name) { %_> por <_%= r.voided_by_name %_><_% } %_>.
        Motivo: <_%= r.void_reason %_>. Sus daños quedaron anulados.
      </span>
    </div>
  <_% } %_>

  <div class="logistica-detalle">
    <section class="logistica-panel" aria-labelledby="det-resultado">
      <h3 class="logistica-panel__titulo" id="det-resultado">Resultado</h3>
      <div class="logistica-veredicto">
        <_% if (anulada) { %_>
          <span class="logistica-estado logistica-estado--anulado">Anulada</span>
        <_% } else if (nuevos.length) { %_>
          <span class="logistica-estado logistica-estado--no_apto"><_%= nuevos.length %_> <_%= nuevos.length === 1 ? 'daño nuevo' : 'daños nuevos' %_></span>
        <_% } else { %_>
          <span class="logistica-estado logistica-estado--apto">Sin daños nuevos</span>
        <_% } %_>
        <span class="logistica-sub"><_%= previos.length %_> <_%= previos.length === 1 ? 'daño abierto de antes' : 'daños abiertos de antes' %_></span>
      </div>
      <dl class="logistica-datos">
        <div><dt>Registrado por</dt><dd><_%= r.created_by_name %_></dd></div>
        <div><dt>Fecha y hora del registro</dt><dd><_%= fmtHora(r.created_at) %_></dd></div>
        <_% if (r.observations) { %_>
          <div class="logistica-datos--ancho"><dt>Observaciones</dt><dd class="danio-detalle__texto"><_%= r.observations %_></dd></div>
        <_% } %_>
      </dl>
    </section>

    <section class="logistica-panel" aria-labelledby="det-vehiculo">
      <h3 class="logistica-panel__titulo" id="det-vehiculo">Vehículo y conductor</h3>
      <dl class="logistica-datos">
        <div><dt>Patente</dt><dd><span class="logistica-patente"><_%= r.vehicle_plate %_></span></dd></div>
        <div><dt>Tipo</dt><dd><_%= labelFrom(VEHICLE_KINDS, r.vehicle_kind) %_></dd></div>
        <div><dt>Vehículo</dt><dd><_%= r.vehicle_label || '—' %_></dd></div>
        <div><dt>Kilometraje</dt><dd><_%= formatKm(r.odometer_km) %_></dd></div>
        <div class="logistica-datos--ancho"><dt>Conductor</dt><dd><_%= r.driver_name %_></dd></div>
      </dl>
    </section>
  </div>

  <section class="logistica-panel" aria-labelledby="det-modelo">
    <h3 class="logistica-panel__titulo" id="det-modelo">Modelo del vehículo</h3>
    <_% if (!capturas.length) { %_>
      <p class="logistica-panel__desc">Se registró sin capturas del modelo: el navegador no pudo mostrar el 3D.</p>
    <_% } else { %_>
      <p class="logistica-panel__desc">Como quedó al guardar la revisión: en rojo los daños abiertos y los encontrados en esta revisión.</p>
      <ul class="fisica-capturas">
        <_% capturas.forEach((cv) => { %_>
          <li>
            <span class="fisica-capturas__lado"><_%= cv.label %_></span>
            <img src="<_%= FISICA %_>/<_%= r.id %_>/captura/<_%= cv.value %_>" alt="Modelo: <_%= cv.label.toLowerCase() %_>" loading="lazy" decoding="async" width="1200" height="720">
          </li>
        <_% }) %_>
      </ul>
    <_% } %_>
  </section>

  <section class="logistica-panel" aria-labelledby="det-nuevos">
    <h3 class="logistica-panel__titulo" id="det-nuevos">
      Daños encontrados en esta revisión
      <span class="logistica-panel__extra"><_%= nuevos.length %_></span>
    </h3>
    <_% if (!nuevos.length) { %_>
      <p class="logistica-panel__desc">No se encontraron daños nuevos.</p>
    <_% } else { %_>
      <_%- include('../partials/danios_lista', { danios: nuevos, sinOrigen: true }) %_>
    <_% } %_>
  </section>

  <_% if (previos.length) { %_>
    <section class="logistica-panel" aria-labelledby="det-previos">
      <h3 class="logistica-panel__titulo" id="det-previos">
        Daños que ya estaban abiertos
        <span class="logistica-panel__extra"><_%= previos.length %_></span>
      </h3>
      <p class="logistica-panel__desc">Registrados en revisiones anteriores y sin reparar ese día. El estado es el de hoy.</p>
      <_%- include('../partials/danios_lista', { danios: previos }) %_>
    </section>
  <_% } %_>

  <_% if (!anulada && puedeAnular) { %_>
    <section class="logistica-panel" style="padding-bottom: 18px;">
      <details class="logistica-anular">
        <summary><_%- include('../../../partials/icon', { name: 'x-circle' }) %_> Anular esta revisión</summary>
        <form method="post" action="<_%= FISICA %_>/<_%= r.id %_>/anular"
              data-confirm="La revisión <_%= r.number %_> quedará anulada y sus <_%= nuevos.length %_> daños también. Seguirá en el registro, pero ya no cuenta."
              data-confirm-title="¿Anular la revisión?" data-confirm-accept="Anular" data-confirm-tone="peligro">
          <div class="campo-form">
            <label for="motivo">Motivo <span class="required-mark">*</span></label>
            <textarea id="motivo" name="motivo" rows="2" maxlength="300" minlength="5" required placeholder="Por ejemplo: se registró en la patente equivocada."></textarea>
          </div>
          <div>
            <button type="submit" class="page-header-btn page-header-btn--secundario"><_%- include('../../../partials/icon', { name: 'x-circle' }) %_> Anular</button>
          </div>
        </form>
      </details>
    </section>
  <_% } %_>
</div>

%>
