<%
  const r = registro;
  const anulado = r.status === 'voided';
  const respuestas = Array.isArray(r.answers) ? r.answers : [];
  const fallas = respuestas.filter((a) => a.answer === 'falla');
  const registradoEl = new Date(r.created_at).toLocaleString(countryConfig.locale, { dateStyle: 'short', timeStyle: 'short', timeZone: countryConfig.timezone });
  const anuladoEl = r.voided_at ? new Date(r.voided_at).toLocaleString(countryConfig.locale, { dateStyle: 'short', timeStyle: 'short', timeZone: countryConfig.timezone }) : '';
  const etiquetaRespuesta = (valor) => (ANSWERS.find((a) => a.value === valor) || { label: valor }).label;
  let categoriaActual = null;
%>

<div class="contenedor">

  <div class="page-header">
    <span class="page-header__icono" aria-hidden="true"><%- include('../../../partials/icon', { name: 'clipboard-check' }) %></span>
    <div class="page-header__text">
      <nav class="page-header__migas" aria-label="Ruta de navegación">
        <a href="/procesos">Procesos y documentos</a> <span aria-hidden="true">/</span>
        <a href="<%= FLOTA %>">Gestión de flota</a> <span aria-hidden="true">/</span>
        <a href="<%= MECANICA %>">Revisiones mecánicas</a> <span aria-hidden="true">/</span>
        <span><%= r.number %></span>
      </nav>
      <h2 class="page-title">Revisión mecánica <%= r.number %></h2>
      <p class="page-description">
        <%= r.vehicle_plate %><% if (r.vehicle_label) { %> · <%= r.vehicle_label %><% } %>
        · <%= formatDate(r.inspection_date) %> · <%= labelFrom(INSPECTION_KINDS, r.inspection_kind) %>
      </p>
    </div>
    <div class="page-header-actions">
      <a href="<%= MECANICA %>/<%= r.id %>/pdf" target="_blank" rel="noopener" class="page-header-btn">
        <%- include('../../../partials/icon', { name: 'printer' }) %> Imprimir
      </a>
    </div>
  </div>

  <% if (success) { %>
    <div hidden data-toast="<%= success %>"></div>
  <% } %>
  <% if (error) { %>
    <div hidden data-toast="<%= error %>" data-toast-tone="error"></div>
  <% } %>

  <% if (anulado) { %>
    <div class="logistica-anulado" role="note">
      <span class="logistica-anulado__icono" aria-hidden="true"><%- include('../../../partials/icon', { name: 'x-circle' }) %></span>
      <span>
        <strong>Revisión anulada</strong> el <%= anuladoEl %><% if (r.voided_by_name) { %> por <%= r.voided_by_name %><% } %>.
        Motivo: <%= r.void_reason %>
      </span>
    </div>
  <% } %>

  <div class="logistica-detalle">
    <section class="logistica-panel" aria-labelledby="det-resultado">
      <h3 class="logistica-panel__titulo" id="det-resultado">Resultado</h3>
      <div class="logistica-veredicto">
        <span class="logistica-estado logistica-estado--<%= anulado ? 'anulado' : r.result %>"><%= anulado ? 'Anulado' : resultLabel(r.result) %></span>
        <span class="logistica-sub">
          <%= respuestas.length %> ítems revisados · <%= fallas.length %> no <%= fallas.length === 1 ? 'operativo' : 'operativos' %>
        </span>
      </div>
      <dl class="logistica-datos">
        <div><dt>Registrado por</dt><dd><%= r.created_by_name %></dd></div>
        <div><dt>Fecha y hora del registro</dt><dd><%= registradoEl %></dd></div>
        <% if (r.observations) { %>
          <div class="logistica-datos--ancho"><dt>Observaciones</dt><dd><%= r.observations %></dd></div>
        <% } %>
      </dl>
    </section>

    <section class="logistica-panel" aria-labelledby="det-vehiculo">
      <h3 class="logistica-panel__titulo" id="det-vehiculo">Vehículo y conductor</h3>
      <dl class="logistica-datos">
        <div><dt>Patente</dt><dd><span class="logistica-patente"><%= r.vehicle_plate %></span></dd></div>
        <div><dt>Vehículo</dt><dd><%= r.vehicle_label || '—' %></dd></div>
        <div><dt>Kilometraje</dt><dd><%= formatKm(r.odometer_km) %></dd></div>
        <div><dt>Combustible</dt><dd><%= r.fuel_level || '—' %></dd></div>
        <div class="logistica-datos--ancho"><dt>Conductor</dt><dd><%= r.driver_name %></dd></div>
        <% documentsFor(country).forEach((d) => { %>
          <div><dt><%= d.label %></dt><dd><%= formatDate(r[d.field]) %></dd></div>
        <% }) %>
        <div><dt>Próx. mantención</dt><dd><%= formatKm(r.next_maintenance_km) %></dd></div>
      </dl>
    </section>
  </div>

  <section class="logistica-panel" aria-labelledby="det-items" style="padding-bottom: 18px;">
    <h3 class="logistica-panel__titulo" id="det-items">Ítems revisados</h3>
    <p class="logistica-panel__desc">El texto de cada ítem es el que tenía la plantilla al registrar.</p>
    <div class="logistica-tabla-wrap">
      <table class="logistica-tabla">
        <thead>
          <tr>
            <th scope="col">Descripción</th>
            <th scope="col">Operativo</th>
            <th scope="col">Observaciones</th>
          </tr>
        </thead>
        <tbody>
          <% respuestas.forEach((a) => { %>
            <% if (a.category !== categoriaActual) { categoriaActual = a.category; %>
              <tr class="logistica-tabla__grupo"><td colspan="3"><%= a.category %></td></tr>
            <% } %>
            <tr class="<%= a.answer === 'falla' ? 'is-falla' : '' %>">
              <td>
                <%= a.label %>
                <% if (a.critical) { %> <span class="logistica-estado logistica-estado--critico">Crítico</span><% } %>
              </td>
              <td><span class="logistica-respuesta logistica-respuesta--<%= a.answer %>"><%= etiquetaRespuesta(a.answer) %></span></td>
              <td><%= a.comment || '' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <% if (!anulado && puedeAnular) { %>
      <details class="logistica-anular">
        <summary><%- include('../../../partials/icon', { name: 'x-circle' }) %> Anular esta revisión</summary>
        <form method="post" action="<%= MECANICA %>/<%= r.id %>/anular"
              data-confirm="La revisión <%= r.number %> quedará anulada. Seguirá en el registro, pero ya no cuenta como revisión válida."
              data-confirm-title="¿Anular la revisión?" data-confirm-accept="Anular" data-confirm-tone="peligro">
          <div class="campo-form">
            <label for="motivo">Motivo <span class="required-mark">*</span></label>
            <textarea id="motivo" name="motivo" rows="2" maxlength="300" minlength="5" required placeholder="Por ejemplo: se registró con la patente equivocada."></textarea>
          </div>
          <div>
            <button type="submit" class="page-header-btn page-header-btn--secundario"><%- include('../../../partials/icon', { name: 'x-circle' }) %> Anular</button>
          </div>
        </form>
      </details>
    <% } %>
  </section>
</div>
