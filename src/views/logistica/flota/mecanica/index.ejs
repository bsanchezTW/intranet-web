<%
  const lista = Array.isArray(registros) ? registros : [];
  const vehiculos = Array.isArray(flota) ? flota : [];
  const totales = resumen || { del_mes: 0, no_aptos: 0 };
  const RESULTADOS = [
    ['', 'Todos'],
    ['apto', 'Aptos'],
    ['observado', 'Con observaciones'],
    ['no_apto', 'No aptos'],
    ['anulados', 'Anulados'],
  ];
  const hayFiltro = !!(filtros.q || filtros.resultado || filtros.desde || filtros.hasta || filtros.vehiculo);
%>

<div class="contenedor">

  <div class="page-header">
    <span class="page-header__icono" aria-hidden="true"><%- include('../../../partials/icon', { name: 'clipboard-check' }) %></span>
    <div class="page-header__text">
      <nav class="page-header__migas" aria-label="Ruta de navegación">
        <a href="/procesos">Procesos y documentos</a> <span aria-hidden="true">/</span>
        <a href="<%= FLOTA %>">Gestión de flota</a>
      </nav>
      <h2 class="page-title">Revisiones mecánicas</h2>
      <p class="page-description">Revisiones registradas de la flota, con su número correlativo. Consulta cualquiera o imprímela.</p>
    </div>
    <div class="page-header-actions">
      <a href="<%= FLOTA %>" class="page-header-btn page-header-btn--secundario"><%- include('../../../partials/icon', { name: 'truck' }) %> Gestión de flota</a>
      <% if (puedePlantilla) { %>
        <a href="<%= MECANICA %>/items" class="page-header-btn page-header-btn--secundario"><%- include('../../../partials/icon', { name: 'settings' }) %> Ítems</a>
      <% } %>
      <% if (puedeRevisar) { %>
        <a href="<%= MECANICA %>/nueva" class="page-header-btn"><%- include('../../../partials/icon', { name: 'plus' }) %> Nueva revisión</a>
      <% } %>
    </div>
  </div>

  <% if (success) { %>
    <div hidden data-toast="<%= success %>"></div>
  <% } %>
  <% if (error) { %>
    <div hidden data-toast="<%= error %>" data-toast-tone="error"></div>
  <% } %>

  <div class="logistica-resumen">
    <div class="logistica-resumen__dato">
      <span class="logistica-resumen__label">Registrados este mes</span>
      <strong><%= totales.del_mes %></strong>
    </div>
    <div class="logistica-resumen__dato">
      <span class="logistica-resumen__label">No aptos · últimos 30 días</span>
      <strong class="<%= totales.no_aptos > 0 ? 'is-alerta' : '' %>"><%= totales.no_aptos %></strong>
    </div>
  </div>

  <form class="logistica-filtros" method="get" action="<%= MECANICA %>" role="search">
    <label class="logistica-filtros__buscar">
      <span class="sr-only">Buscar</span>
      <%- include('../../../partials/icon', { name: 'search' }) %>
      <input type="search" name="q" value="<%= filtros.q %>" placeholder="Patente, conductor, firmante o número" maxlength="80">
    </label>
    <label class="logistica-filtros__campo">
      <span>Vehículo</span>
      <select name="vehiculo">
        <option value="">Todos</option>
        <% vehiculos.forEach((v) => { %>
          <option value="<%= v.id %>"<%= Number(filtros.vehiculo) === Number(v.id) ? ' selected' : '' %>><%= v.plate %><%= v.active ? '' : ' (de baja)' %></option>
        <% }) %>
      </select>
    </label>
    <label class="logistica-filtros__campo">
      <span>Desde</span>
      <input type="date" name="desde" value="<%= filtros.desde %>">
    </label>
    <label class="logistica-filtros__campo">
      <span>Hasta</span>
      <input type="date" name="hasta" value="<%= filtros.hasta %>">
    </label>
    <button type="submit" class="logistica-chip">Filtrar</button>
    <% if (hayFiltro) { %><a href="<%= MECANICA %>" class="logistica-filtros__limpiar">Limpiar</a><% } %>
    <div class="logistica-filtros__estados" role="group" aria-label="Resultado">
      <% RESULTADOS.forEach(([valor, texto]) => { %>
        <button type="submit" name="resultado" value="<%= valor %>" class="logistica-chip<%= filtros.resultado === valor ? ' is-active' : '' %>"<%= filtros.resultado === valor ? ' aria-pressed="true"' : '' %>><%= texto %></button>
      <% }) %>
    </div>
  </form>

  <% if (!lista.length) { %>
    <div class="logistica-vacio">
      <span class="logistica-vacio__icono" aria-hidden="true"><%- include('../../../partials/icon', { name: 'clipboard-check' }) %></span>
      <% if (hayFiltro) { %>
        <p>Ninguna revisión coincide con la búsqueda.</p>
        <a href="<%= MECANICA %>">Ver todas</a>
      <% } else if (!vehiculos.length) { %>
        <p class="logistica-vacio__titulo">Todavía no hay vehículos en la flota</p>
        <p>Para registrar la primera revisión, primero agrega los vehículos de la empresa.</p>
        <a href="<%= FLOTA %>" class="page-header-btn"><%- include('../../../partials/icon', { name: 'truck' }) %> Ir a Gestión de flota</a>
      <% } else { %>
        <p>Todavía no se ha registrado ninguna revisión mecánica.</p>
        <% if (puedeRevisar) { %>
          <a href="<%= MECANICA %>/nueva" class="page-header-btn"><%- include('../../../partials/icon', { name: 'plus' }) %> Registrar el primero</a>
        <% } %>
      <% } %>
    </div>
  <% } else { %>
    <div class="logistica-tabla-wrap">
      <table class="logistica-tabla logistica-tabla--tarjetas">
        <thead>
          <tr>
            <th scope="col">Número</th>
            <th scope="col">Fecha</th>
            <th scope="col">Vehículo</th>
            <th scope="col">Conductor</th>
            <th scope="col" class="num">Kilometraje</th>
            <th scope="col">Resultado</th>
            <th scope="col"><span class="sr-only">Acciones</span></th>
          </tr>
        </thead>
        <tbody>
          <% lista.forEach((c) => { const anulado = c.status === 'voided'; %>
            <tr class="<%= anulado ? 'is-anulado' : '' %>">
              <td data-label="Número">
                <a class="logistica-numero" href="<%= MECANICA %>/<%= c.id %>"><%= c.number %></a>
                <span class="logistica-sub"><%= labelFrom(INSPECTION_KINDS, c.inspection_kind) %></span>
              </td>
              <td data-label="Fecha"><%= formatDate(c.inspection_date) %></td>
              <td data-label="Vehículo">
                <span class="logistica-patente"><%= c.vehicle_plate %></span>
                <% if (c.vehicle_label) { %><span class="logistica-sub"><%= c.vehicle_label %></span><% } %>
              </td>
              <td data-label="Conductor">
                <%= c.driver_name %>
                <% if (c.created_by_name && c.created_by_name !== c.driver_name) { %><span class="logistica-sub">Registró <%= c.created_by_name %></span><% } %>
              </td>
              <td data-label="Kilometraje" class="num"><%= formatKm(c.odometer_km) %></td>
              <td data-label="Resultado">
                <% if (anulado) { %>
                  <span class="logistica-estado logistica-estado--anulado">Anulado</span>
                <% } else { %>
                  <span class="logistica-estado logistica-estado--<%= c.result %>"><%= resultLabel(c.result) %></span>
                  <% if (c.fallas > 0) { %><span class="logistica-sub"><%= c.fallas %> <%= c.fallas === 1 ? 'falla' : 'fallas' %></span><% } %>
                <% } %>
              </td>
              <td class="logistica-tabla__acciones">
                <a href="<%= MECANICA %>/<%= c.id %>" class="logistica-icono-btn" title="Ver <%= c.number %>" aria-label="Ver <%= c.number %>"><%- include('../../../partials/icon', { name: 'file-text' }) %></a>
                <a href="<%= MECANICA %>/<%= c.id %>/pdf" target="_blank" rel="noopener" class="logistica-icono-btn" title="Imprimir <%= c.number %>" aria-label="Imprimir <%= c.number %>"><%- include('../../../partials/icon', { name: 'printer' }) %></a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% if (lista.length >= limite) { %>
      <p class="logistica-nota">Se muestran las <%= limite %> revisiones más recientes. Usa los filtros para encontrar los anteriores.</p>
    <% } %>
  <% } %>
</div>
