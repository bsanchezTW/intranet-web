<%
  const lista = Array.isArray(categorias) ? categorias : [];
  const err = errors || {};
  const v = values || {};
  const totalItems = lista.reduce((n, c) => n + c.items.length, 0);
  const totalCriticos = lista.reduce((n, c) => n + c.items.filter((i) => i.critical).length, 0);
  const plural = (n, uno, varios) => `${n} ${n === 1 ? uno : varios}`;
  // Si volvió con error, el formulario de ese lugar abre con lo escrito.
  const enFoco = (clave) => foco === clave;
%>

<% function botonMover(accion, direccion, deshabilitado, extra, etiqueta) { %>
  <form method="post" action="<%= accion %>" class="cfg-mover">
    <input type="hidden" name="direccion" value="<%= direccion %>">
    <% if (extra) { %><input type="hidden" name="categoria" value="<%= extra %>"><% } %>
    <button type="submit" class="cfg-icono"<%= deshabilitado ? ' disabled' : '' %> title="<%= etiqueta %>" aria-label="<%= etiqueta %>"><%- include('../../../partials/icon', { name: direccion === 'arriba' ? 'chevron-up' : 'chevron-down' }) %></button>
  </form>
<% } %>

<div class="contenedor">

  <div class="page-header">
    <span class="page-header__icono" aria-hidden="true"><%- include('../../../partials/icon', { name: 'settings' }) %></span>
    <div class="page-header__text">
      <nav class="page-header__migas" aria-label="Ruta de navegación">
        <a href="/procesos">Procesos y documentos</a> <span aria-hidden="true">/</span>
        <a href="<%= FLOTA %>">Gestión de flota</a> <span aria-hidden="true">/</span>
        <span>Configurar ítems</span>
      </nav>
      <h2 class="page-title">Configurar ítems</h2>
      <p class="page-description">Categorías e ítems de la revisión mecánica, en el orden en que se revisan. Los cambios valen para las revisiones nuevas; las ya registradas conservan su texto.</p>
    </div>
  </div>

  <% if (typeof success !== 'undefined' && success) { %>
    <div hidden data-toast="<%= success %>"></div>
  <% } %>
  <% if (typeof error !== 'undefined' && error) { %>
    <div hidden data-toast="<%= error %>" data-toast-tone="error"></div>
  <% } %>

  <section class="cfg-nueva" aria-labelledby="cfg-nueva-titulo">
    <div class="cfg-nueva__texto">
      <h3 class="cfg-nueva__titulo" id="cfg-nueva-titulo">
        <span class="cfg-nueva__icono" aria-hidden="true"><%- include('../../../partials/icon', { name: 'folder-plus' }) %></span>
        Agregar categoría
      </h3>
      <p class="cfg-nueva__resumen"><%= plural(lista.length, 'categoría', 'categorías') %> · <%= plural(totalItems, 'ítem', 'ítems') %> · <%= plural(totalCriticos, 'crítico', 'críticos') %></p>
    </div>
    <form method="post" action="<%= ITEMS %>/categorias" class="cfg-nueva__form">
      <div class="campo-form<%= enFoco('nueva') && err.name ? ' is-invalid' : '' %>">
        <label class="sr-only" for="nueva-categoria">Nombre de la categoría</label>
        <input type="text" id="nueva-categoria" name="name" maxlength="60" placeholder="Por ejemplo: Sistema eléctrico" value="<%= enFoco('nueva') ? v.name || '' : '' %>" required<%= enFoco('nueva') ? ' autofocus' : '' %>>
        <% if (enFoco('nueva') && err.name) { %><span class="campo-form__error"><%= err.name %></span><% } %>
      </div>
      <button type="submit" class="page-header-btn"><%- include('../../../partials/icon', { name: 'plus' }) %> Agregar categoría</button>
    </form>
  </section>

  <% if (!lista.length) { %>
    <div class="logistica-vacio">
      <span class="logistica-vacio__icono" aria-hidden="true"><%- include('../../../partials/icon', { name: 'folder' }) %></span>
      <p class="logistica-vacio__titulo">Todavía no hay categorías</p>
      <p>Agrega la primera arriba (por ejemplo, «Sistema de luces») y después sus ítems. La revisión mecánica las mostrará en este mismo orden.</p>
    </div>
  <% } %>

  <ol class="cfg-categorias">
    <% lista.forEach((c, ci) => {
         const criticos = c.items.filter((i) => i.critical).length;
         const renombrar = enFoco(`categoria-${c.id}`);
    %>
      <li class="cfg-categoria" id="categoria-<%= c.id %>">
        <header class="cfg-categoria__head">
          <span class="cfg-categoria__num" aria-hidden="true"><%= ci + 1 %></span>
          <div class="cfg-categoria__titulo">
            <h3><%= c.name %></h3>
            <span class="cfg-categoria__conteo"><%= plural(c.items.length, 'ítem', 'ítems') %><% if (criticos) { %> · <%= plural(criticos, 'crítico', 'críticos') %><% } %></span>
          </div>
          <div class="cfg-acciones">
            <% botonMover(`${ITEMS}/categorias/${c.id}/mover`, 'arriba', ci === 0, null, `Subir «${c.name}»`); %>
            <% botonMover(`${ITEMS}/categorias/${c.id}/mover`, 'abajo', ci === lista.length - 1, null, `Bajar «${c.name}»`); %>
            <details class="cfg-editar"<%= renombrar ? ' open' : '' %>>
              <summary class="cfg-icono" title="Renombrar «<%= c.name %>»" aria-label="Renombrar «<%= c.name %>»"><%- include('../../../partials/icon', { name: 'edit' }) %></summary>
              <form method="post" action="<%= ITEMS %>/categorias/<%= c.id %>" class="cfg-editar__form">
                <div class="campo-form<%= renombrar && err.name ? ' is-invalid' : '' %>">
                  <label for="nombre-<%= c.id %>">Nombre de la categoría</label>
                  <input type="text" id="nombre-<%= c.id %>" name="name" maxlength="60" value="<%= renombrar ? v.name ?? c.name : c.name %>" required>
                  <% if (renombrar && err.name) { %><span class="campo-form__error"><%= err.name %></span><% } %>
                </div>
                <button type="submit" class="page-header-btn">Guardar</button>
              </form>
            </details>
            <form method="post" action="<%= ITEMS %>/categorias/<%= c.id %>/eliminar"
                  data-confirm="<%= c.items.length ? `Se eliminará «${c.name}» con ${c.items.length === 1 ? 'su ítem' : `sus ${c.items.length} ítems`}. Las revisiones ya registradas conservan lo que se revisó.` : `Se eliminará la categoría «${c.name}».` %>"
                  data-confirm-title="¿Eliminar la categoría?" data-confirm-accept="Eliminar" data-confirm-tone="peligro">
              <button type="submit" class="cfg-icono cfg-icono--peligro" title="Eliminar «<%= c.name %>»" aria-label="Eliminar «<%= c.name %>»"><%- include('../../../partials/icon', { name: 'trash' }) %></button>
            </form>
          </div>
        </header>

        <% if (!c.items.length) { %>
          <p class="cfg-categoria__vacia">Esta categoría todavía no tiene ítems.</p>
        <% } else { %>
          <ol class="cfg-items">
            <% c.items.forEach((item, ii) => { const editar = enFoco(`item-${item.id}`); %>
              <li class="cfg-item">
                <span class="cfg-item__num" aria-hidden="true"><%= ii + 1 %></span>
                <span class="cfg-item__texto">
                  <%= item.label %>
                  <% if (item.critical) { %><span class="logistica-estado logistica-estado--critico">Crítico</span><% } %>
                </span>
                <div class="cfg-acciones">
                  <% botonMover(`${ITEMS}/${item.id}/mover`, 'arriba', ii === 0, c.id, `Subir «${item.label}»`); %>
                  <% botonMover(`${ITEMS}/${item.id}/mover`, 'abajo', ii === c.items.length - 1, c.id, `Bajar «${item.label}»`); %>
                  <details class="cfg-editar"<%= editar ? ' open' : '' %>>
                    <summary class="cfg-icono" title="Editar «<%= item.label %>»" aria-label="Editar «<%= item.label %>»"><%- include('../../../partials/icon', { name: 'edit' }) %></summary>
                    <form method="post" action="<%= ITEMS %>/<%= item.id %>" class="cfg-editar__form">
                      <input type="hidden" name="categoria" value="<%= c.id %>">
                      <div class="campo-form<%= editar && err.label ? ' is-invalid' : '' %>">
                        <label for="item-<%= item.id %>">Ítem</label>
                        <input type="text" id="item-<%= item.id %>" name="label" maxlength="160" value="<%= editar ? v.label ?? item.label : item.label %>" required>
                        <% if (editar && err.label) { %><span class="campo-form__error"><%= err.label %></span><% } %>
                      </div>
                      <label class="plantilla-check"><input type="checkbox" name="critical" value="1"<%= (editar ? v.critical : item.critical) ? ' checked' : '' %>> Crítico: un «No» deja el vehículo no apto</label>
                      <button type="submit" class="page-header-btn">Guardar</button>
                    </form>
                  </details>
                  <form method="post" action="<%= ITEMS %>/<%= item.id %>/eliminar"
                        data-confirm="Se eliminará «<%= item.label %>» de las revisiones nuevas. Las ya registradas lo conservan."
                        data-confirm-title="¿Eliminar el ítem?" data-confirm-accept="Eliminar" data-confirm-tone="peligro">
                    <input type="hidden" name="categoria" value="<%= c.id %>">
                    <button type="submit" class="cfg-icono cfg-icono--peligro" title="Eliminar «<%= item.label %>»" aria-label="Eliminar «<%= item.label %>»"><%- include('../../../partials/icon', { name: 'trash' }) %></button>
                  </form>
                </div>
              </li>
            <% }) %>
          </ol>
        <% } %>

        <% const nuevo = enFoco(`nuevo-${c.id}`); %>
        <form method="post" action="<%= ITEMS %>/categorias/<%= c.id %>/items" class="cfg-agregar">
          <div class="campo-form<%= nuevo && err.label ? ' is-invalid' : '' %>">
            <label class="sr-only" for="nuevo-<%= c.id %>">Nuevo ítem en «<%= c.name %>»</label>
            <input type="text" id="nuevo-<%= c.id %>" name="label" maxlength="160" placeholder="Nuevo ítem en «<%= c.name %>»" value="<%= nuevo ? v.label || '' : '' %>" required<%= nuevo ? ' autofocus' : '' %>>
            <% if (nuevo && err.label) { %><span class="campo-form__error"><%= err.label %></span><% } %>
          </div>
          <label class="plantilla-check"><input type="checkbox" name="critical" value="1"<%= nuevo && v.critical ? ' checked' : '' %>> Crítico</label>
          <button type="submit" class="page-header-btn page-header-btn--secundario"><%- include('../../../partials/icon', { name: 'plus' }) %> Agregar ítem</button>
        </form>
      </li>
    <% }) %>
  </ol>
</div>
