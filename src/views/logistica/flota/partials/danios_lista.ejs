<%# REVISIÓN FÍSICA DESHABILITADA (2026-11-10). Ver docs/REACTIVAR-REVISION-FISICA.md
<_%
  /*
    Lista de daños: miniatura, zona, tipo, observación y estado, con enlace
    al daño (donde se ven las fotos y se marca reparado).
      danios     filas de physicalService (getDamage / listDamages)
      conZona    agrega «Ver en el modelo» (sólo en la página de revisión física)
      sinOrigen  no repite la revisión de origen (en el detalle de esa revisión)
  */
  const lista = Array.isArray(danios) ? danios : [];
  const verZona = typeof conZona !== 'undefined' && conZona;
  const ocultarOrigen = typeof sinOrigen !== 'undefined' && sinOrigen;
  const ESTADO_CLASE = { abierto: 'no_apto', reparado: 'apto', anulado: 'anulado' };
%_>
<ul class="danios">
  <_% lista.forEach((d) => { const foto = (d.damage_photos || [])[0]; const fotoRep = (d.repair_photos || [])[0]; %_>
    <li class="danio-fila is-<_%= d.status %_>">
      <a class="danio-fila__foto" href="<_%= DANIOS %_>/<_%= d.id %_>" tabindex="-1" aria-hidden="true">
        <_% if (foto) { %_>
          <img src="<_%= FOTOS %_>/<_%= (d.status === 'reparado' && fotoRep ? fotoRep : foto).id %_>" alt="" loading="lazy" decoding="async">
        <_% } else { %_>
          <_%- include('../../../partials/icon', { name: 'image' }) %_>
        <_% } %_>
        <_% if ((d.damage_photos || []).length > 1) { %_><span class="danio-fila__mas">+<_%= d.damage_photos.length - 1 %_></span><_% } %_>
      </a>
      <div class="danio-fila__texto">
        <a class="danio-fila__zona" href="<_%= DANIOS %_>/<_%= d.id %_>"><_%= d.zone_label %_></a>
        <span class="danio-fila__tipo"><_%= damageTypeLabel(d.damage_type) %_></span>
        <p class="danio-fila__desc"><_%= d.description %_></p>
        <p class="danio-fila__meta">
          <_% if (d.status === 'reparado') { %_>
            Reparado el <_%= formatDate(d.repaired_on) %_><_% if (d.repaired_by_name) { %_> · <_%= d.repaired_by_name %_><_% } %_>
          <_% } else if (!ocultarOrigen) { %_>
            Desde <_%= d.review_number %_> · <_%= formatDate(d.review_date) %_>
          <_% } else if (d.status === 'anulado') { %_>
            Anulado con la revisión
          <_% } else { %_>
            Abierto
          <_% } %_>
        </p>
      </div>
      <div class="danio-fila__acciones">
        <span class="logistica-estado logistica-estado--<_%= ESTADO_CLASE[d.status] || 'anulado' %_>"><_%= damageStateLabel(d.status) %_></span>
        <_% if (verZona) { %_>
          <button type="button" class="cfg-icono" data-zona="<_%= d.zone_code %_>" title="Ver en el modelo" aria-label="Ver <_%= d.zone_label %_> en el modelo"><_%- include('../../../partials/icon', { name: 'search' }) %_></button>
        <_% } %_>
      </div>
    </li>
  <_% }) %_>
</ul>

%>
