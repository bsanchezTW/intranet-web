<%
/*
  Silueta lateral del tipo de vehículo (minivan, pickup, camión), para las
  tarjetas de la flota y la elección de tipo. Uso:
    include('../partials/silueta', { tipo: 'pickup' })
  Hereda el color (currentColor); un tipo desconocido dibuja un signo de
  pregunta (vehículos de la primera versión con el tipo por definir).
*/
const SILUETAS = {
  minivan: `
    <path class="silueta__cuerpo" d="M8 36V23c0-4 2-7 6-9l9-6c2-1 4-2 7-2h70c5 0 8 3 9 8l3 13v9z"/>
    <path class="silueta__vidrio" d="M24 12l6-3h14v11H17zM48 9h18v11H48zM70 9h16c3 0 4 2 5 4l2 7H70z"/>
    <path class="silueta__linea" d="M46 22v13M68 22v13M8 30h104"/>`,
  pickup: `
    <path class="silueta__cuerpo" d="M8 36V25c0-3 2-5 5-6l11-3 9-9c1-1 3-2 5-2h20c2 0 3 1 4 3l5 11h45v17z"/>
    <path class="silueta__vidrio" d="M30 16l7-7h9v9H28zM50 9h8l4 9H50z"/>
    <path class="silueta__linea" d="M67 19v17M67 23h45M8 30h104"/>`,
  camion: `
    <path class="silueta__cuerpo" d="M6 38V20c0-3 1-5 3-7l6-8c1-1 2-1 3-1h18v34z"/>
    <rect class="silueta__cuerpo" x="40" y="3" width="74" height="31" rx="2"/>
    <path class="silueta__vidrio" d="M12 13l5-6h13v10H10z"/>
    <path class="silueta__linea" d="M36 38h78M6 28h30"/>`,
};
const RUEDAS = {
  minivan: [[28, 37], [94, 37]],
  pickup: [[28, 37], [94, 37]],
  camion: [[20, 39], [80, 39], [97, 39]],
};
const conocido = Object.prototype.hasOwnProperty.call(SILUETAS, tipo);
const claseExtra = (typeof clase !== 'undefined' && clase) ? ' ' + clase : '';
%><svg class="silueta<%= claseExtra %>" viewBox="0 0 120 46" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true" focusable="false"><% if (conocido) { %><%- SILUETAS[tipo] %><% RUEDAS[tipo].forEach(([cx, cy]) => { %><circle class="silueta__rueda" cx="<%= cx %>" cy="<%= cy %>" r="6"/><circle cx="<%= cx %>" cy="<%= cy %>" r="2"/><% }) %><% } else { %><rect class="silueta__cuerpo" x="8" y="6" width="104" height="30" rx="8" stroke-dasharray="4 4"/><path d="M54 16a6 6 0 1 1 8 6c-2 1-2 2-2 4M60 31h.01"/><% } %></svg>
