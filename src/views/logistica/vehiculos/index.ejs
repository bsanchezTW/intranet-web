<%
  const lista = Array.isArray(flota) ? flota : [];
  const activos = lista.filter((x) => x.active);
  const conAlertas = activos.filter((x) => documentAlerts(x, today).some((a) => a.state === 'vencido')).length;
%>

<div class="contenedor">

  <div class="page-header">
    <span class="page-header__icono" aria-hidden="true"><%- include('../../partials/icon', { name: 'truck' }) %></span>
    <div class="page-header__text">
      <nav class="page-header__migas" aria-label="Ruta de navegación">
        <a href="/procesos">Procesos y documentos</a> <span aria-hidden="true">/</span>
        <a href="/procesos#seccion-logistica">Logística</a>
      </nav>
      <h2 class="page-title">Flota de vehículos</h2>
      <p class="page-description">
        <%= activos.length %> <%= activos.length === 1 ? 'vehículo activo' : 'vehículos activos' %><% if (conAlertas) { %> · <%= conAlertas %> con documentos vencidos<% } %>
      </p>
    </div>
    <div class="page-header-actions">
      <a href="/logistica/checklists" class="page-header-btn page-header-btn--secundario"><%- include('../../partials/icon', { name: 'clipboard-check' }) %> Checklists</a>
      <% if (puedeAdministrar) { %>
        <a href="/logistica/vehiculos/nuevo" class="page-header-btn"><%- include('../../partials/icon', { name: 'plus' }) %> Agregar vehículo</a>
      <% } %>
    </div>
  </div>

  <% if (success) { %>
    <div hidden data-toast="<%= success %>"></div>
  <% } %>
  <% if (error) { %>
    <div hidden data-toast="<%= error %>" data-toast-tone="error"></div>
  <% } %>

  <% if (!lista.length) { %>
    <div class="logistica-vacio">
      <span class="logistica-vacio__icono" aria-hidden="true"><%- include('../../partials/icon', { name: 'truck' }) %></span>
      <p class="logistica-vacio__titulo">La flota está vacía</p>
      <p>Agrega los vehículos de la empresa con su patente y los vencimientos de sus documentos.</p>
      <% if (puedeAdministrar) { %>
        <a href="/logistica/vehiculos/nuevo" class="page-header-btn"><%- include('../../partials/icon', { name: 'plus' }) %> Agregar el primero</a>
      <% } %>
    </div>
  <% } else { %>
    <div class="logistica-tabla-wrap">
      <table class="logistica-tabla logistica-tabla--tarjetas">
        <thead>
          <tr>
            <th scope="col">Patente</th>
            <th scope="col">Vehículo</th>
            <th scope="col" class="num">Kilometraje</th>
            <th scope="col">Documentos</th>
            <th scope="col">Último checklist</th>
            <th scope="col"><span class="sr-only">Acciones</span></th>
          </tr>
        </thead>
        <tbody>
          <% lista.forEach((x) => { const alertas = documentAlerts(x, today); %>
            <tr class="<%= x.active ? '' : 'is-inactivo' %>">
              <td data-label="Patente">
                <span class="logistica-patente"><%= x.plate %></span>
                <% if (!x.active) { %><span class="logistica-sub">De baja</span><% } %>
              </td>
              <td data-label="Vehículo">
                <%= vehicleLabel(x) || '—' %>
                <span class="logistica-sub"><%= labelFrom(VEHICLE_KINDS, x.kind) %></span>
              </td>
              <td data-label="Kilometraje" class="num"><%= formatKm(x.odometer_km) %></td>
              <td data-label="Documentos">
                <% if (!x.technical_review_due && !x.circulation_permit_due && !x.insurance_due) { %>
                  <span class="logistica-sub">Sin vencimientos cargados</span>
                <% } else if (!alertas.length) { %>
                  <span class="logistica-estado logistica-estado--apto">Al día</span>
                <% } else { %>
                  <div class="logistica-alertas">
                    <% alertas.forEach((a) => { %>
                      <span class="logistica-alerta logistica-alerta--<%= a.state %>" title="<%= a.state === 'vencido' ? 'Venció' : 'Vence' %> el <%= formatDate(a.due) %>"><%= a.label %></span>
                    <% }) %>
                  </div>
                <% } %>
              </td>
              <td data-label="Último checklist">
                <% if (x.last_checklist_date) { %>
                  <a href="/logistica/checklists?vehiculo=<%= x.id %>"><%= formatDate(x.last_checklist_date) %></a>
                <% } else { %>
                  <span class="logistica-sub">Sin registros</span>
                <% } %>
              </td>
              <td class="logistica-tabla__acciones">
                <% if (x.active && puedeRevisar) { %>
                  <a href="/logistica/checklists/nuevo?vehiculo=<%= x.id %>" class="logistica-icono-btn" title="Registrar checklist de <%= x.plate %>" aria-label="Registrar checklist de <%= x.plate %>"><%- include('../../partials/icon', { name: 'clipboard-check' }) %></a>
                <% } %>
                <% if (puedeAdministrar) { %>
                  <a href="/logistica/vehiculos/<%= x.id %>/editar" class="logistica-icono-btn" title="Editar <%= x.plate %>" aria-label="Editar <%= x.plate %>"><%- include('../../partials/icon', { name: 'edit' }) %></a>
                  <form method="post" action="/logistica/vehiculos/<%= x.id %>/estado"
                        <% if (x.active) { %>data-confirm="<%= x.plate %> dejará de aparecer al registrar checklists. Sus registros anteriores se conservan." data-confirm-title="¿Dar de baja el vehículo?" data-confirm-accept="Dar de baja" data-confirm-tone="peligro"<% } %>>
                    <input type="hidden" name="activo" value="<%= x.active ? '0' : '1' %>">
                    <button type="submit" class="logistica-icono-btn<%= x.active ? ' logistica-icono-btn--peligro' : '' %>" title="<%= x.active ? 'Dar de baja' : 'Reactivar' %> <%= x.plate %>" aria-label="<%= x.active ? 'Dar de baja' : 'Reactivar' %> <%= x.plate %>"><%- include('../../partials/icon', { name: x.active ? 'archive' : 'repeat' }) %></button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
