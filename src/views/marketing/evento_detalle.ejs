<%
/* Galería: detalle de un evento. Estilos en /css/galeria.css y lógica en
   /js/galeria-evento.js (slider, mosaico, visor y subida). */
const items = (imagenes || []).map((item) => ({
  url: item.url,
  public_id: item.public_id,
  tipo: item.resource_type === 'video' ? 'video' : 'image',
}));
const totalFotos = items.filter((i) => i.tipo === 'image').length;
const totalVideos = items.length - totalFotos;
const fechaEvento = (() => {
  const fecha = new Date(evento.created_at);
  if (Number.isNaN(fecha.getTime())) return '';
  return fecha.toLocaleDateString(countryConfig.locale, {
    day: 'numeric', month: 'long', year: 'numeric', timeZone: countryConfig.timezone,
  });
})();
const fondoHero = evento.image || (items.find((i) => i.tipo === 'image') || {}).url || '';
const datosGaleria = {
  slug: evento.slug,
  portada: evento.image || '',
  puedeEditar: Boolean(can.eventos_write),
  items,
};
const plural = (n, uno, varios) => `${n} ${n === 1 ? uno : varios}`;
%>
<div class="contenedor galeria galeria-evento">
  <section class="galeria-hero<%= fondoHero ? '' : ' galeria-hero--sin-fotos' %>" id="galeriaHero"
           aria-roledescription="carrusel" aria-label="Fotos destacadas de <%= evento.name %>">
    <div class="galeria-hero__viewport" id="galeriaHeroViewport">
      <% if (fondoHero) { %>
        <div class="galeria-hero__slide is-active">
          <img src="<%= fondoHero %>" alt="" decoding="async">
        </div>
      <% } %>
    </div>

    <div class="galeria-hero__velo" aria-hidden="true"></div>

    <a href="/marketing/eventos" class="galeria-hero__volver">
      <%- include('../partials/icon', { name: 'arrow-left' }) %> Galería
    </a>

    <div class="galeria-hero__contenido">
      <p class="galeria-hero__eyebrow">
        <span>Galería</span>
        <% if (fechaEvento) { %><span aria-hidden="true">·</span><span><%= fechaEvento %></span><% } %>
      </p>
      <div class="galeria-hero__titular">
        <h1 class="galeria-hero__titulo" id="galeriaTitulo"><%= evento.name %></h1>
        <% if (can.eventos_write) { %>
          <button type="button" class="galeria-hero__editar" data-abrir-modal-evento
                  aria-label="Editar evento" title="Editar evento">
            <%- include('../partials/icon', { name: 'edit' }) %>
          </button>
        <% } %>
      </div>
      <% if (evento.description) { %>
        <p class="galeria-hero__desc"><%= evento.description %></p>
      <% } %>
      <div class="galeria-hero__chips">
        <% if (evento.is_private) { %>
          <span class="galeria-chip">Privado</span>
        <% } %>
        <span class="galeria-chip" data-contador="image">
          <%- include('../partials/icon', { name: 'image' }) %> <span><%= plural(totalFotos, 'foto', 'fotos') %></span>
        </span>
        <% if (totalVideos) { %>
          <span class="galeria-chip" data-contador="video">
            <%- include('../partials/icon', { name: 'video' }) %> <span><%= plural(totalVideos, 'video', 'videos') %></span>
          </span>
        <% } %>
      </div>
    </div>

    <div class="galeria-hero__controles" id="galeriaHeroControles" hidden>
      <button type="button" class="galeria-hero__nav" data-hero-mover="-1" aria-label="Foto anterior">
        <svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      <div class="galeria-hero__dots" id="galeriaHeroDots" role="tablist" aria-label="Elegir foto"></div>
      <button type="button" class="galeria-hero__nav" data-hero-mover="1" aria-label="Foto siguiente">
        <svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
    </div>
  </section>

  <section class="galeria-seccion" aria-labelledby="galeriaFotosTitulo">
    <div class="galeria-seccion__head">
      <h2 class="galeria-seccion__titulo" id="galeriaFotosTitulo">Fotos y videos</h2>
      <span class="galeria-seccion__meta" id="galeriaTotal"><%= plural(items.length, 'archivo', 'archivos') %></span>
    </div>

    <div class="galeria-mosaico" id="galeriaMosaico" <%= items.length ? '' : 'hidden' %>>
      <% items.forEach(function (item, index) { %>
        <button type="button" class="galeria-tile is-cargando<%= item.tipo === 'video' ? ' galeria-tile--video' : '' %>"
                data-index="<%= index %>" data-public-id="<%= item.public_id %>"
                aria-label="<%= item.tipo === 'video' ? 'Ver video' : 'Ver foto' %> <%= index + 1 %> de <%= items.length %>">
          <% if (item.tipo === 'video') { %>
            <video data-src="<%= item.url %>#t=0.5" muted playsinline preload="none" tabindex="-1"></video>
            <span class="galeria-tile__play" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor" aria-hidden="true"><polygon points="7 4 20 12 7 20 7 4"/></svg>
            </span>
          <% } else { %>
            <img data-src="<%= item.url %>" alt="" decoding="async">
          <% } %>
          <span class="galeria-tile__portada"<%= item.url === evento.image ? '' : ' hidden' %>>Portada</span>
        </button>
      <% }) %>
    </div>

    <div class="galeria-vacio galeria-vacio--compacto" id="galeriaVacio" <%= items.length ? 'hidden' : '' %>>
      <span class="galeria-vacio__icono"><%- include('../partials/icon', { name: 'camera' }) %></span>
      <h3 class="galeria-vacio__titulo">Todavía no hay fotos</h3>
      <p class="galeria-vacio__texto">
        <%= can.eventos_write
          ? 'Agrega las primeras fotos o videos desde el recuadro de abajo.'
          : 'Pronto se publicarán las fotos de este evento.' %>
      </p>
    </div>
  </section>

  <% if (can.eventos_write) { %>
  <section class="galeria-seccion galeria-subida" aria-labelledby="galeriaSubidaTitulo">
    <div class="galeria-seccion__head">
      <h2 class="galeria-seccion__titulo" id="galeriaSubidaTitulo">Agregar fotos y videos</h2>
    </div>

    <div class="galeria-dropzone" id="galeriaDropzone" tabindex="0" role="button"
         aria-label="Agregar fotos o videos: arrástralos aquí o pulsa para elegirlos">
      <span class="galeria-dropzone__icono"><%- include('../partials/icon', { name: 'upload-cloud' }) %></span>
      <strong class="galeria-dropzone__titulo">Arrastra fotos o videos aquí</strong>
      <span class="galeria-dropzone__texto">o <span class="galeria-dropzone__link">haz clic para elegirlos</span></span>
      <span class="galeria-dropzone__nota">Imágenes hasta 10 MB · videos hasta 100 MB · máx. 150 archivos por vez</span>
    </div>
    <input type="file" id="galeriaArchivos" multiple accept="image/*,video/*" hidden>

    <div class="galeria-cola" id="galeriaCola" hidden>
      <div class="galeria-cola__head">
        <span class="galeria-cola__estado" id="galeriaColaEstado" aria-live="polite"></span>
        <span class="galeria-cola__porcentaje" id="galeriaColaPorcentaje">0%</span>
      </div>
      <div class="galeria-progreso" aria-hidden="true"><span id="galeriaProgreso"></span></div>
      <ul class="galeria-cola__lista" id="galeriaColaLista"></ul>
      <div class="galeria-cola__acciones">
        <button type="button" class="galeria-btn galeria-btn--secundario" id="galeriaColaLimpiar">Quitar todo</button>
        <button type="button" class="galeria-btn galeria-btn--primario" id="galeriaColaSubir">Subir archivos</button>
      </div>
    </div>
  </section>
  <% } %>
</div>

<script type="application/json" id="galeriaDatos"><%- JSON.stringify(datosGaleria).replace(/</g, '\\u003c') %></script>

<% if (can.eventos_write) { %>
  <%- include('partials/modal-evento', { modo: 'editar', evento, imagenes }) %>
<% } %>
