<%
// Fechas, autor, iniciales y tiempo de lectura llegan resueltos desde
// noticiaPresenter (ver routes/noticias.js); la vista solo compone.
//
// Reparto de columnas: a la izquierda solo la noticia (titular, portada, cuerpo
// y adjuntos incrustados); todo lo demás —volver, ficha del autor, índice de
// documentos, relacionadas y administración— vive en la columna lateral.
const puedeEscribir = typeof can !== 'undefined' && can.noticias_write;
const relacionadasNoticia = typeof relacionadas !== 'undefined' ? relacionadas : [];

const AVISOS_OK = {
  correo_enviado: destinatarios
    ? `Aviso enviado a ${destinatarios} destinatario${destinatarios === '1' ? '' : 's'}.`
    : 'Aviso enviado por correo.',
  destacada_marcada: 'La noticia quedó destacada en el inicio.',
  destacada_quitada: 'La noticia ya no está destacada.',
  noticia_actualizada: 'Los cambios se guardaron correctamente.',
};

const AVISOS_ERROR = {
  sin_seleccion: 'Selecciona al menos un destinatario antes de enviar.',
  sin_destinatarios: 'Ningún destinatario tiene correo registrado.',
  correo_fallido: 'No se pudo enviar el correo. Inténtalo nuevamente.',
  destacada_fallida: 'No se pudo actualizar la noticia destacada.',
};

const mensajeOk = ok ? (AVISOS_OK[ok] || ok) : null;
const mensajeError = error ? (AVISOS_ERROR[error] || 'Ocurrió un error inesperado.') : null;

function formatNewsDate(fecha) {
  const d = new Date(fecha);
  if (Number.isNaN(d.getTime())) return '';
  const dia = d.getDate();
  const mes = d.toLocaleString(countryConfig.locale, { month: 'short' });
  return `${dia} ${mes.replace('.', '')}`.toUpperCase();
}
%>

<div class="contenedor articulo">

  <% if (mensajeOk) { %>
    <div class="nt-aviso nt-aviso--ok" role="status">
      <%- include('../partials/icon', { name: 'sparkles' }) %>
      <span><%= mensajeOk %></span>
    </div>
  <% } %>

  <% if (mensajeError) { %>
    <div class="nt-aviso nt-aviso--error" role="alert">
      <%- include('../partials/icon', { name: 'alert-triangle' }) %>
      <span><%= mensajeError %></span>
    </div>
  <% } %>

  <div class="articulo__layout">

    <%# Fuera del <aside> a propósito: la rejilla lo coloca sobre la columna
        lateral en escritorio y, al apilarse, queda al inicio de la página en
        vez de quedar enterrado bajo el artículo. %>
    <a href="/noticias" class="aside-volver">
      <span aria-hidden="true">←</span> Volver a noticias
    </a>

    <article class="articulo__principal">

      <%# Misma card que home y listado: degradado o portada, título y bajada dentro. %>
      <%- include('../partials/noticia-featured-card', {
        interactive: false,
        headingLevel: 1,
        href: '',
        image: noticia.image,
        title: noticia.title,
        subtitle: noticia.subtitle,
        datetime: noticia.fechaISO,
        dateLabel: formatNewsDate(noticia.created_at || noticia.fechaISO),
        chipsText: (noticia.resumen && noticia.resumen.chips && noticia.resumen.chips.length)
          ? noticia.resumen.chips.map(c => c.text).join(' · ')
          : '',
        showBadge: Boolean(noticia.featured),
        extraClass: 'home-featured--articulo',
        imageLoading: 'eager'
      }) %>

      <%# ---------- Cuerpo ---------- %>
      <% if (noticia.content) { %>
        <div class="articulo__cuerpo"><%- noticia.content %></div>
      <% } %>

      <%# ---------- Archivos renderizados como contenido ---------- %>
      <% if (adjuntos.length) { %>
        <%- include('partials/media-bloques', { adjuntos: adjuntos }) %>
      <% } %>

      <%# ---------- Administración: al pie de la noticia ---------- %>
      <% if (puedeEscribir) { %>
        <section class="articulo__admin">
          <div class="articulo__admin-cabecera">
            <h2 class="articulo__admin-titulo">Administración</h2>
            <p class="articulo__admin-ayuda">Solo visible para administradores.</p>
          </div>

          <div class="articulo__admin-acciones">
            <button type="button" class="btn-nt" onclick="abrirModalEditarNoticia(NoticiaDetalleData)">
              <%- include('../partials/icon', { name: 'edit' }) %>
              Editar
            </button>

            <form action="/noticias/destacar/<%= noticia.id %>" method="POST"
                  <%= noticia.featured ? '' : 'data-confirmar="¿Marcar esta noticia como destacada en el inicio? Reemplazará a la destacada actual."' %>>
              <% if (noticia.featured) { %><input type="hidden" name="quitar" value="1"><% } %>
              <button type="submit" class="btn-nt">
                <%- include('../partials/icon', { name: 'sparkles' }) %>
                <%= noticia.featured ? 'Quitar destacada' : 'Destacar' %>
              </button>
            </form>

            <button type="button" class="btn-nt btn-nt--principal" onclick="abrirModalDestinatarios()">
              <%- include('../partials/icon', { name: 'mail' }) %>
              Enviar por correo
            </button>

            <form action="/noticias/eliminar/<%= noticia.id %>" method="POST"
                  data-confirmar="¿Eliminar esta noticia de forma permanente? También se borrarán sus archivos.">
              <button type="submit" class="btn-nt btn-nt--peligro">
                <%- include('../partials/icon', { name: 'trash' }) %>
                Eliminar
              </button>
            </form>
          </div>
        </section>
      <% } %>

    </article>

    <%- include('partials/aside-articulo', {
      noticia,
      resumen,
      adjuntos,
      relacionadas: relacionadasNoticia,
    }) %>

  </div>
</div>

<% if (puedeEscribir) { %>
  <%- include('partials/modal-noticia') %>

  <script>
    window.NoticiaDetalleData = <%- JSON.stringify({
      id: noticia.id,
      title: noticia.title,
      subtitle: noticia.subtitle || '',
      content: noticia.content,
      image: noticia.image || '',
      attachments: adjuntos
    }).replace(/</g, '\\u003c') %>;
    window.NoticiaDetalleFlags = { publicada: <%= publicada ? 'true' : 'false' %>, editar: <%= editar ? 'true' : 'false' %> };
  </script>

  <%# ---------- Modal: elegir destinatarios ---------- %>
  <div class="modal-overlay" id="modal-correo-destinatarios" role="dialog" aria-modal="true" aria-labelledby="correo-titulo" aria-hidden="true">
    <div class="modal-content modal-content--correo">
      <button type="button" class="modal-close" data-modal-close aria-label="Cerrar">&times;</button>

      <div class="correo-head">
        <h3 id="correo-titulo">Enviar por correo</h3>
        <p>El correo mostrará la noticia completa: imágenes y documentos visibles al abrir, sin descargas.</p>
      </div>

      <form id="form-correo-destinatarios" action="/noticias/enviar-correo/<%= noticia.id %>" method="POST" style="display:contents;">
        <div class="correo-body">
          <label class="correo-todos" for="correo-enviar-todos">
            <input type="checkbox" id="correo-enviar-todos" name="enviar_todos" value="1">
            <span>
              <strong>Enviar a todos los colaboradores</strong>
              <span><%= usuariosCorreo.length %> personas con correo registrado</span>
            </span>
          </label>

          <input type="search" id="correo-buscar" class="correo-buscar"
                 placeholder="Buscar por nombre, correo o área…" autocomplete="off"
                 aria-label="Buscar destinatarios">

          <div class="correo-toolbar">
            <label for="correo-seleccionar-visibles">
              <input type="checkbox" id="correo-seleccionar-visibles">
              Seleccionar todos los visibles
            </label>
            <span class="correo-contador" id="correo-contador" aria-live="polite">0 seleccionados</span>
          </div>

          <div class="correo-lista" id="correo-lista-usuarios">
              <% if (usuariosCorreo.length) { %>
              <% usuariosCorreo.forEach(function (u) {
                const nombre = [u.first_name, u.last_name].filter(Boolean).join(' ').trim() || u.email;
                const monogram = u.monogram;
                const area = u.area || '';
              %>
                <label class="correo-item" data-search="<%= [nombre, u.email, area].join(' ').toLowerCase() %>">
                  <input type="checkbox" name="usuarios" value="<%= u.id %>" class="correo-usuario-check">
                  <span class="correo-avatar monogram" style="<%= monogram.style %>" aria-hidden="true"><%= monogram.initials %></span>
                  <span class="correo-datos">
                    <span class="correo-nombre"><%= nombre %></span>
                    <span class="correo-email"><%= u.email %></span>
                  </span>
                  <% if (area) { %><span class="correo-area"><%= area %></span><% } %>
                </label>
              <% }); %>
            <% } else { %>
              <div class="correo-vacio">No hay colaboradores con correo registrado.</div>
            <% } %>
          </div>
        </div>

        <div class="correo-foot">
          <button type="button" class="btn-secundario" data-modal-close>Cancelar</button>
          <button type="submit" class="btn-primario" id="correo-btn-enviar" disabled>Enviar</button>
        </div>
      </form>
    </div>
  </div>

  <%# ---------- Modal: recién publicada ---------- %>
  <% if (publicada) { %>
    <div class="modal-overlay" id="modal-correo-publicada" role="dialog" aria-modal="true" aria-labelledby="publicada-titulo" aria-hidden="true">
      <div class="modal-content">
        <button type="button" class="modal-close" data-modal-close aria-label="Cerrar">&times;</button>
        <h3 id="publicada-titulo" class="modal-title">Noticia publicada</h3>
        <p class="modal-description">
          Ya está disponible en la intranet. ¿Quieres avisar por correo a los colaboradores?
        </p>
        <div class="modal-actions">
          <button type="button" class="btn-secundario" data-modal-close>Ahora no</button>
          <button type="button" class="btn-primario" id="btn-elegir-destinatarios">
            Elegir destinatarios
          </button>
        </div>
      </div>
    </div>
  <% } %>

  <script src="/js/noticias-detalle.js?v=20260729a" defer></script>
<% } %>
