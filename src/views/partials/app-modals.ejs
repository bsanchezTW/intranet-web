<%
  /**
   * Modales de aplicaciones (QR, instructivo PDF y, para admin, alta/edición/
   * notificación). Los comparten la vista Apps y la autoayuda de Soporte; lo
   * único que cambia es el catálogo al que se dan de alta y los textos.
   *
   * Espera: appCatalog e isAdministrador. Opcionales: modalNewTitle,
   * modalNewSubtitle, modalNamePlaceholder, modalDescPlaceholder, allowNotify.
   */
  const mCatalog = (typeof appCatalog !== 'undefined' && appCatalog) ? appCatalog : 'corporate';
  const mIsAdmin = (typeof isAdministrador !== 'undefined' && isAdministrador);
  const mAllowNotify = (typeof allowNotify === 'undefined') ? true : allowNotify;
  const mNewTitle = (typeof modalNewTitle !== 'undefined' && modalNewTitle) ? modalNewTitle : 'Ingresar nueva app';
  const mNewSubtitle = (typeof modalNewSubtitle !== 'undefined' && modalNewSubtitle)
    ? modalNewSubtitle
    : 'Completa los datos y enlaces de descarga para cada plataforma.';
  const mNamePlaceholder = (typeof modalNamePlaceholder !== 'undefined' && modalNamePlaceholder)
    ? modalNamePlaceholder
    : 'Ej: Transworld Lead App';
  const mDescPlaceholder = (typeof modalDescPlaceholder !== 'undefined' && modalDescPlaceholder)
    ? modalDescPlaceholder
    : 'Describe para qué sirve la aplicación...';
%>

<!-- Modal QR -->
<div class="modal-overlay" id="modal-qr" role="dialog" aria-modal="true" aria-labelledby="qr-titulo" aria-hidden="true">
  <div class="modal-content modal-content--sm qr-modal__content">
    <button type="button" class="modal-close" data-modal-close aria-label="Cerrar">&times;</button>
    <header class="modal-head">
      <h2 class="modal-title" id="qr-titulo">Escanea el código</h2>
      <p class="modal-subtitle">Apunta la cámara de tu teléfono a este código para instalar la aplicación.</p>
    </header>
    <div class="modal-body">
      <div class="qr-modal__card">
        <img id="qr-imagen" src="" alt="Código QR de instalación">
      </div>
    </div>
    <footer class="modal-foot">
      <a id="qr-btn-enlace" href="#" target="_blank" rel="noopener noreferrer" class="btn-secundario" style="display: none;">Ir al enlace directo</a>
      <button type="button" id="qr-btn-descarga" class="btn-primario" onclick="forzarDescargaQR()">Descargar imagen QR</button>
    </footer>
  </div>
</div>

<!-- Modal PDF instructivo iOS/iPad -->
<div class="modal-overlay" id="modal-pdf" role="dialog" aria-modal="true" aria-labelledby="pdf-titulo" aria-hidden="true">
  <div class="modal-content modal-content--xl pdf-modal__content">
    <button type="button" class="modal-close" data-modal-close aria-label="Cerrar">&times;</button>
    <header class="modal-head">
      <h2 class="modal-title" id="pdf-titulo">Instructivo iOS/iPad</h2>
      <p class="modal-subtitle">Guía de instalación y uso</p>
    </header>
    <div class="modal-body modal-body--flush pdf-modal__body">
      <iframe id="pdf-iframe" title="Visor de instructivo PDF" loading="lazy"></iframe>
    </div>
    <footer class="modal-foot">
      <a id="pdf-btn-abrir" href="#" target="_blank" rel="noopener noreferrer" class="btn-secundario">Abrir en pestaña</a>
      <button type="button" class="btn-primario" data-modal-close>Cerrar</button>
    </footer>
  </div>
</div>

<% if (mIsAdmin) { %>

<!-- Modal Nueva App -->
<div class="modal-overlay" id="modal-nueva" role="dialog" aria-modal="true" aria-labelledby="nueva-titulo" aria-hidden="true">
  <div class="modal-content modal-content--xl app-modal__content">
    <button type="button" class="modal-close" data-modal-close aria-label="Cerrar">&times;</button>
    <form action="/apps/nueva" method="POST" enctype="multipart/form-data">
      <input type="hidden" name="catalog" value="<%= mCatalog %>">
      <header class="modal-head">
        <h2 class="modal-title" id="nueva-titulo"><%= mNewTitle %></h2>
        <p class="modal-subtitle"><%= mNewSubtitle %></p>
      </header>

      <div class="modal-body modal-body--split">
        <div class="modal-aside">
          <div class="campo-form app-icon-upload">
            <span class="campo-form__label">Icono de la aplicación</span>
            <div class="app-icon-preview-wrap">
              <div class="app-icon-preview" id="nueva-icon-preview">
                <img id="nueva-icon-preview-img" alt="" hidden>
                <div class="app-icon-placeholder" id="nueva-icon-placeholder">
                  <span>AA</span>
                </div>
              </div>
              <div class="app-icon-actions">
                <button type="button" class="btn-secundario" id="nueva-icon-select">Subir icono</button>
                <span class="campo-form__ayuda">JPG, PNG o WebP · Máx. 5 MB</span>
              </div>
            </div>
            <input type="file" id="nueva-icon" name="icon" accept="image/*" hidden>
          </div>

          <div class="campo-form">
            <label for="nueva-nombre">Nombre de la aplicación <span class="required-mark">*</span></label>
            <input type="text" id="nueva-nombre" name="name" required placeholder="<%= mNamePlaceholder %>">
          </div>
          <div class="campo-form">
            <label for="nueva-desc">Descripción <span class="required-mark">*</span></label>
            <textarea id="nueva-desc" name="description" rows="5" required placeholder="<%= mDescPlaceholder %>"></textarea>
          </div>
        </div>

        <div class="modal-main">
          <p class="modal-section__title">Descargas por plataforma</p>

          <div class="app-platform">
            <h3 class="app-platform__head"><%- include('platform-logo', { name: 'windows' }) %> Windows</h3>
            <div class="campo-form">
              <label for="nueva-pc">Enlace de descarga <span class="campo-form__opcional">(opcional)</span></label>
              <input type="url" name="url_pc" id="nueva-pc" placeholder="Link de descarga (ej. MediaFire)">
            </div>
          </div>

          <div class="app-platform">
            <h3 class="app-platform__head"><%- include('platform-logo', { name: 'android' }) %> Android</h3>
            <div class="campo-form">
              <label for="nueva-apk">Enlace versión APK <span class="campo-form__opcional">(opcional)</span></label>
              <input type="url" name="url_apk" id="nueva-apk" placeholder="Link de descarga (ej. MediaFire)">
              <span class="campo-form__ayuda">El código QR se generará automáticamente al mostrar la app.</span>
            </div>
          </div>

          <div class="app-platform">
            <h3 class="app-platform__head"><%- include('platform-logo', { name: 'apple' }) %> iOS/iPad</h3>
            <div class="campo-form">
              <label for="nueva-ios-pdf">Instructivo PDF <span class="campo-form__opcional">(opcional)</span></label>
              <input type="file" name="instructivo_ios" id="nueva-ios-pdf" accept="application/pdf,.pdf">
              <span class="campo-form__ayuda">Se mostrará en un visor al tocar el botón iOS/iPad. Máx. 20 MB.</span>
            </div>
          </div>

          <div class="app-platform">
            <h3 class="app-platform__head"><%- include('platform-logo', { name: 'web' }) %> Web</h3>
            <div class="campo-form">
              <label for="nueva-web">Enlace web <span class="campo-form__opcional">(opcional)</span></label>
              <input type="url" name="url_web" id="nueva-web" placeholder="URL de la versión web">
            </div>
          </div>
        </div>
      </div>

      <footer class="modal-foot">
        <button type="button" class="btn-secundario" data-modal-close>Cancelar</button>
        <button type="submit" class="btn-primario">Guardar app</button>
      </footer>
    </form>
  </div>
</div>

<!-- Modal Editar App -->
<div class="modal-overlay" id="modal-editar" role="dialog" aria-modal="true" aria-labelledby="editar-titulo" aria-hidden="true">
  <div class="modal-content modal-content--xl app-modal__content">
    <button type="button" class="modal-close" data-modal-close aria-label="Cerrar">&times;</button>
    <form id="form-editar" method="POST" enctype="multipart/form-data">
      <header class="modal-head">
        <h2 class="modal-title" id="editar-titulo">Editar aplicación</h2>
        <p class="modal-subtitle">Actualiza la información y los enlaces de descarga de la aplicación.</p>
      </header>

      <div class="modal-body modal-body--split">
        <div class="modal-aside">
          <div class="campo-form app-icon-upload">
            <span class="campo-form__label">Icono de la aplicación</span>
            <div class="app-icon-preview-wrap">
              <div class="app-icon-preview" id="edit-icon-preview">
                <img id="edit-icon-preview-img" alt="" hidden>
                <div class="app-icon-placeholder" id="edit-icon-placeholder">
                  <span id="edit-icon-initials">AA</span>
                </div>
              </div>
              <div class="app-icon-actions">
                <button type="button" class="btn-secundario" id="edit-icon-select">Subir icono</button>
                <span class="campo-form__ayuda">JPG, PNG o WebP · Máx. 5 MB</span>
              </div>
            </div>
            <input type="file" id="edit-icon" name="icon" accept="image/*" hidden>
          </div>

          <div class="campo-form">
            <label for="edit-nombre">Nombre <span class="required-mark">*</span></label>
            <input type="text" id="edit-nombre" name="name" required>
          </div>
          <div class="campo-form">
            <label for="edit-desc">Descripción <span class="required-mark">*</span></label>
            <textarea id="edit-desc" name="description" rows="5" required></textarea>
          </div>
        </div>

        <div class="modal-main">
          <p class="modal-section__title">Descargas por plataforma</p>

          <div class="app-platform">
            <h3 class="app-platform__head"><%- include('platform-logo', { name: 'windows' }) %> Windows</h3>
            <div class="campo-form">
              <label for="edit-pc">Enlace de descarga <span class="campo-form__opcional">(opcional)</span></label>
              <input type="url" name="url_pc" id="edit-pc">
            </div>
          </div>

          <div class="app-platform">
            <h3 class="app-platform__head"><%- include('platform-logo', { name: 'android' }) %> Android</h3>
            <div class="campo-form">
              <label for="edit-apk">Enlace versión APK <span class="campo-form__opcional">(opcional)</span></label>
              <input type="url" name="url_apk" id="edit-apk">
              <span class="campo-form__ayuda">El código QR se generará automáticamente al mostrar la app.</span>
            </div>
          </div>

          <div class="app-platform">
            <h3 class="app-platform__head"><%- include('platform-logo', { name: 'apple' }) %> iOS/iPad</h3>
            <div class="campo-form">
              <label for="edit-ios-pdf">Instructivo PDF <span class="campo-form__opcional">(opcional)</span></label>
              <p id="edit-ios-actual" class="campo-form__ayuda app-ios-current" hidden>
                Instructivo actual:
                <button type="button" id="edit-ios-ver" class="app-ios-current__link">Ver PDF</button>
              </p>
              <input type="file" name="instructivo_ios" id="edit-ios-pdf" accept="application/pdf,.pdf">
              <span class="campo-form__ayuda">Sube un PDF nuevo solo si quieres reemplazar el actual. Máx. 20 MB.</span>
            </div>
          </div>

          <div class="app-platform">
            <h3 class="app-platform__head"><%- include('platform-logo', { name: 'web' }) %> Web</h3>
            <div class="campo-form">
              <label for="edit-web">Enlace web <span class="campo-form__opcional">(opcional)</span></label>
              <input type="url" name="url_web" id="edit-web">
            </div>
          </div>
        </div>
      </div>

      <footer class="modal-foot">
        <button type="button" class="btn-secundario" data-modal-close>Cancelar</button>
        <button type="submit" class="btn-primario">Guardar cambios</button>
      </footer>
    </form>
  </div>
</div>

<% if (mAllowNotify) { %>
<!-- Modal Notificar -->
<div class="modal-overlay" id="modal-notificar" role="dialog" aria-modal="true" aria-labelledby="notificar-titulo" aria-hidden="true">
  <div class="modal-content modal-content--md">
    <button type="button" class="modal-close" data-modal-close aria-label="Cerrar">&times;</button>
    <form id="form-notificar" method="POST">
      <header class="modal-head">
        <h2 class="modal-title" id="notificar-titulo">Enviar actualización</h2>
        <p class="modal-subtitle">Describe los cambios realizados para notificar a los equipos.</p>
      </header>
      <div class="modal-body">
        <p class="modal-note">
          <strong>Asunto del correo:</strong> <span id="preview-asunto" class="app-notify__subject"></span>
        </p>
        <div class="campo-form">
          <label for="notificar-cambios">Cambios realizados <span class="required-mark">*</span></label>
          <textarea id="notificar-cambios" name="cambios_texto" rows="6" required placeholder="Ej: Se corrigió el error de inicio de sesión y se añadió el manual de usuario v2..."></textarea>
        </div>
      </div>
      <footer class="modal-foot">
        <button type="button" class="btn-secundario" data-modal-close>Cancelar</button>
        <button type="submit" class="btn-primario">Enviar correo masivo</button>
      </footer>
    </form>
  </div>
</div>
<% } %>

<!-- Crop icono nueva -->
<div class="foto-crop-overlay" id="nuevaIconCropOverlay" role="dialog" aria-modal="true" aria-labelledby="nuevaIconCropTitle" hidden>
  <div class="foto-crop-modal">
    <div class="foto-crop-header">
      <h3 id="nuevaIconCropTitle">Recortar icono</h3>
      <button type="button" class="foto-crop-close" id="nuevaIconCropClose" aria-label="Cerrar">&times;</button>
    </div>
    <p class="foto-crop-hint">Arrastra y ajusta el encuadre. El icono se mostrará cuadrado en la tarjeta.</p>
    <div class="foto-crop-body">
      <div class="foto-crop-stage">
        <img id="nuevaIconCropImage" src="" alt="Vista previa para recortar">
      </div>
    </div>
    <p id="nuevaIconCropError" class="foto-crop-error" role="alert"></p>
    <div class="foto-crop-footer">
      <button type="button" class="btn-crop-cancel" id="nuevaIconCropCancel">Cancelar</button>
      <button type="button" class="btn-crop-save" id="nuevaIconCropSave">Aplicar recorte</button>
    </div>
  </div>
</div>

<!-- Crop icono editar -->
<div class="foto-crop-overlay" id="editIconCropOverlay" role="dialog" aria-modal="true" aria-labelledby="editIconCropTitle" hidden>
  <div class="foto-crop-modal">
    <div class="foto-crop-header">
      <h3 id="editIconCropTitle">Recortar icono</h3>
      <button type="button" class="foto-crop-close" id="editIconCropClose" aria-label="Cerrar">&times;</button>
    </div>
    <p class="foto-crop-hint">Arrastra y ajusta el encuadre. El icono se mostrará cuadrado en la tarjeta.</p>
    <div class="foto-crop-body">
      <div class="foto-crop-stage">
        <img id="editIconCropImage" src="" alt="Vista previa para recortar">
      </div>
    </div>
    <p id="editIconCropError" class="foto-crop-error" role="alert"></p>
    <div class="foto-crop-footer">
      <button type="button" class="btn-crop-cancel" id="editIconCropCancel">Cancelar</button>
      <button type="button" class="btn-crop-save" id="editIconCropSave">Aplicar recorte</button>
    </div>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
<script src="/js/profile-photo-cropper.js?v=20260916m"></script>
<% } %>

<script src="/js/apps-ui.js?v=20260909a" data-apps-admin="<%= mIsAdmin ? 'true' : 'false' %>"></script>
