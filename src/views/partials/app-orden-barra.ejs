<%
  /** Barra de confirmación del modo reordenar (oculta hasta que se activa). */
%>
<div class="apps-orden-barra" data-orden-barra hidden>
  <p class="apps-orden-barra__txt">
    Arrastra las tarjetas o usa las flechas para cambiar el orden en que se muestran.
  </p>
  <div class="apps-orden-barra__acciones">
    <button type="button" class="apps-orden-accion" data-orden-cancelar>Cancelar</button>
    <button type="button" class="apps-orden-accion apps-orden-accion--primary" data-orden-guardar>Guardar orden</button>
  </div>
</div>
