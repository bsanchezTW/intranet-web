<div
  id="changePasswordModal"
  class="modal-overlay modal-change-password"
  role="dialog"
  aria-modal="true"
  aria-labelledby="changePasswordTitle"
  aria-hidden="true"
>
  <div class="modal-content modal-content--sm change-password-modal">
    <button type="button" class="modal-close" id="changePasswordClose" data-modal-close aria-label="Cerrar">&times;</button>

    <form id="changePasswordForm" class="change-password-form" novalidate>
      <header class="modal-head">
        <h2 id="changePasswordTitle" class="modal-title">Cambiar contraseña</h2>
        <p class="modal-subtitle">Ingresa tu contraseña actual y define una nueva.</p>
      </header>

      <div class="modal-body">
        <p id="changePasswordError" class="modal-alert" role="alert" hidden></p>

        <div class="campo-form">
          <label for="old_password">Contraseña actual</label>
          <div class="change-password-wrapper">
            <input type="password" id="old_password" name="old_password" required autocomplete="current-password">
            <button type="button" class="change-password-toggle" data-toggle-password="old_password" aria-label="Mostrar u ocultar contraseña">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
            </button>
          </div>
        </div>

        <div class="campo-form">
          <label for="new_password">Nueva contraseña</label>
          <div class="change-password-wrapper">
            <input type="password" id="new_password" name="new_password" required minlength="8" autocomplete="new-password">
            <button type="button" class="change-password-toggle" data-toggle-password="new_password" aria-label="Mostrar u ocultar contraseña">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
            </button>
          </div>
          <div class="login-password-strength change-password-strength" id="changePasswordStrength" hidden>
            <div class="login-password-strength-bar" aria-hidden="true">
              <span class="login-password-strength-segment" data-segment="1"></span>
              <span class="login-password-strength-segment" data-segment="2"></span>
              <span class="login-password-strength-segment" data-segment="3"></span>
              <span class="login-password-strength-segment" data-segment="4"></span>
              <span class="login-password-strength-segment" data-segment="5"></span>
            </div>
            <div class="login-password-strength-label"></div>
            <p class="login-password-rules-hint">Mínimo 8 caracteres y 3 de los otros 4 requisitos.</p>
            <ul class="login-password-rules">
              <li data-rule="length">Mínimo 8 caracteres</li>
              <li data-rule="lowercase">Una minúscula</li>
              <li data-rule="uppercase">Una mayúscula</li>
              <li data-rule="number">Un número</li>
              <li data-rule="symbol">Un símbolo</li>
            </ul>
          </div>
        </div>

        <div class="campo-form">
          <label for="confirm_password">Repetir nueva contraseña</label>
          <div class="change-password-wrapper">
            <input type="password" id="confirm_password" name="confirm_password" required minlength="8" autocomplete="new-password">
            <button type="button" class="change-password-toggle" data-toggle-password="confirm_password" aria-label="Mostrar u ocultar contraseña">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
            </button>
          </div>
        </div>
      </div>

      <footer class="modal-foot">
        <button type="button" class="btn-secundario" id="changePasswordCancel" data-modal-close>Cancelar</button>
        <button type="submit" class="btn-primario" id="changePasswordSubmit">Actualizar contraseña</button>
      </footer>
    </form>
  </div>
</div>
