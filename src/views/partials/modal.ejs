<%#
  Envoltorio genérico de modal (hoy lo usan los de ticket). El cuerpo trae su
  propia cabecera, cuerpo y pie; ver la anatomía en public/css/modal.css.
%>
<div
  id="<%= id %>"
  class="modal-overlay <%= typeof overlayClass !== 'undefined' ? overlayClass : '' %>"
  role="dialog"
  aria-modal="true"
  aria-labelledby="<%= titleId %>"
  aria-hidden="true"
>
  <div class="modal-content <%= typeof panelClass !== 'undefined' ? panelClass : '' %>">
    <button
      type="button"
      class="modal-close"
      aria-label="<%= typeof closeLabel !== 'undefined' ? closeLabel : 'Cerrar modal' %>"
      data-modal-close
    >&times;</button>

    <% if (typeof title !== 'undefined' && title) { %>
      <h2 id="<%= titleId %>" class="modal-title <%= typeof titleClass !== 'undefined' ? titleClass : '' %>"><%= title %></h2>
    <% } %>

    <%- body %>
  </div>
</div>
