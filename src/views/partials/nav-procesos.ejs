<%
  /* Mismas secciones que la portada de /procesos: Finanzas, Logística, Documentos generales, Mi área/Áreas. */
  const adminNav = typeof veListadoCarpetas !== 'undefined' && veListadoCarpetas;
  const areaNavId = (typeof currentUser !== 'undefined' && currentUser && currentUser.work_area_id)
    ? currentUser.work_area_id
    : null;
  const hrefProcedimientos = (!adminNav && areaNavId)
    ? ('/procesos/procedimientos/' + areaNavId)
    : '/procesos/procedimientos';
  const hrefProtocolos = (!adminNav && areaNavId)
    ? ('/procesos/protocolos/' + areaNavId)
    : '/procesos/protocolos';
  const labelArea = adminNav ? 'Áreas' : 'Mi área';
%>
<% const letrasNav = features.billsOfExchange && typeof canIssueBills !== 'undefined' && canIssueBills; %>
<% if (features.expenseRequests || letrasNav) { %>
<div class="nav-menu-group">
  <span class="nav-menu-group__label">Finanzas</span>
  <% if (features.expenseRequests) { %>
  <a href="/gastos/nueva/rendicion">Rendir gastos</a>
  <a href="/gastos/nueva/fondos">Solicitar fondos</a>
  <a href="/gastos">Mis solicitudes</a>
  <% } %>
  <% if (letrasNav) { %>
  <a href="/letras">Letras de cambio</a>
  <% } %>
</div>
<% } %>
<%
  const hojasRutaNav = features.logistics && can('logistica.acceso') && can('logistica.hoja_ruta.ver');
  const checklistsNav = features.logistics && can('logistica.acceso') && (can('logistica.checklist.ver') || can('logistica.checklist.crear'));
  const flotaNav = features.logistics && can('logistica.acceso') && can('logistica.vehiculo.ver');
%>
<% if (hojasRutaNav || checklistsNav || flotaNav) { %>
<div class="nav-menu-group">
  <span class="nav-menu-group__label">Logística</span>
  <% if (hojasRutaNav) { %>
  <a href="/logistica/hojas-de-ruta">Hojas de ruta</a>
  <% } %>
  <% if (checklistsNav) { %>
  <a href="/logistica/checklists">Checklist de vehículos</a>
  <% } %>
  <% if (flotaNav) { %>
  <a href="/logistica/vehiculos">Flota de vehículos</a>
  <% } %>
</div>
<% } %>
<div class="nav-menu-group">
  <span class="nav-menu-group__label">Documentos generales</span>
  <a href="/procesos/reglamento">Reglamento interno</a>
  <a href="/procesos/otros">Otros documentos</a>
</div>
<div class="nav-menu-group">
  <span class="nav-menu-group__label"><%= labelArea %></span>
  <a href="<%= hrefProcedimientos %>">Procedimientos</a>
  <a href="<%= hrefProtocolos %>">Protocolos</a>
</div>
