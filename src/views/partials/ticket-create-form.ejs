<%
  /**
   * Formulario de alta de ticket del modal de la barra (el alta es sólo en
   * modal, no hay página propia). Usa la misma estructura que el detalle
   * —cuerpo con scroll y pie de acciones— para que ambos modales se lean igual.
   */
  const createShowCancel = (typeof showCancel !== 'undefined') && showCancel;
  const createSubmitLabel = (typeof submitLabel !== 'undefined' && submitLabel)
    ? submitLabel
    : 'Enviar requerimiento';
%>
<form
  id="<%= formId %>"
  action="/soporte/tickets/crear"
  method="POST"
  enctype="multipart/form-data"
  data-max-mb="<%= maxTicketAttachmentMb %>"
  class="ticket-form <%= typeof formClass !== 'undefined' ? formClass : '' %>"
  data-ticket-create-form
  <%= typeof modalId !== 'undefined' && modalId ? `data-ticket-modal-id="${modalId}"` : '' %>
>
  <div class="ticket-body">
    <div class="ticket-campo">
      <label class="ticket-campo__label" for="<%= fieldPrefix %>Titulo">Resumen del problema</label>
      <input type="text" id="<%= fieldPrefix %>Titulo" name="title" required
             placeholder="Ej: No puedo acceder a la carpeta compartida de Ventas">
    </div>

    <div class="ticket-gestion__campos">
      <div class="ticket-campo">
        <label class="ticket-campo__label" for="<%= fieldPrefix %>Categoria">Categoría</label>
        <select id="<%= fieldPrefix %>Categoria" name="category">
          <% ticketCategories.forEach((categoria) => { %>
            <option value="<%= categoria.key %>" <%= categoria.key === 'otro' ? 'selected' : '' %>><%= categoria.label %></option>
          <% }) %>
        </select>
      </div>
      <div class="ticket-campo">
        <label class="ticket-campo__label" for="<%= fieldPrefix %>Prioridad">Prioridad sugerida</label>
        <select id="<%= fieldPrefix %>Prioridad" name="priority">
          <option value="low">Baja (no impide trabajar)</option>
          <option value="medium" selected>Media (dificulta el trabajo)</option>
          <option value="high">Alta (urgente / operación detenida)</option>
        </select>
      </div>
    </div>

    <div class="ticket-campo">
      <label class="ticket-campo__label" for="<%= fieldPrefix %>Descripcion">Descripción detallada</label>
      <textarea
        id="<%= fieldPrefix %>Descripcion"
        name="description"
        rows="5"
        placeholder="Explica qué sucede, desde cuándo y qué has intentado…"
        required
        maxlength="2000"
        data-ticket-description
      ></textarea>
      <div class="char-counter" data-ticket-counter>0 / 2000</div>
    </div>
  </div>

  <div class="ticket-foot">
    <input type="file" id="<%= fieldPrefix %>FileInput" name="adjuntos" data-ticket-file-input multiple
           accept="image/*,video/*,.pdf,.doc,.docx" hidden>

    <div class="ticket-gestion__barra">
      <div class="ticket-adjuntar">
        <button type="button" class="ticket-adjuntar__btn" data-ticket-select-files>
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
          Adjuntar
        </button>
        <span class="ticket-upload-status" data-ticket-upload-status>Arrastra y suelta archivos aquí</span>
      </div>

      <div class="ticket-gestion__acciones">
        <% if (createShowCancel) { %>
          <button type="button" class="ticket-btn ticket-btn--ghost" data-modal-close>Cancelar</button>
        <% } %>
        <button type="submit" class="ticket-btn ticket-btn--primary" data-ticket-submit>
          <span data-ticket-submit-label><%= createSubmitLabel %></span>
        </button>
      </div>
    </div>
  </div>
</form>
