<%
  const tieneFoto = Boolean(usuario.photo);
  const sinDato = '—';
  const rolFmt = usuario.role || 'Usuario';
  const correoVerificado = Boolean(usuario.email_confirmed);
  const errorPerfil = typeof error !== 'undefined' ? error : null;
  const okPerfil = (typeof success !== 'undefined' && success) ? success : null;
  const passwordErrorModal = typeof passwordError !== 'undefined' ? passwordError : null;
  const abrirModalPassword = typeof openPasswordModal !== 'undefined' ? openPasswordModal : false;
  const nombreCompleto = [usuario.first_name, usuario.last_name].filter(Boolean).join(' ') || sinDato;
  const monogram = getMonogram(usuario);
%>
<link rel="stylesheet" href="/css/phone.css">
<link rel="stylesheet" href="/css/profile-photo-crop.css?v=20260916m">
<link rel="stylesheet" href="/css/change-password-modal.css?v=20260916m">
<link rel="stylesheet" href="/css/perfil.css?v=20260916g">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">

<div class="contenedor perfil-page">

  <div class="page-header">
    <span class="page-header__icono" aria-hidden="true"><%- include('partials/icon', { name: 'user' }) %></span>
    <div class="page-header__text">
      <h2 class="page-title">Mi perfil</h2>
      <p class="page-description">Tus datos de contacto y de cuenta en la intranet.</p>
    </div>
    <div class="page-header-actions">
      <a href="/perfil/cursos" class="page-header-btn page-header-btn--secundario">
        <%- include('partials/icon', { name: 'graduation-cap' }) %>
        Mis cursos
      </a>
    </div>
  </div>

  <% if (okPerfil) { %>
    <div hidden data-toast="<%= okPerfil %>"></div>
  <% } %>

  <% if (errorPerfil) { %>
    <div class="flash-msg flash-msg--error" role="alert">
      <span class="flash-msg__icono" aria-hidden="true"><%- include('partials/icon', { name: 'alert-triangle' }) %></span>
      <span><%= errorPerfil %></span>
    </div>
  <% } %>

  <div class="perfil-layout">

    <!-- ═══════════ Ficha de identidad ═══════════ -->
    <aside class="panel perfil-ficha">
      <div class="perfil-ficha__banda" aria-hidden="true"></div>

      <div class="perfil-ficha__identidad">
        <div class="profile-photo-upload perfil-ficha__foto">
          <div class="profile-photo-preview-wrap">
            <div class="profile-photo-preview profile-photo-preview--light" id="photo-preview">
              <img id="photo-preview-img" <% if (tieneFoto) { %>src="<%= usuario.photo %>"<% } else { %>hidden<% } %>>
              <div class="profile-photo-placeholder monogram" id="photo-placeholder" style="<%= monogram.style %>" <%= tieneFoto ? 'hidden' : '' %>>
                <span class="perfil-inicial" aria-hidden="true"><%= monogram.initials %></span>
              </div>
            </div>
          </div>
          <input type="file" id="foto" name="foto" accept="image/*" hidden>
        </div>

        <h2 class="perfil-nombre"><%= nombreCompleto %></h2>
        <p class="perfil-correo"><%= usuario.email || sinDato %></p>
        <span class="perfil-verificacion <%= correoVerificado ? 'perfil-verificacion--ok' : 'perfil-verificacion--pendiente' %>">
          <%- include('partials/icon', { name: correoVerificado ? 'check-circle' : 'clock' }) %>
          <%= correoVerificado ? 'Correo verificado' : 'Correo sin verificar' %>
        </span>

        <div class="profile-photo-actions perfil-ficha__foto-acciones">
          <button type="button" class="btn-photo-select btn-photo-select--light" id="btn-select-photo">
            <%= tieneFoto ? 'Cambiar foto' : 'Seleccionar foto' %>
          </button>
          <button type="button" class="btn-photo-remove" id="btn-remove-photo" <%= tieneFoto ? '' : 'hidden' %>>Quitar foto</button>
        </div>
      </div>

      <div class="perfil-acciones">
        <button type="button" class="btn-perfil" id="btnOpenChangePassword">Cambiar contraseña</button>
        <a href="/logout" class="btn-perfil btn-perfil--danger">Cerrar sesión</a>
      </div>
    </aside>

    <!-- ═══════════ Datos de la persona ═══════════ -->
    <div class="panel perfil-datos">
      <form action="/perfil" method="POST" id="formPerfil">
        <div class="perfil-datos__head">
          <span class="perfil-datos__icono" aria-hidden="true"><%- include('partials/icon', { name: 'user' }) %></span>
          <div>
            <h3 class="perfil-datos__title">Datos personales</h3>
            <p class="perfil-datos__desc">Los actualizas tú y son los que usamos para contactarte.</p>
          </div>
        </div>

        <div class="campos-grid">
          <div class="campo-form">
            <label for="first_name">Nombre <span class="required-mark">*</span></label>
            <input type="text" id="first_name" name="first_name" value="<%= usuario.first_name || '' %>" required autocomplete="given-name">
            <span class="campo-form__error" role="alert"></span>
          </div>

          <div class="campo-form">
            <label for="last_name">Apellido <span class="required-mark">*</span></label>
            <input type="text" id="last_name" name="last_name" value="<%= usuario.last_name || '' %>" required autocomplete="family-name">
            <span class="campo-form__error" role="alert"></span>
          </div>

          <div class="campo-form">
            <label for="fecha_nacimiento">Fecha de nacimiento <span class="required-mark">*</span></label>
            <input type="date" id="fecha_nacimiento" name="birth_date" value="<%= usuario.birth_date_input || '' %>" required autocomplete="bday">
            <span class="campo-form__error" role="alert"></span>
          </div>

          <div class="campo-form">
            <label for="telefono_local">Teléfono personal <span class="required-mark">*</span></label>
            <div class="phone-field" data-phone-field>
              <span class="phone-field__prefix" aria-hidden="true"><%= countryConfig.phone.callingCode ? "+" + countryConfig.phone.callingCode : "" %></span>
              <input type="tel" id="telefono_local" class="phone-field__local" required placeholder="<%= countryConfig.phone.example %>" maxlength="<%= countryConfig.phone.nationalDigits + countryConfig.phone.groups.length - 1 %>" inputmode="numeric" autocomplete="tel-national" aria-label="Número celular sin código de país">
              <input type="hidden" name="phone" id="telefono" value="<%= usuario.phone || '' %>">
            </div>
            <span class="campo-form__error" role="alert"></span>
          </div>

          <% if (!documentoBloqueado) { %>
            <%# Mientras no esté registrado se pide aquí: es el dato con el que
                se emiten los reembolsos. Una vez guardado pasa al bloque de
                RRHH, de sólo lectura. %>
            <div class="campo-form campo-form--ancho">
              <label for="national_id"><%= documentoConfig.label %></label>
              <input type="text" id="national_id" name="national_id"
                     data-national-id
                     placeholder="<%= documentoConfig.example %>" autocomplete="off">
              <span class="campo-form__error" role="alert"></span>
            </div>
          <% } %>
        </div>

        <div class="perfil-guardar">
          <button type="submit" class="btn-perfil btn-perfil--primary">Guardar cambios</button>
        </div>
      </form>

      <section class="perfil-rrhh" aria-labelledby="perfil-rrhh-title">
        <h3 class="perfil-rrhh__title" id="perfil-rrhh-title">Administrado por RRHH</h3>
        <dl class="perfil-rrhh__lista">
          <div class="perfil-rrhh__dato">
            <span class="perfil-rrhh__icono" aria-hidden="true"><%- include('partials/icon', { name: 'building' }) %></span>
            <div>
              <dt>Área de trabajo</dt>
              <dd><%= usuario.area || sinDato %></dd>
            </div>
          </div>
          <div class="perfil-rrhh__dato">
            <span class="perfil-rrhh__icono" aria-hidden="true"><%- include('partials/icon', { name: 'user-check' }) %></span>
            <div>
              <dt>Rol en intranet</dt>
              <dd><%= rolFmt %></dd>
            </div>
          </div>
          <% if (documentoBloqueado) { %>
            <div class="perfil-rrhh__dato">
              <span class="perfil-rrhh__icono" aria-hidden="true"><%- include('partials/icon', { name: 'file-text' }) %></span>
              <div>
                <dt><%= documentoConfig.label %></dt>
                <dd class="perfil-rrhh__numero"><%= usuario.documento %></dd>
              </div>
            </div>
          <% } %>
        </dl>
      </section>
    </div>

  </div>
</div>

<%- include('partials/change-password-modal') %>

<div class="foto-crop-overlay" id="fotoCropOverlay" role="dialog" aria-modal="true" aria-labelledby="fotoCropTitle" hidden>
  <div class="foto-crop-modal">
    <div class="foto-crop-header">
      <h3 id="fotoCropTitle">Recortar foto de perfil</h3>
      <button type="button" class="foto-crop-close" id="fotoCropClose" aria-label="Cerrar">&times;</button>
    </div>
    <div class="foto-crop-body">
      <div class="foto-crop-stage">
        <img id="fotoCropImage" src="" alt="Vista previa para recortar">
      </div>
    </div>
    <p id="fotoCropError" class="foto-crop-error" role="alert"></p>
    <div class="foto-crop-footer">
      <button type="button" class="btn-crop-cancel" id="fotoCropCancel">Cancelar</button>
      <button type="button" class="btn-crop-save" id="fotoCropSave">Aplicar recorte</button>
    </div>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
<script src="/js/campo-form.js?v=20260917a"></script>
<script>window.__PHONE_CONFIG__ = <%- JSON.stringify(phoneClientConfig()) %>;</script>
<script src="/js/phone.js?v=20260910n"></script>
<script type="application/json" id="national-id-config"><%- JSON.stringify(documentoConfig).replace(/</g, '\\u003c') %></script>
<script src="/js/national-id.js?v=20260910n"></script>
<script src="/js/profile-photo-cropper.js?v=20260916m"></script>
<script src="/js/password-strength.js?v=20260916q"></script>
<script src="/js/change-password-modal.js?v=20260916p"></script>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btnRemove = document.getElementById('btn-remove-photo');
    const telefonoField = document.querySelector('[data-phone-field]');
    const telefonoLocal = telefonoField.querySelector('.phone-field__local');
    const formPerfil = document.getElementById('formPerfil');

    PhoneField.initField(telefonoField);

    function revisarTelefono() {
      const vacio = PhoneField.isFieldEmpty(telefonoField);
      const invalido = !vacio && !PhoneField.isFieldValid(telefonoField);
      CampoForm.marcar(telefonoLocal, invalido ? PhoneField.ERROR_MSG : '');
      return !invalido;
    }

    telefonoLocal.addEventListener('input', revisarTelefono);

    formPerfil.addEventListener('submit', (evento) => {
      let hayError = false;

      if (PhoneField.isFieldEmpty(telefonoField)) {
        hayError = true;
        CampoForm.marcar(telefonoLocal, 'Teléfono requerido');
      } else if (!revisarTelefono()) {
        hayError = true;
      }

      if (!hayError) return;
      evento.preventDefault();
      CampoForm.enfocarPrimerError(formPerfil);
    });

    ChangePasswordModal.init({
      overlayId: 'changePasswordModal',
      openBtnId: 'btnOpenChangePassword',
      formId: 'changePasswordForm',
      errorElId: 'changePasswordError',
      closeBtnId: 'changePasswordClose',
      cancelBtnId: 'changePasswordCancel',
      submitBtnId: 'changePasswordSubmit',
      initialError: <%- JSON.stringify(passwordErrorModal) %>,
      openOnLoad: <%= abrirModalPassword ? 'true' : 'false' %>
    });

    ProfilePhotoCropper.init({
      fileInputId: 'foto',
      previewImgId: 'photo-preview-img',
      previewPlaceholderId: 'photo-placeholder',
      selectBtnId: 'btn-select-photo',
      overlayId: 'fotoCropOverlay',
      cropImgId: 'fotoCropImage',
      closeBtnId: 'fotoCropClose',
      cancelBtnId: 'fotoCropCancel',
      saveBtnId: 'fotoCropSave',
      errorElId: 'fotoCropError',
      maxSizeMb: 5,
      outputSize: 400,
      outputFilename: 'foto-perfil.jpg',
      saveLabel: 'Aplicar recorte',
      onSave: function (blob, helpers) {
        const formData = new FormData();
        formData.append('foto_perfil', blob, 'foto-perfil.jpg');

        fetch('/perfil/foto', {
          method: 'POST',
          body: formData,
          credentials: 'same-origin',
          redirect: 'follow'
        })
          .then(function (res) {
            if (res.ok) {
              window.location.href = '/perfil';
              return;
            }
            throw new Error('Error del servidor');
          })
          .catch(function () {
            helpers.showError('No se pudo guardar la foto. Intenta de nuevo.');
            helpers.resetSaveButton();
          });
      }
    });

    btnRemove.addEventListener('click', async function () {
      const quitar = await IntranetDialog.confirm({
        title: '¿Quitar tu foto de perfil?',
        message: 'Volverás a mostrarte con tus iniciales.',
        acceptLabel: 'Quitar foto',
        tone: 'peligro',
      });
      if (!quitar) return;

      fetch('/perfil/foto/eliminar', {
        method: 'POST',
        credentials: 'same-origin',
        redirect: 'follow'
      })
        .then(function (res) {
          if (res.ok) {
            window.location.href = '/perfil';
            return;
          }
          throw new Error('Error del servidor');
        })
        .catch(function () {
          IntranetDialog.alert({ title: 'No se pudo quitar la foto', message: 'Intenta de nuevo en un momento.' });
        });
    });
  });
</script>
