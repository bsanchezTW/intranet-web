<%
const icono = (name) => include('../partials/icon', { name: name });
const iniciales = (nombre) => String(nombre || '?').split(/\s+/).slice(0, 2).map(function (p) { return p.charAt(0); }).join('').toUpperCase();
const volverA = '/permisos/conjuntos/' + group.id;
const enConjunto = new Set(group.members.map(function (m) { return m.id; }));
// Para agregar: cuentas activas que no están, sin superadmins (ya tienen todo) ni uno mismo.
const candidatos = activeUsers.filter(function (u) { return !enConjunto.has(u.id) && !u.is_superadmin && u.id !== actorId; });
const areaDe = (u) => { const a = u.work_area_id != null ? refs.areaById.get(Number(u.work_area_id)) : null; return a ? a.area_name : 'Sin área'; };
%>
<div class="perm-wrap">
  <%- include('partials/cabecera', {
    titulo: group.name,
    descripcion: group.description || 'Conjunto de personas. Lo que se le da en Permisos lo recibe cada una.',
    seccion: 'conjuntos',
    migas: [{ href: '/permisos/conjuntos', label: 'Conjuntos' }, { label: group.name }],
  }) %>

  <section class="seccion">
    <div class="seccion__head">
      <div class="seccion__heading">
        <h3 class="seccion__title"><span class="seccion__icon" aria-hidden="true"><%- icono('users') %></span> Personas <span class="perm-num<%= group.members.length ? ' perm-num--activo' : '' %>"><%= group.members.length %></span></h3>
        <p class="seccion__desc">Quien está aquí recibe todo lo que el conjunto tiene en Permisos. Al sacarla, lo pierde en la siguiente página que abra.</p>
      </div>
    </div>
    <div class="panel">
      <% if (!group.members.length) { %>
        <p class="perm-vacio"><%- icono('inbox') %> Nadie en este conjunto todavía.</p>
      <% } else { %>
        <ul class="perm-holders perm-miembros">
          <% group.members.forEach(function (m) { %>
            <li class="perm-holder">
              <span class="perm-avatar perm-avatar--sm" aria-hidden="true"><%= iniciales(m.name) %></span>
              <span class="perm-holder__quien">
                <a href="/permisos/usuarios/<%= m.id %>"><%= m.name %></a>
                <span class="perm-muted"><%= areaDe(m) %></span>
              </span>
              <% if (m.id !== actorId) { %>
                <form class="perm-inline" action="/permisos/conjuntos/<%= group.id %>/miembros/<%= m.id %>/quitar" method="POST"
                      data-confirm="<%= m.name %> deja de recibir lo que tiene «<%= group.name %>». Lo que le llegue por otro lado lo conserva."
                      data-confirm-title="¿Sacar a <%= m.name %> del conjunto?" data-confirm-accept="Sacar" data-confirm-tone="peligro">
                  <button type="submit" class="perm-btn perm-btn--peligro perm-btn--sm"><%- icono('x') %> Sacar</button>
                </form>
              <% } %>
            </li>
          <% }) %>
        </ul>
      <% } %>

      <details class="perm-agregar-personas"<% if (!group.members.length) { %> open<% } %>>
        <summary class="perm-btn perm-btn--sec perm-btn--sm perm-abrir"><%- icono('plus') %> Agregar personas</summary>
        <form action="/permisos/conjuntos/<%= group.id %>/miembros" method="POST" class="perm-agregar-personas__form">
          <% if (!candidatos.length) { %>
            <p class="perm-muted">No queda nadie por agregar.</p>
          <% } else { %>
            <label class="perm-buscar perm-buscar--sm">
              <%- icono('search') %>
              <input type="search" placeholder="Buscar por nombre o área" aria-label="Buscar persona" data-perm-buscar-lista="#candidatos-<%= group.id %>">
            </label>
            <ul class="perm-candidatos" id="candidatos-<%= group.id %>">
              <% candidatos.forEach(function (u) { %>
                <li data-perm-texto="<%= u.name %> <%= areaDe(u) %>">
                  <label class="perm-check">
                    <input type="checkbox" name="user_id" value="<%= u.id %>">
                    <span><%= u.name %> <span class="perm-muted">· <%= areaDe(u) %></span></span>
                  </label>
                </li>
              <% }) %>
            </ul>
            <div class="perm-form__acciones"><button type="submit" class="perm-btn perm-btn--sm"><%- icono('check') %> Agregar las marcadas</button></div>
          <% } %>
        </form>
      </details>
    </div>
  </section>

  <section class="seccion">
    <div class="seccion__head">
      <div class="seccion__heading">
        <h3 class="seccion__title"><span class="seccion__icon" aria-hidden="true"><%- icono('layers') %></span> Permisos del conjunto <span class="perm-num<%= group.assignments.length ? ' perm-num--activo' : '' %>"><%= group.assignments.length %></span></h3>
        <p class="seccion__desc">Se dan de a uno en la pestaña Permisos, eligiendo este conjunto como destinatario. Aquí se pueden editar o quitar.</p>
      </div>
      <a class="perm-btn perm-btn--sec perm-btn--sm" href="/permisos/modulos"><%- icono('plus') %> Asignar en Permisos</a>
    </div>
    <div class="panel">
      <%- include('partials/tabla_asignaciones', {
        assignments: group.assignments,
        volver: volverA,
        mostrarQuien: false,
        vacio: 'Este conjunto todavía no tiene permisos.',
      }) %>
    </div>
  </section>

  <section class="seccion">
    <div class="seccion__head">
      <div class="seccion__heading">
        <h3 class="seccion__title"><span class="seccion__icon" aria-hidden="true"><%- icono('edit') %></span> Datos</h3>
      </div>
    </div>
    <form class="perm-form" action="/permisos/conjuntos/<%= group.id %>" method="POST" style="margin-top:0">
      <div class="campo-form">
        <label for="grupo-nombre">Nombre</label>
        <input type="text" id="grupo-nombre" name="name" value="<%= group.name %>" maxlength="120" required>
      </div>
      <div class="campo-form">
        <label for="grupo-desc">Descripción</label>
        <input type="text" id="grupo-desc" name="description" value="<%= group.description || '' %>" maxlength="300">
      </div>
      <div class="perm-form__acciones">
        <button type="submit" class="perm-btn perm-btn--sec"><%- icono('check') %> Guardar datos</button>
      </div>
    </form>
  </section>

  <form class="perm-peligro" action="/permisos/conjuntos/<%= group.id %>/eliminar" method="POST"
        data-confirm="Se elimina «<%= group.name %>» con sus <%= group.assignments.length %> permiso(s). Sus <%= group.members.length %> persona(s) dejan de recibirlos."
        data-confirm-title="¿Eliminar el conjunto?" data-confirm-accept="Eliminar" data-confirm-tone="peligro">
    <div>
      <strong>Eliminar el conjunto</strong>
      <span class="perm-muted">Se borran también sus permisos. Las personas siguen en la intranet. No se puede deshacer.</span>
    </div>
    <button type="submit" class="perm-btn perm-btn--peligro"><%- icono('trash') %> Eliminar conjunto</button>
  </form>
</div>
