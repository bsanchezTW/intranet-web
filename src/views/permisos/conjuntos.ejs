<% const icono = (name) => include('../partials/icon', { name: name }); %>
<div class="perm-wrap">
  <%- include('partials/cabecera', {
    titulo: 'Conjuntos de permisos',
    descripcion: 'Paquetes con nombre que se asignan de una vez a todos, a un área, a los jefes o a una persona.',
    seccion: 'conjuntos',
  }) %>

  <div class="panel">
    <% if (!refs.sets.length) { %>
      <p class="perm-vacio"><%- icono('inbox') %> Todavía no hay conjuntos.</p>
    <% } else { %>
      <table class="perm-table perm-table--responsive">
        <thead><tr><th>Conjunto</th><th class="perm-table__num">Permisos</th><th class="perm-table__num">Asignaciones</th><th class="perm-table__accion">Estado</th></tr></thead>
        <tbody>
          <% refs.sets.forEach(function (s) { %>
            <tr>
              <td>
                <a href="/permisos/conjuntos/<%= s.id %>"><%= s.name %></a>
                <% if (s.description) { %><br><span class="perm-muted"><%= s.description %></span><% } %>
              </td>
              <td class="perm-table__num"><span class="perm-num"><%= s.item_count %></span></td>
              <td class="perm-table__num"><span class="perm-num<%= s.assignment_count ? ' perm-num--activo' : '' %>"><%= s.assignment_count %></span></td>
              <td class="perm-table__accion">
                <% if (s.active) { %><span class="perm-estado perm-estado--si">Activo</span><% } else { %><span class="perm-estado perm-estado--no">Desactivado</span><% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>

  <section class="seccion">
    <div class="seccion__head">
      <div class="seccion__heading">
        <h3 class="seccion__title"><span class="seccion__icon" aria-hidden="true"><%- icono('plus') %></span> Nuevo conjunto</h3>
        <p class="seccion__desc">Primero el nombre; después eliges sus permisos.</p>
      </div>
    </div>
    <form class="perm-form" action="/permisos/conjuntos" method="POST" style="margin-top:0">
      <div class="campo-form">
        <label for="nuevo-nombre">Nombre</label>
        <input type="text" id="nuevo-nombre" name="name" maxlength="120" required placeholder="Ej.: Aprobador de rendiciones">
      </div>
      <div class="campo-form">
        <label for="nuevo-desc">Descripción</label>
        <input type="text" id="nuevo-desc" name="description" maxlength="300" placeholder="Para qué sirve">
      </div>
      <div class="perm-form__acciones"><button type="submit" class="perm-btn"><%- icono('plus') %> Crear y elegir permisos</button></div>
    </form>
  </section>
</div>
