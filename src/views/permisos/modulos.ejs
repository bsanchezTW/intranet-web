<div class="perm-wrap">
  <%- include('partials/cabecera', {
    titulo: 'Permisos por módulo',
    descripcion: 'Cada permiso de la intranet, quién lo tiene y por qué. Lo que llega por un conjunto se ve con su nombre.',
    seccion: 'modulos',
  }) %>

  <div class="perm-layout">
    <nav class="perm-modlist" aria-label="Módulos">
      <% modules.forEach(function (m) { %>
        <a href="/permisos/modulos?modulo=<%= m.module %>"<% if (m.module === current.module) { %> aria-current="page"<% } %>>
          <%= m.label %> <span class="perm-muted"><%= m.permissions.length %></span>
        </a>
      <% }) %>
    </nav>

    <div class="panel">
      <h3 class="seccion__title"><%= current.label %></h3>
      <% current.permissions.forEach(function (p, i) { %>
        <% const quienes = whoHas.get(p.key) || []; %>
        <div class="perm-row" id="p-<%= p.key %>">
          <div class="perm-row__head">
            <div>
              <div class="perm-row__title">
                <%= p.label %>
                <% if (p.isModuleAccess) { %><span class="perm-chip perm-chip--muted">Acceso al módulo</span><% } %>
                <% if (p.isField) { %><span class="perm-chip perm-chip--muted">Dato sensible</span><% } %>
              </div>
              <span class="perm-key"><%= p.key %></span>
              <% if (p.scopes) { %>
                <span class="perm-muted">Alcances: <%= p.scopes.map(function (s) { return scopeLabels[s]; }).join(' · ') %></span>
              <% } %>
            </div>
          </div>
          <div class="perm-row__who">
            <% if (!quienes.length) { %>
              <span class="perm-chip perm-chip--muted">Sólo el superadmin</span>
            <% } %>
            <% quienes.forEach(function (q) { %>
              <span class="perm-chip<%= q.assignment.effect === 'deniega' ? ' perm-chip--deny' : '' %><%= q.assignment.expired ? ' perm-chip--muted' : '' %>"
                    title="<%= q.viaSet ? 'Por el conjunto ' + q.viaSet : 'Permiso suelto' %><%= q.assignment.note ? ' · ' + q.assignment.note : '' %>">
                <%= q.assignment.effect === 'deniega' ? 'Denegado a' : '' %>
                <%= q.assignment.principalLabel %><%= q.scopeLabel ? ' · ' + q.scopeLabel : '' %><%= q.viaSet ? ' · ' + q.viaSet : '' %><%= q.assignment.expired ? ' · vencida' : '' %>
              </span>
            <% }) %>
          </div>
          <details>
            <summary class="perm-btn perm-btn--sec perm-btn--sm" style="margin-top:8px">Asignar o denegar</summary>
            <%- include('partials/form_asignacion', {
              uid: 'm' + i,
              volver: '/permisos/modulos?modulo=' + current.module,
              principal: null,
              fixedKey: p.key,
            }) %>
          </details>
        </div>
      <% }) %>
    </div>
  </div>
</div>
