<%
/* Cabecera y pestañas de Gestión de Permisos.
   Parámetros: titulo, descripcion, seccion, migas (opcional: [{ href, label }]). */
// Primero lo de todos los días (qué permiso, quién, dónde en el organigrama);
// después a quién se asigna en bloque y la auditoría.
const pestanas = [
  ['inicio', '/permisos', 'Resumen', 'home'],
  ['modulos', '/permisos/modulos', 'Permisos', 'layers'],
  ['usuarios', '/permisos/usuarios', 'Personas', 'users'],
  ['areas', '/permisos/areas', 'Organigrama', 'sitemap'],
  ['jefes', '/permisos/jefes', 'Jefes', 'user-check'],
  ['global', '/permisos/global', 'Global', 'grid'],
  ['conjuntos', '/permisos/conjuntos', 'Conjuntos', 'briefcase'],
  ['auditoria', '/permisos/auditoria', 'Auditoría', 'clock'],
];
const extraMigas = typeof migas !== 'undefined' && Array.isArray(migas) ? migas : [];
%>
<div class="page-header">
  <span class="page-header__icono" aria-hidden="true"><%- include('../../partials/icon', { name: 'shield' }) %></span>
  <div class="page-header__text">
    <nav class="page-header__migas" aria-label="Ruta de navegación">
      <a href="/permisos">Gestión de permisos</a>
      <% extraMigas.forEach(function (m) { %>
        <span aria-hidden="true">/</span>
        <% if (m.href) { %><a href="<%= m.href %>"><%= m.label %></a><% } else { %><span><%= m.label %></span><% } %>
      <% }) %>
    </nav>
    <h2 class="page-title"><%= titulo %></h2>
    <% if (typeof descripcion !== 'undefined' && descripcion) { %>
      <p class="page-description"><%= descripcion %></p>
    <% } %>
  </div>
</div>

<nav class="perm-tabs" aria-label="Secciones de Gestión de permisos">
  <% pestanas.forEach(function (p) { %>
    <a href="<%= p[1] %>"<% if (p[0] === seccion) { %> aria-current="page"<% } %>><%- include('../../partials/icon', { name: p[3] }) %> <%= p[2] %></a>
  <% }) %>
</nav>
