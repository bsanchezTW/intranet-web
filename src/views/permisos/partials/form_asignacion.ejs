<%
/* Formulario para conceder o denegar un conjunto o un permiso suelto, por pasos.
   Parámetros:
     uid         prefijo único para los id de los campos
     volver      ruta a la que vuelve tras guardar
     principal   { type, areaId } fijo, o null para elegir a quién
     fixedKey    clave de permiso fija, o null para elegir conjunto o permiso
     catalog, refs, areaTree, activeUsers, scopeLabels, actorId  (de baseContext) */
const fijo = typeof principal !== 'undefined' && principal ? principal : null;
const clave = typeof fixedKey !== 'undefined' && fixedKey ? fixedKey : null;
const defClave = clave ? catalog.byKey.get(clave) : null;
const opcionesArea = [];
(function aplanar(nodos, nivel) {
  nodos.forEach(function (n) {
    opcionesArea.push({ id: n.id, label: '  '.repeat(nivel) + n.area_name });
    aplanar(n.children || [], nivel + 1);
  });
})(areaTree, 0);
const personas = activeUsers.filter(function (u) { return u.id !== actorId && !u.is_superadmin; });
const id = (s) => uid + '-' + s;
const icono = (name) => include('../../partials/icon', { name: name });
// Paso "A quién": sólo si hay algo que elegir.
const pasoQuien = !fijo || fijo.type === 'area' || fijo.type === 'jefes';
let n = 0;
%>
<form class="perm-asignar" action="/permisos/asignaciones" method="POST" data-perm-form>
  <input type="hidden" name="volver" value="<%= volver %>">
  <% if (fijo) { %>
    <input type="hidden" name="principal_type" value="<%= fijo.type %>">
    <% if (fijo.type === 'area') { %><input type="hidden" name="area_id" value="<%= fijo.areaId %>"><% } %>
    <% if (fijo.type === 'user') { %><input type="hidden" name="user_id" value="<%= fijo.userId %>"><% } %>
  <% } %>

  <% if (pasoQuien) { %>
    <div class="perm-paso">
      <p class="perm-paso__titulo"><span class="perm-paso__n"><%= ++n %></span><span>A quién<small>Quién recibe la asignación.</small></span></p>
      <div class="perm-paso__campos">
        <% if (!fijo) { %>
          <div class="campo-form">
            <label for="<%= id('principal') %>">Destinatario</label>
            <select id="<%= id('principal') %>" name="principal_type" data-perm-principal required>
              <option value="user">Una persona</option>
              <option value="area">Un área</option>
              <option value="jefes">Jefes de área</option>
              <option value="global">Todos</option>
            </select>
          </div>
          <div class="campo-form" data-perm-show="user">
            <label for="<%= id('user') %>">Persona</label>
            <select id="<%= id('user') %>" name="user_id">
              <option value="">Elige…</option>
              <% personas.forEach(function (u) { %>
                <option value="<%= u.id %>"><%= u.name %></option>
              <% }) %>
            </select>
          </div>
        <% } %>
        <% if (fijo && fijo.type === 'area') { %>
          <label class="perm-check perm-form__ancho">
            <input type="checkbox" name="include_subareas" value="1"> También a quienes trabajan en las áreas que cuelgan de ésta
          </label>
        <% } %>
        <% if (!fijo || fijo.type === 'jefes') { %>
          <div class="campo-form" data-perm-show="area jefes">
            <label for="<%= id('area') %>">Área</label>
            <select id="<%= id('area') %>" name="area_id">
              <option value="" data-perm-only="jefes">Cualquier área</option>
              <% opcionesArea.forEach(function (a) { %>
                <option value="<%= a.id %>"><%= a.label %></option>
              <% }) %>
            </select>
          </div>
          <label class="perm-check perm-form__ancho" data-perm-show="area jefes">
            <input type="checkbox" name="include_subareas" value="1"> Incluir las áreas que cuelgan de ella
          </label>
        <% } %>
      </div>
    </div>
  <% } %>

  <% if (clave) { %>
    <input type="hidden" name="target" value="key">
    <input type="hidden" name="permission_key" value="<%= clave %>" data-perm-scopes="<%= defClave && defClave.scopes ? defClave.scopes.join(',') : '' %>">
  <% } else { %>
    <div class="perm-paso">
      <p class="perm-paso__titulo"><span class="perm-paso__n"><%= ++n %></span><span>Qué<small>Un conjunto con nombre o un permiso suelto.</small></span></p>
      <div class="perm-paso__campos">
        <div class="campo-form">
          <label for="<%= id('target') %>">Tipo</label>
          <select id="<%= id('target') %>" name="target" data-perm-target>
            <option value="set">Un conjunto</option>
            <option value="key">Un permiso suelto</option>
          </select>
        </div>
        <div class="campo-form" data-perm-show-target="set">
          <label for="<%= id('set') %>">Conjunto</label>
          <select id="<%= id('set') %>" name="set_id">
            <option value="">Elige…</option>
            <% refs.sets.forEach(function (s) { %>
              <option value="<%= s.id %>"><%= s.name %><%= s.active ? '' : ' (desactivado)' %></option>
            <% }) %>
          </select>
        </div>
        <div class="campo-form perm-form__ancho" data-perm-show-target="key">
          <label for="<%= id('key') %>">Permiso</label>
          <select id="<%= id('key') %>" name="permission_key" data-perm-key>
            <option value="" data-perm-scopes="">Elige…</option>
            <% catalog.modules.forEach(function (m) { %>
              <optgroup label="<%= m.label %>">
                <% m.permissions.forEach(function (p) { %>
                  <option value="<%= p.key %>" data-perm-scopes="<%= p.scopes ? p.scopes.join(',') : '' %>"><%= p.label %></option>
                <% }) %>
              </optgroup>
            <% }) %>
          </select>
        </div>
      </div>
    </div>
  <% } %>

  <div class="perm-paso">
    <p class="perm-paso__titulo"><span class="perm-paso__n"><%= ++n %></span><span>Efecto<small>Denegar quita el permiso aunque llegue por otro lado.</small></span></p>
    <div class="perm-paso__campos">
      <div class="perm-form__ancho">
        <div class="perm-seg" role="radiogroup" aria-label="Efecto">
          <input type="radio" id="<%= id('concede') %>" name="effect" value="concede" data-perm-effect checked>
          <label for="<%= id('concede') %>"><%- icono('check') %> Conceder</label>
          <input type="radio" id="<%= id('deniega') %>" name="effect" value="deniega" data-perm-effect>
          <label for="<%= id('deniega') %>"><%- icono('x') %> Denegar</label>
        </div>
      </div>
      <div class="campo-form" data-perm-scope-field>
        <label for="<%= id('scope') %>">Sobre qué registros</label>
        <select id="<%= id('scope') %>" name="scope" data-perm-scope>
          <% Object.keys(scopeLabels).forEach(function (s) { %>
            <option value="<%= s %>"><%= scopeLabels[s] %></option>
          <% }) %>
        </select>
      </div>
      <div class="campo-form perm-form__ancho" data-perm-areas-field>
        <label for="<%= id('scope-areas') %>">Áreas elegidas</label>
        <select id="<%= id('scope-areas') %>" name="scope_area_ids" multiple>
          <% opcionesArea.forEach(function (a) { %>
            <option value="<%= a.id %>"><%= a.label %></option>
          <% }) %>
        </select>
        <label class="perm-check"><input type="checkbox" name="scope_include_subareas" value="1"> Con sus subáreas</label>
      </div>
    </div>
  </div>

  <div class="perm-paso">
    <p class="perm-paso__titulo"><span class="perm-paso__n"><%= ++n %></span><span>Vigencia y motivo<small>Opcional. Sin fechas, vale hasta que se quite.</small></span></p>
    <div class="perm-paso__campos">
      <div class="campo-form">
        <label for="<%= id('desde') %>">Desde</label>
        <input type="date" id="<%= id('desde') %>" name="valid_from">
      </div>
      <div class="campo-form">
        <label for="<%= id('hasta') %>">Hasta (incluido)</label>
        <input type="date" id="<%= id('hasta') %>" name="valid_until">
      </div>
      <div class="campo-form perm-form__ancho">
        <label for="<%= id('nota') %>">Motivo</label>
        <input type="text" id="<%= id('nota') %>" name="note" maxlength="500" placeholder="Ej.: reemplaza a Freddy durante sus vacaciones">
      </div>
    </div>
  </div>

  <div class="perm-asignar__pie">
    <% if (defClave) { %><span class="perm-muted"><%= defClave.label %> · <code><%= clave %></code></span><% } %>
    <button type="submit" class="perm-btn"><%- icono('check') %> Guardar asignación</button>
  </div>
</form>
