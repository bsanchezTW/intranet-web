<%
const u = detail.user;
const esYo = u.id === actorId;
const volverA = '/permisos/usuarios/' + u.id;
const deshabilitada = !u.role || /^deshabilitado$/i.test(String(u.role).trim());
const icono = (name) => include('../partials/icon', { name: name });
const total = catalog.byKey.size;
const pct = total ? Math.round((detail.grantedCount / total) * 100) : 0;
const iniciales = String(u.name || '?').split(/\s+/).slice(0, 2).map(function (p) { return p.charAt(0); }).join('').toUpperCase();
%>
<div class="perm-wrap">
  <%- include('partials/cabecera', {
    titulo: u.name,
    descripcion: 'Qué tiene esta persona, sobre qué registros y de dónde le viene cada permiso.',
    seccion: 'usuarios',
    migas: [{ href: '/permisos/usuarios', label: 'Personas' }, { label: u.name }],
  }) %>

  <% if (deshabilitada) { %>
    <div class="perm-banner perm-banner--warn">
      <span class="perm-banner__icono" aria-hidden="true"><%- icono('alert-triangle') %></span>
      <div><strong>Cuenta deshabilitada.</strong> No tiene ningún permiso mientras siga así.</div>
    </div>
  <% } %>

  <div class="perm-perfil">
    <div class="perm-perfil__quien">
      <span class="perm-avatar" aria-hidden="true"><%= iniciales %></span>
      <div class="perm-perfil__datos">
        <strong><%= u.name %></strong>
        <div class="perm-muted">
          <%= [u.email, detail.area ? 'Trabaja en ' + detail.area.area_name : 'Sin área'].filter(Boolean).join(' · ') %>
        </div>
        <% if (detail.superadmin) { %><span class="perm-chip perm-chip--brand">Superadmin</span><% } %>
        <% detail.managed.forEach(function (a) { %><span class="perm-chip perm-chip--muted">Jefe de <%= a.area_name %></span><% }) %>
      </div>
    </div>
    <div>
      <div class="perm-perfil__cifra"><b><%= detail.grantedCount %></b> de <%= total %> permisos</div>
      <div class="perm-barra perm-barra--ancha" aria-hidden="true"><span style="width:<%= pct %>%"></span></div>
    </div>
    <% if (!esYo && !deshabilitada) { %>
      <div class="perm-perfil__acciones">
        <form class="perm-inline" action="/permisos/superadmin" method="POST"
              data-confirm="<%= detail.superadmin ? u.name + ' dejará de tener todos los permisos.' : u.name + ' tendrá todos los permisos y podrá administrar este módulo.' %>"
              data-confirm-title="<%= detail.superadmin ? '¿Quitar superadmin?' : '¿Hacer superadmin?' %>"
              data-confirm-accept="<%= detail.superadmin ? 'Quitar' : 'Hacer superadmin' %>"
              <% if (detail.superadmin) { %>data-confirm-tone="peligro"<% } %>>
          <input type="hidden" name="user_id" value="<%= u.id %>">
          <input type="hidden" name="valor" value="<%= detail.superadmin ? '0' : '1' %>">
          <input type="hidden" name="volver" value="<%= volverA %>">
          <button type="submit" class="perm-btn <%= detail.superadmin ? 'perm-btn--peligro' : 'perm-btn--sec' %> perm-btn--sm"><%- icono('shield') %> <%= detail.superadmin ? 'Quitar superadmin' : 'Hacer superadmin' %></button>
        </form>
      </div>
    <% } %>
  </div>

  <section class="seccion">
    <div class="seccion__head">
      <div class="seccion__heading">
        <h3 class="seccion__title"><span class="seccion__icon" aria-hidden="true"><%- icono('user-check') %></span> Asignado directamente</h3>
        <p class="seccion__desc">Lo que se le dio o negó a esta persona. Lo que recibe por Global, su área o por ser jefe se ve abajo, en cada permiso.</p>
      </div>
    </div>
    <div class="panel">
      <%- include('partials/tabla_asignaciones', {
        assignments: detail.direct,
        volver: volverA,
        mostrarQuien: false,
        vacio: 'Nada asignado directamente.',
      }) %>
      <% if (esYo) { %>
        <p class="perm-muted">No puedes cambiar tus propias asignaciones.</p>
      <% } else if (!detail.superadmin) { %>
        <details>
          <summary class="perm-btn perm-btn--sec perm-btn--sm perm-abrir" style="margin-top:12px"><%- icono('plus') %> Asignar o denegar a <%= u.first_name || u.name %></summary>
          <%- include('partials/form_asignacion', {
            uid: 'u',
            volver: volverA,
            principal: { type: 'user', userId: u.id },
            fixedKey: null,
          }) %>
        </details>
      <% } %>
    </div>
  </section>

  <section class="seccion">
    <div class="seccion__head">
      <div class="seccion__heading">
        <h3 class="seccion__title"><span class="seccion__icon" aria-hidden="true"><%- icono('layers') %></span> Permisos efectivos</h3>
        <p class="seccion__desc">Qué tiene hoy, sobre qué registros y de dónde le viene. Si algo se lo quita, se dice qué.</p>
      </div>
    </div>

    <div class="perm-filtros" data-perm-filtro="#perm-efectivos">
      <label class="perm-buscar">
        <%- icono('search') %>
        <input type="search" placeholder="Filtrar por permiso o clave" aria-label="Filtrar permisos">
      </label>
      <label class="perm-switch">
        <input type="checkbox">
        <span class="perm-switch__pista" aria-hidden="true"></span>
        Sólo lo que tiene
      </label>
    </div>

    <div class="perm-tree" id="perm-efectivos">
      <p class="perm-vacio" data-perm-filtro-vacio hidden>Ningún permiso coincide con el filtro.</p>
      <% detail.modules.forEach(function (m) { %>
        <% const tiene = m.permissions.filter(function (p) { return p.granted; }).length; %>
        <details data-perm-modulo<% if (tiene) { %> open<% } %>>
          <summary>
            <span class="perm-tree__nombre"><%= m.label %></span>
            <span class="perm-barra" aria-hidden="true"><span style="width:<%= m.permissions.length ? Math.round(tiene / m.permissions.length * 100) : 0 %>%"></span></span>
            <span class="perm-tree__cuenta"><%= tiene %> de <%= m.permissions.length %></span>
          </summary>
          <div class="perm-tree__body">
            <% m.permissions.forEach(function (p) { %>
              <div class="perm-efectivo" data-perm-fila="<%= p.label %> <%= p.key %>"<% if (p.granted) { %> data-perm-tiene<% } %>>
                <div><%= p.label %><span class="perm-key"><%= p.key %></span></div>
                <div class="perm-efectivo__estado">
                  <% if (p.granted) { %>
                    <span class="perm-estado perm-estado--si">Sí</span>
                  <% } else if (p.deniedBy) { %>
                    <span class="perm-estado perm-estado--deny">Denegado</span>
                  <% } else { %>
                    <span class="perm-estado perm-estado--no">No</span>
                  <% } %>
                  <% if (p.alcance) { %><span class="perm-muted"><%= p.alcance %></span><% } %>
                </div>
                <div class="perm-efectivo__origen">
                  <% p.origins.forEach(function (o) { %><span class="perm-chip"><%= o %></span><% }) %>
                  <% if (p.deniedBy) { %><span class="perm-chip perm-chip--deny">Denegado: <%= p.deniedBy %></span><% } %>
                </div>
              </div>
            <% }) %>
          </div>
        </details>
      <% }) %>
    </div>
  </section>
</div>
