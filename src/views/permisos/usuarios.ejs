<%
const icono = (name) => include('../partials/icon', { name: name });
const iniciales = (nombre) => String(nombre || '?').split(/\s+/).slice(0, 2).map(function (p) { return p.charAt(0); }).join('').toUpperCase();
%>
<div class="perm-wrap">
  <%- include('partials/cabecera', {
    titulo: 'Permisos por persona',
    descripcion: 'Busca a alguien para ver qué tiene, de dónde le viene y asignarle o denegarle permisos.',
    seccion: 'usuarios',
  }) %>

  <form class="perm-buscador" action="/permisos/usuarios" method="GET" role="search">
    <label class="perm-buscar">
      <%- icono('search') %>
      <input type="search" id="buscar" name="q" value="<%= q %>" placeholder="Buscar por nombre o correo" aria-label="Buscar por nombre o correo">
    </label>
    <button type="submit" class="perm-btn">Buscar</button>
    <% if (q) { %><a class="perm-btn perm-btn--sec" href="/permisos/usuarios">Limpiar</a><% } %>
  </form>

  <div class="panel">
    <% if (!list.length) { %>
      <p class="perm-vacio"><%- icono('search') %> Nadie coincide con «<%= q %>».</p>
    <% } else { %>
      <table class="perm-table perm-table--responsive">
        <thead><tr><th>Persona</th><th>Área</th><th>Cuenta</th></tr></thead>
        <tbody>
          <% list.forEach(function (u) { %>
            <% const area = u.work_area_id ? refs.areaById.get(Number(u.work_area_id)) : null; %>
            <% const deshabilitada = /^deshabilitado$/i.test(String(u.role || '').trim()) || !u.role; %>
            <tr>
              <td>
                <span class="perm-persona">
                  <span class="perm-avatar perm-avatar--sm" aria-hidden="true"><%= iniciales(u.name) %></span>
                  <span class="perm-persona__texto">
                    <a href="/permisos/usuarios/<%= u.id %>"><%= u.name %></a>
                    <% if (u.is_superadmin) { %><span class="perm-chip perm-chip--brand">Superadmin</span><% } %>
                    <% if (u.email) { %><span class="perm-muted"><%= u.email %></span><% } %>
                  </span>
                </span>
              </td>
              <td class="perm-muted"><%= area ? area.area_name : 'Sin área' %></td>
              <td>
                <% if (deshabilitada) { %>
                  <span class="perm-estado perm-estado--no">Deshabilitada</span>
                <% } else { %>
                  <span class="perm-estado perm-estado--si">Activa</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
</div>
