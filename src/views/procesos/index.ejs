<%
  const admin = (typeof esAdmin !== 'undefined' && esAdmin);
  const ctx = (typeof areaContext !== 'undefined' && areaContext) ? areaContext : { area: null, manager: null, isManager: false };
  const conteos = (typeof conteosArea !== 'undefined' && conteosArea) ? conteosArea : { procedimiento: 0, protocolo: 0 };
  const hayGastos = (typeof gastosActivos !== 'undefined') ? gastosActivos : false;
  const revisor = (typeof esRevisor !== 'undefined' && esRevisor);
  const porAprobar = (typeof pendientes !== 'undefined' && pendientes) ? pendientes : 0;

  // Sin área no hay jefe, y sin jefe no hay a quién enviarle la solicitud.
  const puedeSolicitar = !!(ctx.area && ctx.manager);
  const flashError = (typeof error !== 'undefined' && error) ? error : null;

  function plural(n, singular, pluralWord) { return n === 1 ? singular : pluralWord; }
%>

<div class="contenedor">

  <div class="page-header">
    <h2 class="page-title">Procesos y Documentos</h2>
    <p class="page-description">
      Rinde tus gastos, consulta la normativa de la empresa y revisa los documentos de tu área.
    </p>
  </div>

  <% if (flashError) { %>
    <div class="flash-msg flash-msg--error" role="alert">
      <span class="flash-msg__icono" aria-hidden="true"><%- include('../partials/icon', { name: 'alert-triangle' }) %></span>
      <span><%= flashError %></span>
    </div>
  <% } %>

  <div class="buscador-global">
    <span class="buscador-global__icono" aria-hidden="true"><%- include('../partials/icon', { name: 'search' }) %></span>
    <label class="sr-only" for="buscadorGlobal">Buscar documentos</label>
    <input
      type="search"
      id="buscadorGlobal"
      class="buscador-global__input"
      placeholder="Buscar en procedimientos, protocolos y documentos…"
      autocomplete="off"
    >
    <div id="buscadorSpinner" class="buscador-global__spinner"></div>
    <div id="buscadorResultados" class="buscador-global__resultados" hidden></div>
  </div>

  <% if (hayGastos) { %>
  <!-- ═══════════ Finanzas ═══════════ -->
  <section class="seccion" aria-labelledby="seccion-finanzas">
    <div class="seccion__head">
      <div class="seccion__heading">
        <h3 class="seccion__title" id="seccion-finanzas">
          <span class="seccion__icon" aria-hidden="true"><%- include('../partials/icon', { name: 'wallet' }) %></span>
          Finanzas
        </h3>
        <p class="seccion__desc">
          <% if (puedeSolicitar) { %>
            Tus solicitudes pasan primero por <strong><%= ctx.manager.name %></strong> y luego por Finanzas.
          <% } else { %>
            Rinde gastos ya realizados o pide fondos por adelantado.
          <% } %>
        </p>
      </div>
    </div>

    <% if (!ctx.area) { %>
      <div class="procesos-aviso" style="margin-bottom: 18px;">
        <span class="procesos-aviso__icono" aria-hidden="true"><%- include('../partials/icon', { name: 'info' }) %></span>
        <span>Todavía no tienes un área asignada, así que no es posible determinar quién aprueba tus solicitudes. Pídele a RRHH que te asigne una.</span>
      </div>
    <% } else if (!ctx.manager) { %>
      <div class="procesos-aviso" style="margin-bottom: 18px;">
        <span class="procesos-aviso__icono" aria-hidden="true"><%- include('../partials/icon', { name: 'info' }) %></span>
        <span>El área <strong><%= ctx.area.area_name %></strong> aún no tiene un jefe asignado, y la aprobación de la jefatura es un requisito. Pídele a RRHH que designe uno.</span>
      </div>
    <% } %>

    <div class="procesos-grid">
      <% if (puedeSolicitar) { %>
        <a href="/gastos/nueva/rendicion" class="procesos-card">
          <span class="procesos-card__tile" aria-hidden="true"><%- include('../partials/icon', { name: 'receipt' }) %></span>
          <div class="procesos-card__cuerpo">
            <h4 class="procesos-card__titulo">Rendir gastos</h4>
            <p class="procesos-card__desc">Declara gastos que ya pagaste de tu bolsillo y adjunta los comprobantes.</p>
          </div>
        </a>

        <a href="/gastos/nueva/fondos" class="procesos-card">
          <span class="procesos-card__tile procesos-card__tile--green" aria-hidden="true"><%- include('../partials/icon', { name: 'banknote' }) %></span>
          <div class="procesos-card__cuerpo">
            <h4 class="procesos-card__titulo">Solicitar fondos</h4>
            <p class="procesos-card__desc">Pide dinero por adelantado para una compra o gestión que todavía no realizas.</p>
          </div>
        </a>
      <% } else { %>
        <div class="procesos-card procesos-card--bloqueada" aria-disabled="true">
          <span class="procesos-card__tile" aria-hidden="true"><%- include('../partials/icon', { name: 'receipt' }) %></span>
          <div class="procesos-card__cuerpo">
            <h4 class="procesos-card__titulo">Rendir gastos</h4>
            <p class="procesos-card__desc">No disponible hasta que tu área tenga un jefe asignado.</p>
          </div>
        </div>

        <div class="procesos-card procesos-card--bloqueada" aria-disabled="true">
          <span class="procesos-card__tile" aria-hidden="true"><%- include('../partials/icon', { name: 'banknote' }) %></span>
          <div class="procesos-card__cuerpo">
            <h4 class="procesos-card__titulo">Solicitar fondos</h4>
            <p class="procesos-card__desc">No disponible hasta que tu área tenga un jefe asignado.</p>
          </div>
        </div>
      <% } %>

      <a href="/gastos" class="procesos-card">
        <span class="procesos-card__tile" aria-hidden="true"><%- include('../partials/icon', { name: 'clipboard' }) %></span>
        <div class="procesos-card__cuerpo">
          <h4 class="procesos-card__titulo">Mis solicitudes</h4>
          <p class="procesos-card__desc">Revisa el estado y el historial de todo lo que has enviado.</p>
        </div>
      </a>

      <% if (revisor) { %>
        <a href="/gastos/gestion" class="procesos-card">
          <span class="procesos-card__tile procesos-card__tile--green" aria-hidden="true"><%- include('../partials/icon', { name: 'inbox' }) %></span>
          <div class="procesos-card__cuerpo">
            <h4 class="procesos-card__titulo">Gestión de solicitudes</h4>
            <p class="procesos-card__desc">Aprueba, rechaza y consulta el historial de las solicitudes que te corresponden.</p>
            <div class="procesos-card__meta">
              <% if (porAprobar > 0) { %>
                <span class="procesos-card__badge procesos-card__badge--alerta">
                  <%= porAprobar %> <%= plural(porAprobar, 'por aprobar', 'por aprobar') %>
                </span>
              <% } else { %>
                <span class="procesos-card__badge">Sin pendientes</span>
              <% } %>
            </div>
          </div>
        </a>
      <% } %>
    </div>
  </section>
  <% } %>

  <!-- ═══════════ Documentos generales ═══════════ -->
  <section class="seccion" aria-labelledby="seccion-generales">
    <div class="seccion__head">
      <div class="seccion__heading">
        <h3 class="seccion__title" id="seccion-generales">
          <span class="seccion__icon" aria-hidden="true"><%- include('../partials/icon', { name: 'scale' }) %></span>
          Documentos generales
        </h3>
        <p class="seccion__desc">Normativa y documentación que aplica a toda la empresa.</p>
      </div>
    </div>

    <div class="procesos-grid">
      <a href="/procesos/reglamento" class="procesos-card">
        <span class="procesos-card__tile" aria-hidden="true"><%- include('../partials/icon', { name: 'scale' }) %></span>
        <div class="procesos-card__cuerpo">
          <h4 class="procesos-card__titulo">Reglamento interno</h4>
          <p class="procesos-card__desc">Normativa, políticas internas y reglas generales de la empresa.</p>
        </div>
      </a>

      <a href="/procesos/otros" class="procesos-card">
        <span class="procesos-card__tile procesos-card__tile--green" aria-hidden="true"><%- include('../partials/icon', { name: 'folder' }) %></span>
        <div class="procesos-card__cuerpo">
          <h4 class="procesos-card__titulo">Otros documentos</h4>
          <p class="procesos-card__desc">Documentación adicional, plantillas e información importante.</p>
        </div>
      </a>
    </div>
  </section>

  <!-- ═══════════ Mi área / Áreas ═══════════ -->
  <section class="seccion" aria-labelledby="seccion-area">
    <div class="seccion__head">
      <div class="seccion__heading">
        <h3 class="seccion__title" id="seccion-area">
          <span class="seccion__icon" aria-hidden="true"><%- include('../partials/icon', { name: admin ? 'users' : 'briefcase' }) %></span>
          <%= admin ? 'Áreas' : 'Mi área' %>
        </h3>
        <p class="seccion__desc">
          <% if (admin) { %>
            Procedimientos y protocolos de cada área de la empresa.
          <% } else if (ctx.area) { %>
            Procedimientos y protocolos de <strong><%= ctx.area.area_name %></strong>.
          <% } else { %>
            Procedimientos y protocolos del área a la que perteneces.
          <% } %>
        </p>
      </div>
    </div>

    <% if (admin) { %>
      <div class="procesos-grid">
        <a href="/procesos/procedimientos" class="procesos-card">
          <span class="procesos-card__tile" aria-hidden="true"><%- include('../partials/icon', { name: 'clipboard' }) %></span>
          <div class="procesos-card__cuerpo">
            <h4 class="procesos-card__titulo">Procedimientos</h4>
            <p class="procesos-card__desc">Instructivos paso a paso para tareas operativas y recurrentes, por área.</p>
          </div>
        </a>

        <a href="/procesos/protocolos" class="procesos-card">
          <span class="procesos-card__tile procesos-card__tile--green" aria-hidden="true"><%- include('../partials/icon', { name: 'shield' }) %></span>
          <div class="procesos-card__cuerpo">
            <h4 class="procesos-card__titulo">Protocolos</h4>
            <p class="procesos-card__desc">Lineamientos formales para situaciones específicas y de seguridad, por área.</p>
          </div>
        </a>
      </div>
    <% } else if (ctx.area) { %>
      <div class="procesos-grid">
        <a href="/procesos/procedimientos/<%= ctx.area.id %>" class="procesos-card">
          <span class="procesos-card__tile" aria-hidden="true"><%- include('../partials/icon', { name: 'clipboard' }) %></span>
          <div class="procesos-card__cuerpo">
            <h4 class="procesos-card__titulo">Procedimientos</h4>
            <p class="procesos-card__desc">Instructivos paso a paso para las tareas de tu área.</p>
            <div class="procesos-card__meta">
              <span class="procesos-card__badge">
                <%= conteos.procedimiento || 0 %> <%= plural(conteos.procedimiento || 0, 'documento', 'documentos') %>
              </span>
            </div>
          </div>
        </a>

        <a href="/procesos/protocolos/<%= ctx.area.id %>" class="procesos-card">
          <span class="procesos-card__tile procesos-card__tile--green" aria-hidden="true"><%- include('../partials/icon', { name: 'shield' }) %></span>
          <div class="procesos-card__cuerpo">
            <h4 class="procesos-card__titulo">Protocolos</h4>
            <p class="procesos-card__desc">Lineamientos formales y de seguridad de tu área.</p>
            <div class="procesos-card__meta">
              <span class="procesos-card__badge">
                <%= conteos.protocolo || 0 %> <%= plural(conteos.protocolo || 0, 'documento', 'documentos') %>
              </span>
            </div>
          </div>
        </a>
      </div>
    <% } else { %>
      <div class="procesos-aviso">
        <span class="procesos-aviso__icono" aria-hidden="true"><%- include('../partials/icon', { name: 'info' }) %></span>
        <span>Todavía no perteneces a ningún área, así que no hay procedimientos ni protocolos que mostrarte. Pídele a RRHH que te asigne una.</span>
      </div>
    <% } %>
  </section>

</div>
