<%
  const listado = (typeof areas !== 'undefined' && Array.isArray(areas)) ? areas : [];
  const sinArea = (typeof huerfanos !== 'undefined' && huerfanos) ? huerfanos : 0;
  const conDocumentos = listado.reduce((n, a) => n + (a.cantidad || 0), 0);
%>

<div class="contenedor">

  <div class="page-header">
    <span class="page-header__icono" aria-hidden="true"><%- include('../partials/icon', { name: 'layers' }) %></span>
    <div class="page-header__text">
      <nav class="page-header__migas" aria-label="Ruta de navegación">
        <a href="/procesos">Procesos y documentos</a> <span aria-hidden="true">/</span>
        <span><%= titulo %></span>
      </nav>
      <h2 class="page-title"><%= titulo %></h2>
      <p class="page-description">
        <%= listado.length %> <%= listado.length === 1 ? 'área' : 'áreas' %> ·
        <%= conDocumentos %> <%= conDocumentos === 1 ? 'documento' : 'documentos' %>.
        Cada área tiene su propia carpeta; se crea y se elimina junto con el área.
      </p>
    </div>
  </div>

  <% if (!listado.length) { %>
    <div class="archivos-panel">
      <div class="archivos-vacio">
        <span class="archivos-vacio__icono" aria-hidden="true"><%- include('../partials/icon', { name: 'folder' }) %></span>
        <h3>No hay áreas registradas</h3>
        <p>Crea un área en <a href="/RRHH/areas">RRHH &rsaquo; Áreas</a> y su carpeta aparecerá aquí.</p>
      </div>
    </div>
  <% } else { %>
    <div class="carpetas-grid">
      <% listado.forEach(area => { %>
        <a href="/procesos/<%= seccionBase %>/<%= area.id %>" class="carpeta-card" style="--carpeta-color: <%= area.color %>">
          <span class="carpeta-card__tile" aria-hidden="true"><%- include('../partials/icon', { name: 'folder' }) %></span>
          <div class="carpeta-card__info">
            <h3 class="carpeta-card__nombre"><%= area.area_name %></h3>
            <span class="carpeta-card__conteo">
              <%= area.cantidad %> <%= area.cantidad === 1 ? 'archivo' : 'archivos' %>
            </span>
          </div>
        </a>
      <% }) %>

      <%
        /* Documentos heredados de los slugs antiguos (contabilidad, comercial…)
           que no correspondían a ningún área real. Se listan para que nadie los
           dé por perdidos; no se puede subir nada nuevo ahí. */
      %>
      <% if (sinArea > 0) { %>
        <a href="/procesos/<%= seccionBase %>/<%= slugSinArea %>" class="carpeta-card" style="--carpeta-color: var(--color-text-muted)">
          <span class="carpeta-card__tile" aria-hidden="true"><%- include('../partials/icon', { name: 'archive' }) %></span>
          <div class="carpeta-card__info">
            <h3 class="carpeta-card__nombre">Sin área</h3>
            <span class="carpeta-card__conteo">
              <%= sinArea %> <%= sinArea === 1 ? 'archivo heredado' : 'archivos heredados' %>
            </span>
          </div>
        </a>
      <% } %>
    </div>
  <% } %>

</div>
