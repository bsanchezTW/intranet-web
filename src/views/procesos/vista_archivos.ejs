<%
  const puedeEscribir = !!(can && can[seccionBase + '_write']);
  const lista = (typeof archivos !== 'undefined' && Array.isArray(archivos)) ? archivos : [];
  const esSeccionDeArea = seccionBase === 'procedimientos' || seccionBase === 'protocolos';
  const heredados = (typeof avisoHuerfanos !== 'undefined' && avisoHuerfanos);
  const color = (typeof areaColor !== 'undefined' && areaColor) ? areaColor : null;
  const retorno = `/procesos/${seccionBase}` + (esSeccionDeArea ? `/${slugArea}` : '');

  /* Icono y color por formato: en una lista larga el icono solo no basta para
     encontrar "el Excel". */
  function formatoDe(archivo) {
    const fmt = (archivo.format || '').toLowerCase().replace('.', '');
    if (fmt === 'pdf') return { icono: 'file-text', clase: 'pdf' };
    if (fmt.includes('doc')) return { icono: 'file-text', clase: 'doc' };
    if (fmt.includes('xls') || fmt === 'csv') return { icono: 'file-spreadsheet', clase: 'xls' };
    return { icono: 'file', clase: '' };
  }
%>

<div class="contenedor">

  <nav class="procesos-migas" aria-label="Ruta de navegación">
    <a href="/procesos">Procesos y Documentos</a>
    <% if (esSeccionDeArea) { %>
      <span aria-hidden="true">/</span>
      <a href="/procesos/<%= seccionBase %>"><%= tituloSeccion %></a>
    <% } %>
    <span aria-hidden="true">/</span>
    <span><%= tituloArea || tituloSeccion %></span>
  </nav>

  <div class="page-header page-header--toolbar">
    <div class="page-header__text">
      <h2 class="page-title"><%= titulo %></h2>
      <p class="page-description">
        <%= lista.length %> <%= lista.length === 1 ? 'documento' : 'documentos' %>
        <% if (color) { %>
          · <span class="carpeta-card__conteo" style="background: color-mix(in srgb, <%= color %> 16%, transparent); color: <%= color %>;"><%= tituloArea %></span>
        <% } %>
      </p>
    </div>

    <% if (puedeEscribir) { %>
    <div class="page-header-actions">
      <button type="button" class="page-header-btn" onclick="IntranetModal.open('modalSubir')">
        <span aria-hidden="true">+</span> Subir documento
      </button>
    </div>
    <% } %>
  </div>

  <% if (typeof ok !== 'undefined' && ok) { %>
    <div class="flash-msg flash-msg--ok" role="status">
      <span class="flash-msg__icono" aria-hidden="true"><%- include('../partials/icon', { name: 'check-circle' }) %></span>
      <span><%= ok %></span>
    </div>
  <% } %>

  <% if (heredados) { %>
    <div class="procesos-aviso" style="margin-bottom: 20px;">
      <span class="procesos-aviso__icono" aria-hidden="true"><%- include('../partials/icon', { name: 'info' }) %></span>
      <span>
        Estos documentos venían de carpetas antiguas cuyo nombre no corresponde a ningún área actual.
        Para reubicarlos, crea el área en <a href="/RRHH/areas">RRHH &rsaquo; Áreas</a> y vuelve a subirlos en su carpeta.
      </span>
    </div>
  <% } %>

  <div class="archivos-panel">
    <% if (!lista.length) { %>
      <div class="archivos-vacio">
        <span class="archivos-vacio__icono" aria-hidden="true"><%- include('../partials/icon', { name: 'folder' }) %></span>
        <h3>No hay documentos</h3>
        <p>Aún no se han subido archivos a esta carpeta.</p>
      </div>
    <% } else { %>
      <ul class="archivos-lista">
        <% lista.forEach(a => { const f = formatoDe(a); %>
          <li class="archivo-item">
            <span class="archivo-item__icono archivo-item__icono--<%= f.clase %>" aria-hidden="true">
              <%- include('../partials/icon', { name: f.icono }) %>
            </span>

            <div class="archivo-item__main">
              <a href="<%= a.url %>" target="_blank" rel="noopener" class="archivo-item__nombre"><%= a.name %></a>
              <span class="archivo-item__tipo"><%= (a.format || '').toUpperCase() || 'Archivo' %></span>
            </div>

            <% if (puedeEscribir) { %>
              <div class="archivo-item__acciones">
                <button type="button" class="archivo-item__btn archivo-item__btn--editar"
                        title="Editar nombre" aria-label="Editar el nombre de <%= a.name %>"
                        data-editar-doc data-id="<%= a.id %>" data-nombre="<%= a.name %>">
                  <%- include('../partials/icon', { name: 'edit' }) %>
                </button>
                <button type="button" class="archivo-item__btn archivo-item__btn--eliminar"
                        title="Eliminar" aria-label="Eliminar <%= a.name %>"
                        data-eliminar-doc data-id="<%= a.id %>" data-public-id="<%= a.public_id %>" data-nombre="<%= a.name %>">
                  <%- include('../partials/icon', { name: 'trash' }) %>
                </button>
              </div>
            <% } %>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </div>

</div>

<% if (puedeEscribir) { %>
<div id="modalSubir" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="modalSubirTitle" aria-hidden="true">
  <div class="modal-content">
    <button type="button" class="modal-close" data-modal-close aria-label="Cerrar">&times;</button>
    <h3 id="modalSubirTitle" class="modal-title">Subir nuevo documento</h3>

    <form id="formSubir" action="/procesos/<%= seccionBase %>/<%= slugArea %>/subir" method="POST" class="modal-form">
      <div class="campo-form">
        <label for="nombreInput">Nombre del documento <span class="required-mark">*</span></label>
        <input type="text" id="nombreInput" placeholder="Ej: Procedimiento de despacho V2" required maxlength="200">
      </div>

      <div class="campo-form">
        <label for="fileInput">Archivo <span class="required-mark">*</span></label>
        <input type="file" id="fileInput" required>
        <span class="campo-form__ayuda">Hasta 20 MB.</span>
      </div>

      <div id="uploadStatus" class="procesos-subida-estado">
        <span class="procesos-subida-spinner" id="uploadSpinner"></span>
        <span id="uploadText">Preparando…</span>
      </div>

      <div class="modal-actions" id="modalActions">
        <button type="button" class="btn-secundario" data-modal-close>Cancelar</button>
        <button type="submit" class="btn-primario" id="btnSubmit">Subir archivo</button>
      </div>
    </form>
  </div>
</div>

<div id="modalEditar" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="modalEditarTitle" aria-hidden="true">
  <div class="modal-content">
    <button type="button" class="modal-close" data-modal-close aria-label="Cerrar">&times;</button>
    <h3 id="modalEditarTitle" class="modal-title">Editar nombre del documento</h3>

    <form action="/procesos/documento/editar" method="POST" class="modal-form">
      <input type="hidden" name="id" id="editId">
      <input type="hidden" name="return_to" value="<%= retorno %>">
      <input type="hidden" name="seccion_base" value="<%= seccionBase %>">

      <div class="campo-form">
        <label for="editNombre">Nuevo nombre <span class="required-mark">*</span></label>
        <input type="text" name="nuevo_nombre" id="editNombre" required maxlength="200">
      </div>

      <div class="modal-actions">
        <button type="button" class="btn-secundario" data-modal-close>Cancelar</button>
        <button type="submit" class="btn-primario">Guardar cambios</button>
      </div>
    </form>
  </div>
</div>

<form id="formEliminar" action="/procesos/eliminar" method="POST" hidden>
  <input type="hidden" name="db_id" id="deleteDbId">
  <input type="hidden" name="public_id" id="deletePublicId">
  <input type="hidden" name="return_to" value="<%= retorno %>">
  <input type="hidden" name="seccion_base" value="<%= seccionBase %>">
</form>

<script>
  (function () {
    "use strict";

    document.querySelectorAll("[data-editar-doc]").forEach(function (btn) {
      btn.addEventListener("click", function () {
        document.getElementById("editId").value = btn.dataset.id;
        document.getElementById("editNombre").value = btn.dataset.nombre || "";
        IntranetModal.open("modalEditar");
      });
    });

    document.querySelectorAll("[data-eliminar-doc]").forEach(function (btn) {
      btn.addEventListener("click", function () {
        var nombre = btn.dataset.nombre || "este documento";
        if (!confirm('¿Eliminar permanentemente "' + nombre + '"?')) return;
        document.getElementById("deleteDbId").value = btn.dataset.id;
        document.getElementById("deletePublicId").value = btn.dataset.publicId || "";
        document.getElementById("formEliminar").submit();
      });
    });

    var form = document.getElementById("formSubir");
    if (!form) return;

    var MAX_BYTES = 20 * 1024 * 1024;

    form.addEventListener("submit", async function (e) {
      e.preventDefault();

      var fileInput = document.getElementById("fileInput");
      var nameInput = document.getElementById("nombreInput");
      var statusDiv = document.getElementById("uploadStatus");
      var statusText = document.getElementById("uploadText");
      var spinner = document.getElementById("uploadSpinner");
      var actions = document.getElementById("modalActions");

      if (!fileInput.files.length) return alert("Selecciona un archivo.");
      var file = fileInput.files[0];
      if (file.size > MAX_BYTES) return alert("El archivo excede el límite de 20 MB.");

      function setStatus(msg, subiendo) {
        statusText.textContent = msg;
        statusDiv.style.display = "block";
        spinner.style.display = subiendo ? "inline-block" : "none";
        actions.style.display = subiendo ? "none" : "flex";
      }

      try {
        setStatus("Subiendo documento…", true);

        var datos = new FormData();
        datos.append("archivo", file);

        var upRes = await fetch(form.action.replace("/subir", "/upload"), {
          method: "POST",
          body: datos,
          credentials: "same-origin",
        });
        var upData = await upRes.json().catch(function () { return {}; });
        if (!upRes.ok) throw new Error(upData.error || "Error al subir el archivo.");

        setStatus("Registrando en el sistema…", true);
        var saveRes = await fetch(form.action, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          credentials: "same-origin",
          body: JSON.stringify({
            nombre_archivo: nameInput.value || file.name,
            secure_url: upData.secure_url,
            public_id: upData.public_id,
          }),
        });
        var saveData = await saveRes.json().catch(function () { return {}; });
        if (!saveRes.ok) throw new Error(saveData.error || "Error al guardar el registro.");

        location.reload();
      } catch (err) {
        console.error(err);
        alert(err.message);
        setStatus("Error en la subida", false);
      }
    });
  })();
</script>
<% } %>
