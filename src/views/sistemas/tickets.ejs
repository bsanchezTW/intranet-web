<%
  const esAdmin = (typeof isAdministrador !== 'undefined' && isAdministrador);
  // Ver todos los tickets sigue siendo de administrador; gestionarlos es del
  // área de Informática, y el aviso de "no leído" acompaña a quien atiende.
  const puedeGestionar = (typeof canManageTickets !== 'undefined' && canManageTickets);
  const apps = (typeof supportApps !== 'undefined' && Array.isArray(supportApps)) ? supportApps : [];
  const listaTickets = (typeof tickets !== 'undefined' && Array.isArray(tickets)) ? tickets : [];

  const estadoLabels = { open: 'Abierto', in_progress: 'En curso', pending_close: 'Pendiente de cierre', closed: 'Cerrado' };
  const prioridadLabels = { low: 'Baja', medium: 'Media', high: 'Alta' };

  const abiertos = listaTickets.filter((t) => t.status !== 'closed').length;
  const cerrados = listaTickets.length - abiertos;
%>

<% if (esAdmin) { %>
<link rel="stylesheet" href="/css/profile-photo-crop.css?v=20260916m">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">
<% } %>

<div class="contenedor soporte-page" data-ticket-list-admin="<%= esAdmin ? 'true' : 'false' %>">

  <div class="page-header">
    <span class="page-header__icono" aria-hidden="true"><%- include('../partials/icon', { name: 'headset' }) %></span>
    <div class="page-header__text">
      <h2 class="page-title">Soporte</h2>
      <p class="page-description">Resuélvelo tú mismo con las herramientas de autoayuda, o abre un ticket con el equipo de TI.</p>
    </div>

    <div class="page-header-actions">
      <a href="#" role="button" class="page-header-btn js-open-ticket-modal">
        <%- include('../partials/icon', { name: 'plus' }) %> Abrir ticket
      </a>
    </div>
  </div>

  <% if (typeof ok !== 'undefined' && ok) { %>
    <div hidden data-toast="<%= ok %>"></div>
  <% } %>

  <!-- ═══════════ Autoayuda ═══════════ -->
  <section class="soporte-seccion" aria-labelledby="soporte-autoayuda-titulo">
    <div class="soporte-seccion__head">
      <div class="soporte-seccion__heading">
        <h3 class="soporte-seccion__title" id="soporte-autoayuda-titulo">
          <span class="soporte-seccion__icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
          </span>
          Autoayuda
        </h3>
        <p class="soporte-seccion__desc">Herramientas para resolver los problemas más comunes sin esperar a un técnico.</p>
      </div>

      <% if (esAdmin) { %>
      <div class="soporte-seccion__acciones">
        <% if (apps.length > 1) { %><%- include('../partials/app-orden-boton') %><% } %>
        <button type="button" class="apps-add-btn" onclick="toggleFormulario()">
          <span aria-hidden="true">+</span> Agregar herramienta
        </button>
      </div>
      <% } %>
    </div>

    <% if (esAdmin && apps.length > 1) { %><%- include('../partials/app-orden-barra') %><% } %>

    <% if (apps.length > 0) { %>
      <div class="apps-grid apps-grid--soporte" data-orden-grid data-orden-catalogo="<%= appCatalog %>">
        <% apps.forEach((app, index) => { %>
          <%- include('../partials/app-card', { app: app, index: index, allowNotify: true, reorderable: esAdmin && apps.length > 1 }) %>
        <% }) %>
      </div>
    <% } else { %>
      <div class="apps-empty-state">
        <% if (esAdmin) { %>
          Aún no hay herramientas de autoayuda. Agrega la primera con el botón de arriba.
        <% } else { %>
          Aún no hay herramientas de autoayuda publicadas.
        <% } %>
      </div>
    <% } %>
  </section>

  <!-- ═══════════ Ticketera ═══════════ -->
  <section class="soporte-seccion" aria-labelledby="soporte-tickets-titulo">
    <div class="soporte-seccion__head">
      <div class="soporte-seccion__heading">
        <h3 class="soporte-seccion__title" id="soporte-tickets-titulo">
          <span class="soporte-seccion__icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9V7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v2a3 3 0 0 0 0 6v2a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-2a3 3 0 0 0 0-6z"/><path d="M14 5v14" stroke-dasharray="2 3"/></svg>
          </span>
          <%= esAdmin ? 'Tickets de soporte' : 'Mis tickets' %>
        </h3>
        <p class="soporte-seccion__desc">
          <%= abiertos %> <%= abiertos === 1 ? 'ticket activo' : 'tickets activos' %> · <%= cerrados %> <%= cerrados === 1 ? 'cerrado' : 'cerrados' %>
        </p>
      </div>
    </div>

    <div class="tickets-panel">
      <div class="tickets-toolbar">
        <div class="tickets-search">
          <svg class="tickets-search__icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          <input type="search" id="ticketsBuscar" class="tickets-search__input" placeholder="Buscar por título, categoría<%= esAdmin ? ' o solicitante' : '' %>…" aria-label="Buscar tickets" autocomplete="off">
        </div>

        <div class="tickets-filtros" role="group" aria-label="Filtrar por estado">
          <button type="button" class="tickets-chip is-active" data-filtro-estado="activos">Activos</button>
          <button type="button" class="tickets-chip" data-filtro-estado="open">Abiertos</button>
          <button type="button" class="tickets-chip" data-filtro-estado="in_progress">En curso</button>
          <button type="button" class="tickets-chip" data-filtro-estado="closed">Cerrados</button>
          <button type="button" class="tickets-chip" data-filtro-estado="todos">Todos</button>
        </div>

        <label class="tickets-orden">
          <span class="sr-only">Ordenar tickets</span>
          <select id="ticketsOrden" class="tickets-orden__select">
            <option value="recientes">Más recientes</option>
            <option value="antiguos">Más antiguos</option>
            <option value="prioridad">Mayor prioridad</option>
            <option value="respuesta">Última respuesta</option>
          </select>
        </label>
      </div>

      <ul class="tickets-lista" id="ticketsLista">
        <% listaTickets.forEach((t) => {
             let esNoLeido = false;
             if (puedeGestionar && t.read_by_admin === false) esNoLeido = true;
             else if (!puedeGestionar && t.read_by_user === false) esNoLeido = true;

             const opciones = { year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' };
             const strCreado = t.created_at ? new Date(t.created_at).toLocaleDateString(countryConfig.locale, opciones) : '—';
             const strUltima = t.fecha_ultima_respuesta ? new Date(t.fecha_ultima_respuesta).toLocaleDateString(countryConfig.locale, opciones) : '—';
             const buscable = [t.title, ticketCategoryLabel(t.category), esAdmin ? t.requester_name : '', esAdmin ? t.requester_email : '', String(t.id)]
               .filter(Boolean).join(' ').toLowerCase();
        %>
          <li class="ticket-item<%= esNoLeido ? ' ticket-item--nuevo' : '' %>"
              data-href="/sistemas/tickets/<%= t.id %>"
              data-estado="<%= t.status %>"
              data-prioridad="<%= t.priority %>"
              data-creado="<%= t.created_at ? new Date(t.created_at).getTime() : 0 %>"
              data-respuesta="<%= t.fecha_ultima_respuesta ? new Date(t.fecha_ultima_respuesta).getTime() : 0 %>"
              data-buscar="<%= buscable %>">
            <button type="button" class="ticket-item__btn">
              <span class="ticket-item__prioridad ticket-item__prioridad--<%= t.priority %>" title="Importancia: <%= prioridadLabels[t.priority] || t.priority %>" aria-hidden="true"></span>

              <span class="ticket-item__main">
                <span class="ticket-item__top">
                  <span class="ticket-item__id">#<%= t.id %></span>
                  <% if (esNoLeido) { %><span class="ticket-item__nuevo">Nuevo</span><% } %>
                  <span class="ticket-item__titulo"><%= t.title %></span>
                </span>

                <span class="ticket-item__meta">
                  <% if (t.category) { %><span class="ticket-item__categoria"><%= ticketCategoryLabel(t.category) %></span><% } %>
                  <% if (esAdmin && t.requester_name) { %>
                    <span class="ticket-item__dato" title="<%= t.requester_email %>"><%= t.requester_name %></span>
                  <% } %>
                  <span class="ticket-item__dato">Creado <%= strCreado %></span>
                  <% if (t.fecha_ultima_respuesta) { %>
                    <span class="ticket-item__dato ticket-item__dato--sec">Últ. respuesta <%= strUltima %></span>
                  <% } %>
                  <% if (t.tiempo_respuesta && t.tiempo_respuesta !== '-') { %>
                    <span class="ticket-item__sla" title="Tiempo hábil hasta la primera respuesta"><%= t.tiempo_respuesta %></span>
                  <% } %>
                </span>
              </span>

              <span class="ticket-item__lado">
                <% if (esAdmin) { %>
                  <span class="ticket-item__asignado<%= t.assigned_to ? ' ticket-item__asignado--activo' : '' %>">
                    <%= t.assigned_to || 'Sin asignar' %>
                  </span>
                <% } %>
                <span class="ticket-estado ticket-estado--<%= t.status %>"><%= estadoLabels[t.status] || t.status %></span>
                <span class="ticket-item__prioridad-txt ticket-item__prioridad-txt--<%= t.priority %>"><%= prioridadLabels[t.priority] || t.priority %></span>
              </span>

              <svg class="ticket-item__chevron" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
            </button>
          </li>
        <% }) %>
      </ul>

      <p class="tickets-vacio" id="ticketsVacio" hidden>No hay tickets que coincidan con el filtro.</p>

      <% if (listaTickets.length === 0) { %>
        <p class="tickets-vacio">No hay tickets registrados actualmente.</p>
      <% } %>
    </div>
  </section>

  <%- include('../partials/app-modals', {
    appCatalog: (typeof appCatalog !== 'undefined' ? appCatalog : 'support'),
    allowNotify: true,
    modalNewTitle: 'Agregar herramienta de autoayuda',
    modalNewSubtitle: 'Publica una utilidad que el equipo pueda usar para resolver problemas por su cuenta.',
    modalNamePlaceholder: 'Ej: Reparador de impresoras',
    modalDescPlaceholder: 'Describe qué problema resuelve y cuándo usarla...'
  }) %>

</div>

<%- include('../partials/modal', {
  id: 'modalVerTicketDetalle',
  titleId: 'modalVerTicketDetalleTitulo',
  title: 'Detalle de ticket',
  overlayClass: 'modal-ticket-navbar',
  panelClass: 'modal-ticket-navbar-content modal-ticket-detail-content',
  titleClass: 'ticket-modal-title ticket-modal-title--sr',
  body: include('../partials/ticket-detail-modal-content')
}) %>
