<%
  const esModal = (typeof isModal !== 'undefined' && isModal);
  const puedeGestionar = (typeof canManageTickets !== 'undefined' && canManageTickets);
  const agentes = (typeof supportAgents !== 'undefined' && Array.isArray(supportAgents)) ? supportAgents : [];
  const volverA = (typeof backTo !== 'undefined' && backTo) ? backTo : '/soporte';

  const estadoLabels = { open: 'Abierto', in_progress: 'En curso', pending_close: 'Pendiente de cierre', closed: 'Cerrado' };
  const prioridadLabels = { low: 'Baja', medium: 'Media', high: 'Alta' };

  const esCerrado = ticket.status === 'closed';
  const esPropio = user && user.email === ticket.requester_email;
  // `pending_close` ya no se produce; sobrevive en tickets antiguos y conserva
  // su confirmación por parte del solicitante hasta que se resuelvan.
  const esperandoConfirmacion = ticket.status === 'pending_close';

  const yo = agentes.find((a) => user && a.id === user.id);
  const nombreYo = yo ? yo.name : (user && (user.nombre || user.username)) || 'mí';

  const fmt = (valor) => valor ? new Date(valor).toLocaleString(countryConfig.locale, {
    year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit'
  }) : '—';

  let ticketAdjuntos = [];
  try { if (ticket.attachments) ticketAdjuntos = JSON.parse(ticket.attachments); } catch (e) {}
  const imagenesOrig = ticketAdjuntos.filter((a) => a.tipo === 'image');
  const otrosOrig = ticketAdjuntos.filter((a) => a.tipo !== 'image');
%>

<div class="ticket-detail-view <%= esModal ? 'ticket-detail-view--modal' : 'contenedor' %>">
  <% if (!esModal) { %>
  <nav class="page-header__migas migas-sueltas" aria-label="Ruta de navegación">
    <a href="<%= volverA %>">Soporte</a> <span aria-hidden="true">/</span>
    <span>Ticket #<%= ticket.id %></span>
  </nav>
  <% } %>

<div class="ticket-container">

  <!-- ═══════════ Cabecera fija ═══════════ -->
  <div class="ticket-head">
    <div class="ticket-head__tags">
      <span class="ticket-head__id">#<%= ticket.id %></span>
      <span class="ticket-estado ticket-estado--<%= ticket.status %>"><%= estadoLabels[ticket.status] || ticket.status %></span>
      <span class="ticket-prio ticket-prio--<%= ticket.priority %>"><%= prioridadLabels[ticket.priority] || ticket.priority %></span>
      <span class="ticket-head__asignado<%= ticket.assigned_to ? ' ticket-head__asignado--activo' : '' %>">
        <% if (ticket.assigned_to) { %>
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          <%= ticket.assigned_to %>
        <% } else { %>
          Sin asignar
        <% } %>
      </span>
    </div>

    <h2 class="ticket-head__titulo"><%= ticket.title %></h2>

    <div class="ticket-head__meta">
      <span><strong><%= ticket.requester_name %></strong> · <%= ticket.requester_email %></span>
      <span class="ticket-head__sep" aria-hidden="true">·</span>
      <span><%= ticketCategoryLabel(ticket.category) %></span>
      <span class="ticket-head__sep" aria-hidden="true">·</span>
      <span>Creado <%= fmt(ticket.created_at) %></span>
      <% if (ticket.fecha_cierre) { %>
        <span class="ticket-head__sep" aria-hidden="true">·</span>
        <span>Cerrado <%= fmt(ticket.fecha_cierre) %></span>
      <% } %>
    </div>
  </div>

  <!-- ═══════════ Cuerpo con scroll ═══════════ -->
  <div class="ticket-body">

    <section class="ticket-bloque">
      <h3 class="ticket-bloque__title">Descripción del requerimiento</h3>
      <div class="ticket-descripcion">
        <p class="ticket-descripcion__texto"><%= ticket.description %></p>

        <% if (ticketAdjuntos.length > 0) { %>
          <div class="adjuntos-wrapper">
            <% if (imagenesOrig.length > 0) { %>
              <div class="seccion-adjunto">
                <div class="titulo-adjunto">Imágenes adjuntas</div>
                <div class="grid-imagenes">
                  <% imagenesOrig.forEach((img) => { %>
                    <a href="<%= img.url %>" target="_blank" rel="noopener" title="<%= img.nombre %>">
                      <img src="<%= img.url %>" alt="Adjunto" class="thumb-imagen">
                    </a>
                  <% }) %>
                </div>
              </div>
            <% } %>
            <% if (otrosOrig.length > 0) { %>
              <div class="seccion-adjunto">
                <div class="titulo-adjunto">Otros archivos adjuntos</div>
                <ul class="lista-archivos">
                  <% otrosOrig.forEach((arc) => { %>
                    <li><a href="<%= arc.url %>" target="_blank" rel="noopener"><%= arc.nombre %></a></li>
                  <% }) %>
                </ul>
              </div>
            <% } %>
          </div>
        <% } %>
      </div>
    </section>

    <section class="ticket-bloque">
      <h3 class="ticket-bloque__title">
        Historial
        <% if (respuestas && respuestas.length > 0) { %>
          <span class="ticket-bloque__count"><%= respuestas.length %></span>
        <% } %>
      </h3>

      <% if (respuestas && respuestas.length > 0) { %>
        <ol class="ticket-hilo">
          <% respuestas.forEach((r) => {
               const esSoporte = r.remitente === 'Soporte' || r.remitente === 'Sistema';
               let respAdjuntos = [];
               try { if (r.attachments) respAdjuntos = JSON.parse(r.attachments); } catch (e) {}
               if (r.file_url && respAdjuntos.length === 0) {
                 respAdjuntos.push({ url: r.file_url, nombre: r.archivo_nombre || 'Archivo adjunto', tipo: r.archivo_tipo || 'doc' });
               }
               const imagenes = respAdjuntos.filter((a) => a.tipo === 'image');
               const otros = respAdjuntos.filter((a) => a.tipo !== 'image');
          %>
            <li class="ticket-msg <%= esSoporte ? 'ticket-msg--soporte' : 'ticket-msg--usuario' %>">
              <div class="ticket-msg__head">
                <span class="ticket-msg__autor"><%= r.remitente %></span>
                <span class="ticket-msg__fecha"><%= fmt(r.fecha) %></span>
              </div>
              <p class="ticket-msg__texto"><%= r.mensaje %></p>

              <% if (respAdjuntos.length > 0) { %>
                <div class="adjuntos-wrapper adjuntos-wrapper--reply">
                  <% if (imagenes.length > 0) { %>
                    <div class="grid-imagenes">
                      <% imagenes.forEach((img) => { %>
                        <a href="<%= img.url %>" target="_blank" rel="noopener" title="<%= img.nombre %>">
                          <img src="<%= img.url %>" alt="Adjunto" class="thumb-imagen thumb-imagen--small">
                        </a>
                      <% }) %>
                    </div>
                  <% } %>
                  <% if (otros.length > 0) { %>
                    <ul class="lista-archivos">
                      <% otros.forEach((arc) => { %>
                        <li><a href="<%= arc.url %>" target="_blank" rel="noopener"><%= arc.nombre %></a></li>
                      <% }) %>
                    </ul>
                  <% } %>
                </div>
              <% } %>
            </li>
          <% }) %>
        </ol>
      <% } else { %>
        <p class="ticket-hilo-vacio">Aún no hay respuestas en este ticket.</p>
      <% } %>
    </section>

    <% if (esperandoConfirmacion && esPropio) { %>
      <section class="ticket-confirmar">
        <h4 class="ticket-confirmar__title">TI marcó este ticket como pendiente de cierre</h4>
        <p class="ticket-confirmar__text">Confirma si tu problema quedó resuelto, o recházalo si aún necesitas ayuda.</p>
        <div class="ticket-confirmar__acciones">
          <form action="/soporte/tickets/<%= ticket.id %>/confirmar" method="POST">
            <button type="submit" class="ticket-btn ticket-btn--ok">Confirmar solución</button>
          </form>
          <form action="/soporte/tickets/<%= ticket.id %>/rechazar" method="POST">
            <button type="submit" class="ticket-btn ticket-btn--ghost" data-confirm="El ticket volverá a quedar abierto para que soporte lo revise." data-confirm-title="¿Reabrir el ticket?" data-confirm-accept="Reabrir">Aún tengo problemas</button>
          </form>
        </div>
      </section>
    <% } %>
  </div>

  <!-- ═══════════ Pie de acciones ═══════════ -->
  <% if (esCerrado) { %>
    <div class="ticket-foot ticket-foot--cerrado">
      <p class="ticket-foot__cerrado-txt">Este ticket está cerrado. Si el problema se repite, abre uno nuevo.</p>
    </div>

  <% } else if (puedeGestionar) { %>
    <div class="ticket-foot">
      <form id="form-upload-admin" class="ticket-gestion" action="/soporte/tickets/<%= ticket.id %>/actualizar" method="POST" data-ticket-id="<%= ticket.id %>">
        <input type="hidden" name="redirect_to" value="<%= volverA %>">
        <input type="hidden" name="accion" id="ticketAccion" value="guardar">
        <input type="hidden" name="assign_mode" id="ticketAssignMode" value="">
        <input type="hidden" name="assign_to" id="ticketAssignTo" value="">
        <input type="hidden" name="adjuntos_data" id="adjuntos_data_admin">

        <div class="ticket-gestion__campos">
          <label class="ticket-campo">
            <span class="ticket-campo__label">Categoría</span>
            <select name="category">
              <% ticketCategories.forEach((categoria) => { %>
                <option value="<%= categoria.key %>" <%= ticketCategoryLabel(ticket.category) === categoria.label ? 'selected' : '' %>><%= categoria.label %></option>
              <% }) %>
            </select>
          </label>
          <label class="ticket-campo">
            <span class="ticket-campo__label">Prioridad</span>
            <select name="priority">
              <option value="low" <%= ticket.priority === 'low' ? 'selected' : '' %>>Baja</option>
              <option value="medium" <%= ticket.priority === 'medium' ? 'selected' : '' %>>Media</option>
              <option value="high" <%= ticket.priority === 'high' ? 'selected' : '' %>>Alta</option>
            </select>
          </label>
        </div>

        <div class="ticket-campo">
          <span class="ticket-campo__label">Mensaje al usuario <span class="ticket-campo__opt">(opcional)</span></span>
          <textarea id="mensajeAdmin" name="mensaje_respuesta" rows="3" maxlength="2000"
                    placeholder="Escribe aquí para notificar al solicitante…"></textarea>
          <div id="charCountAdmin" class="char-counter">0 / 2000 caracteres</div>
        </div>

        <div class="ticket-gestion__barra">
          <label class="ticket-adjuntar">
            <input type="file" id="archivos_admin" class="ticket-adjuntar__input" multiple
                   accept="image/*,video/*,.pdf,.doc,.docx,.xls,.xlsx,.txt">
            <span class="ticket-adjuntar__btn">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
              Adjuntar
            </span>
            <span id="upload-status-admin" class="ticket-upload-status"></span>
          </label>

          <div class="ticket-gestion__acciones">
            <button type="button" class="ticket-btn ticket-btn--cerrar" data-ticket-accion="cerrar" id="btn-cerrar-admin">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
              Guardar y cerrar ticket
            </button>
            <button type="button" class="ticket-btn ticket-btn--primary" data-ticket-accion="guardar" id="btn-submit-admin">
              Guardar y poner En curso
            </button>
          </div>
        </div>

        <!-- Paso de asignación: se despliega al guardar -->
        <div class="ticket-asignar" id="ticketAsignar" hidden>
          <div class="ticket-asignar__card" role="group" aria-labelledby="ticketAsignarTitulo">
            <h4 class="ticket-asignar__title" id="ticketAsignarTitulo">¿Tomar este ticket?</h4>
            <p class="ticket-asignar__hint" id="ticketAsignarHint">Todo ticket gestionado queda con un responsable.</p>

            <div class="ticket-asignar__ops">
              <label class="ticket-asignar__op">
                <input type="radio" name="assign_choice" value="yo" checked>
                <span class="ticket-asignar__op-txt">
                  <strong>Tomarlo yo</strong>
                  <span><%= nombreYo %></span>
                </span>
              </label>

              <label class="ticket-asignar__op">
                <input type="radio" name="assign_choice" value="otro" <%= agentes.length <= 1 ? 'disabled' : '' %>>
                <span class="ticket-asignar__op-txt">
                  <strong>Asignárselo a otra persona</strong>
                  <span><%= agentes.length <= 1 ? 'No hay más personal de Informática registrado' : 'Personal de Informática' %></span>
                </span>
              </label>

              <select id="ticketAsignarSelect" class="ticket-asignar__select" disabled>
                <option value="">Selecciona a quién asignar…</option>
                <% agentes.filter((a) => !user || a.id !== user.id).forEach((a) => { %>
                  <option value="<%= a.id %>"><%= a.name %></option>
                <% }) %>
              </select>

              <% if (ticket.assigned_to) { %>
              <label class="ticket-asignar__op">
                <input type="radio" name="assign_choice" value="mantener">
                <span class="ticket-asignar__op-txt">
                  <strong>Mantener responsable</strong>
                  <span><%= ticket.assigned_to %></span>
                </span>
              </label>
              <% } %>
            </div>

            <p class="ticket-asignar__error" id="ticketAsignarError" role="alert" hidden></p>

            <div class="ticket-asignar__acciones">
              <button type="button" class="ticket-btn ticket-btn--ghost" id="btnAsignarCancelar">Cancelar</button>
              <button type="button" class="ticket-btn ticket-btn--primary" id="btnAsignarConfirmar">Confirmar y guardar</button>
            </div>
          </div>
        </div>
      </form>
    </div>

  <% } else if (esPropio) { %>
    <div class="ticket-foot">
      <form id="form-upload-user" class="ticket-gestion" action="/soporte/tickets/<%= ticket.id %>/responder" method="POST" data-ticket-id="<%= ticket.id %>">
        <input type="hidden" name="redirect_to" value="<%= volverA %>">
        <input type="hidden" name="adjuntos_data" id="adjuntos_data_user">

        <div class="ticket-campo">
          <span class="ticket-campo__label">Añadir un comentario</span>
          <textarea id="mensajeUser" name="mensaje_respuesta" rows="3" required maxlength="2000"
                    placeholder="Escribe tu mensaje aquí…"></textarea>
          <div id="charCountUser" class="char-counter">0 / 2000 caracteres</div>
        </div>

        <div class="ticket-gestion__barra">
          <label class="ticket-adjuntar">
            <input type="file" id="archivos_user" class="ticket-adjuntar__input" multiple
                   accept="image/*,video/*,.pdf,.doc,.docx,.xls,.xlsx,.txt">
            <span class="ticket-adjuntar__btn">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
              Adjuntar
            </span>
            <span id="upload-status-user" class="ticket-upload-status"></span>
          </label>

          <div class="ticket-gestion__acciones">
            <button type="submit" class="ticket-btn ticket-btn--primary" id="btn-submit-user">Enviar mensaje</button>
          </div>
        </div>
      </form>
    </div>

  <% } else { %>
    <div class="ticket-foot ticket-foot--cerrado">
      <p class="ticket-foot__cerrado-txt">Sólo el personal de Informática puede gestionar este ticket.</p>
    </div>
  <% } %>

</div>
</div>
