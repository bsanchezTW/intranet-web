<%
  const esAdminApps = (typeof isAdministrador !== 'undefined' && isAdministrador);
  const listaApps = (typeof apps !== 'undefined' && Array.isArray(apps)) ? apps : [];
  const catalogoApps = (typeof appCatalog !== 'undefined' && appCatalog) ? appCatalog : 'corporate';
%>
<link rel="stylesheet" href="/css/apps.css?v=20260909b">
<% if (typeof isAdministrador !== 'undefined' && isAdministrador) { %>
<link rel="stylesheet" href="/css/profile-photo-crop.css?v=20260907b">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">
<% } %>

<div class="contenedor">

  <div class="page-header page-header--toolbar">
    <div class="page-header__text">
      <h2 class="page-title">Aplicaciones de Transworld</h2>
      <p class="page-description">Descarga las aplicaciones y herramientas corporativas oficiales.</p>
    </div>

    <% if (esAdminApps) { %>
    <div class="page-header-actions">
      <% if (listaApps.length > 1) { %><%- include('partials/app-orden-boton') %><% } %>
      <button type="button" class="apps-add-btn" onclick="toggleFormulario()">
        <span aria-hidden="true">+</span> Ingresar nueva app
      </button>
    </div>
    <% } %>
  </div>

  <% if (typeof ok !== 'undefined' && ok) { %>
    <div class="apps-flash"><%= ok %></div>
  <% } %>

  <% if (esAdminApps && listaApps.length > 1) { %><%- include('partials/app-orden-barra') %><% } %>

  <div class="apps-grid" data-orden-grid data-orden-catalogo="<%= catalogoApps %>">
    <% if (listaApps.length > 0) { %>
      <% listaApps.forEach((app, index) => { %>
        <%- include('partials/app-card', {
          app: app,
          index: index,
          allowNotify: true,
          reorderable: esAdminApps && listaApps.length > 1
        }) %>
      <% }) %>
    <% } else { %>
      <div class="apps-empty-state">No hay aplicaciones registradas.</div>
    <% } %>
  </div>

  <%- include('partials/app-modals', {
    appCatalog: (typeof appCatalog !== 'undefined' ? appCatalog : 'corporate'),
    allowNotify: true,
    modalNewTitle: 'Ingresar nueva app',
    modalNewSubtitle: 'Completa los datos y enlaces de descarga para cada plataforma.',
    modalNamePlaceholder: 'Ej: Transworld Lead App',
    modalDescPlaceholder: 'Describe para qué sirve la aplicación...'
  }) %>

</div>
